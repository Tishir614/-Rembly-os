#!/bin/busybox sh
# Rembly OS stage-1 init for A73 (MT6737M, kernel 3.18.79, no devtmpfs/VT).
# Never writes to eMMC. Falls back to an emergency shell + adb.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null
mkdir -p /proc /sys /dev /mnt /newroot /tmp /run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,size=4m tmpfs /dev    # no devtmpfs in this kernel
mkdir -p /dev/pts /dev/graphics /dev/input /dev/block
mknod -m 666 /dev/null c 1 3
mknod -m 666 /dev/zero c 1 5
mknod -m 666 /dev/random c 1 8
mknod -m 666 /dev/urandom c 1 9
mknod -m 600 /dev/console c 5 1
mknod -m 666 /dev/tty c 5 0
mknod -m 666 /dev/ptmx c 5 2
mknod -m 620 /dev/tty0 c 4 0
mknod -m 620 /dev/tty1 c 4 1
mount -t devpts devpts /dev/pts 2>/dev/null
exec >/dev/console 2>&1 </dev/console 2>/dev/null || true

log() { echo "[rembly] $*"; echo "[rembly] $*" >/dev/kmsg 2>/dev/null; }
log "stage1 start, kernel $(uname -r)"

# Populate /dev from sysfs (works without devtmpfs), then Android-style aliases.
echo /bin/mdev >/proc/sys/kernel/hotplug 2>/dev/null
mdev -s
[ -e /dev/fb0 ] && ln -sf ../fb0 /dev/graphics/fb0
for e in /dev/input/event*; do :; done
for d in /dev/mmcblk0p*; do [ -e "$d" ] && ln -sf ../"${d#/dev/}" /dev/block/"${d#/dev/}"; done
ln -sf ../mmcblk0 /dev/block/mmcblk0 2>/dev/null

# --- hardware report (saved so it can be pasted back to the developer) ---
REPORT=/tmp/hwreport.txt
{
  echo "== cmdline";   cat /proc/cmdline
  echo "== fb";        cat /proc/fb
  for f in virtual_size bits_per_pixel stride name; do
    echo "fb0.$f=$(cat /sys/class/graphics/fb0/$f 2>/dev/null)"; done
  echo "== input";     cat /proc/bus/input/devices
  echo "== partitions"; cat /proc/partitions
  echo "== partition names"; for u in /sys/class/block/mmcblk0p*/uevent; do echo "$(basename $(dirname $u)) $(grep PARTNAME $u)"; done
  echo "== filesystems"; cat /proc/filesystems
  echo "== usb gadget"; ls /sys/class/android_usb/android0 2>&1
} >$REPORT 2>&1
log "hardware report: $REPORT"

# --- framebuffer: boot splash (portrait 800x1280 raw image matching bpp), else noise as proof of life ---
if [ -e /dev/fb0 ]; then
  bpp=$(cat /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null); stride=$(cat /sys/class/graphics/fb0/stride 2>/dev/null)
  if [ -f /splash.$bpp.gz ] && [ -n "$bpp" ] && [ "$stride" = "$((800 * bpp / 8))" ]; then
    gunzip -c /splash.$bpp.gz > /dev/fb0 2>/dev/null && log "splash drawn (bpp=$bpp)"
    [ -x /bin/rembly-bootanim ] && { /bin/rembly-bootanim /anim >/dev/null 2>&1 & }      # intro: ring, fox, eyes, letters (plays once, ~1.5 s)
  else
    dd if=/dev/urandom of=/dev/fb0 bs=65536 count=64 2>/dev/null
    log "splash skipped (bpp=$bpp stride=$stride): wrote noise to fb0"
  fi
fi

# --- backlight on (LK normally leaves it on; this is a safety net) ---
for b in /sys/class/leds/lcd-backlight/brightness /sys/class/leds/*/brightness; do
  [ -w "$b" ] && echo 200 >"$b" 2>/dev/null && break
done

# --- emergency access: adbd over android_usb + functionfs (as in recovery's init.rc) ---
G=/sys/class/android_usb/android0
if [ -d $G ]; then
  mkdir -p /system/bin /dev/usb-ffs/adb
  ln -sf /bin/busybox /system/bin/sh
  echo adb >$G/f_ffs/aliases
  mount -t functionfs adb /dev/usb-ffs/adb 2>/dev/null || log "functionfs mount failed"
  echo 0 >$G/enable
  echo 18d1 >$G/idVendor; echo d001 >$G/idProduct
  echo adb >$G/functions
  echo Rembly >$G/iManufacturer; echo A73 >$G/iProduct; echo rembly-a73 >$G/iSerial
  echo 1 >/sys/devices/platform/mt_usb/cmode 2>/dev/null
  if [ -x /sbin/adbd ]; then
    /sbin/adbd --device_banner=rembly >/tmp/adbd.log 2>&1 &
    sleep 1
    echo 1 >$G/enable
    log "adbd started"
  else log "no /sbin/adbd in initramfs"; fi
else
  log "no android_usb gadget in sysfs (see /tmp/hwreport.txt)"
fi

# --- find rootfs: partition labelled REMBLY, or rembly-rootfs.img on any fs ---
# ext4 volume label lives at superblock offset 1024+120 (no blkid applet in this busybox)
label_of() { dd if="$1" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\000'; }
try_mount_root() {
  dev=$1
  mount -o ro "$dev" /mnt 2>/dev/null || return 1
  if [ "$(label_of "$dev")" = REMBLY ] && [ -x /mnt/sbin/init ]; then
    mount -o remount,rw /mnt; mount --move /mnt /newroot; return 0
  fi
  if [ -f /mnt/rembly-rootfs.img ]; then
    mount -o remount,rw /mnt 2>/dev/null
    if mount -o loop /mnt/rembly-rootfs.img /newroot 2>/dev/null && [ -x /newroot/sbin/init ]; then
      return 0
    fi
    umount /newroot 2>/dev/null
  fi
  umount /mnt 2>/dev/null; return 1
}
find_root() {
  # external media first; internal userdata last
  for dev in /dev/sd[a-z][0-9] /dev/sd[a-z] /dev/mmcblk1p[0-9] /dev/mmcblk1 /dev/mmcblk0p26; do
    [ -b "$dev" ] && try_mount_root "$dev" && { log "rootfs on $dev"; return 0; }
  done
  return 1
}
n=0
while [ $n -lt 15 ]; do
  mdev -s
  find_root && {
    mount --move /proc /newroot/proc 2>/dev/null; mount --move /sys /newroot/sys 2>/dev/null
    mount --move /dev /newroot/dev 2>/dev/null
    log "switch_root"; exec switch_root /newroot /sbin/init
  }
  n=$((n+1)); sleep 1
done
log "no rootfs found -> emergency shell. Helpers: touchtest, hw (report)"
cat >/bin/touchtest <<'T'
#!/bin/sh
for e in /dev/input/event*; do echo "$e: $(cat /sys/class/input/$(basename $e)/device/name)"; done
echo "touch the screen; Ctrl-C to stop"; hexdump -C /dev/input/${1:-event2}
T
cat >/bin/hw <<'T'
#!/bin/sh
cat /tmp/hwreport.txt
T
chmod +x /bin/touchtest /bin/hw
while true; do setsid sh -c 'exec sh </dev/console >/dev/console 2>&1' ; done
