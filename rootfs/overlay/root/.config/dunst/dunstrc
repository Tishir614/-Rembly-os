[global]
    monitor = 0
    follow = none
    geometry = "360x5-16+16"
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    padding = 14
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#f2f2f2"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Fira Code 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    icon_position = left
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    startup_notification = false
    dmenu = /bin/true
    browser = /usr/bin/netsurf-gtk
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
[urgency_low]
    background = "#0b0b0b"
    foreground = "#bdbdbd"
    timeout = 4
[urgency_normal]
    background = "#0f0f0f"
    foreground = "#f2f2f2"
    timeout = 6
[urgency_critical]
    background = "#f2f2f2"
    foreground = "#050505"
    frame_color = "#ffffff"
    timeout = 0
