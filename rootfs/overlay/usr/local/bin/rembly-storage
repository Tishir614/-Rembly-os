#!/usr/bin/env python3
"""rembly-storage - where did the space go? Touch UI: bars per category, biggest folders in your home, one button for safe cleanup."""
import os, subprocess, sys, threading
sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
import remblyui as ui
from remblyui import *
ui.install_crash_handler()
CATS = [('Система и программы', ['/usr', '/lib', '/bin', '/sbin', '/opt']), ('Пакеты и их кэш', ['/var/cache', '/var/lib/apt', '/var/lib/dpkg']),
        ('Ваши файлы', ['/root/Documents', '/root/Downloads', '/root/Pictures', '/root/Music', '/root/Videos', '/root/Projects']),
        ('Кэш приложений', ['/root/.cache']), ('Журналы', ['/var/log'])]


def du(paths):
    paths = [p for p in paths if os.path.exists(p)]
    if not paths: return 0
    r = subprocess.run(['nice', '-n', '15', 'ionice', '-c3', 'du', '-sxk'] + paths, capture_output=True, text=True)
    return sum(int(l.split()[0]) for l in r.stdout.splitlines() if l.split() and l.split()[0].isdigit()) * 1024


def human(n):
    for u in ('Б', 'КБ', 'МБ', 'ГБ'):
        if n < 1024 or u == 'ГБ': return '%.0f %s' % (n, u) if u in ('Б', 'КБ') else '%.1f %s' % (n, u)
        n /= 1024


COLORS = [((1.0, 1.0, 1.0), (0.62, 0.62, 0.62)), ((0.92, 0.92, 0.92), (0.55, 0.55, 0.55)), ((0.84, 0.84, 0.84), (0.50, 0.50, 0.50)),
          ((0.76, 0.76, 0.76), (0.46, 0.46, 0.46)), ((0.68, 0.68, 0.68), (0.42, 0.42, 0.42))]


class Storage(Gtk.Window):
    def __init__(self):
        super().__init__(title='Хранилище'); self.set_default_size(820, 700); self.set_position(Gtk.WindowPosition.CENTER); ui.init_theme(); ui.style_app(self)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); v.set_border_width(18); self.add(v)
        top = ui.card(); v.pack_start(top, False, False, 0)
        self.head = Gtk.Label(xalign=0); self.head.get_style_context().add_class('rcard-big'); top.pack_start(self.head, False, False, 0)
        self.total = ui.Meter('Всего занято', (1.0, 1.0, 1.0), (0.55, 0.55, 0.55), 'Σ'); top.pack_start(self.total, False, False, 0)
        grid = Gtk.Grid(row_spacing=12, column_spacing=12, column_homogeneous=True); v.pack_start(grid, False, False, 0)
        self.rows = {}
        for i, (name, _) in enumerate(CATS):
            c = ui.card(); m = ui.Meter(name, *COLORS[i % len(COLORS)]); c.pack_start(m, False, False, 0); grid.attach(c, i % 2, i // 2, 1, 1); self.rows[name] = m
        fc = ui.card('Самые большие папки в домашнем каталоге'); v.pack_start(fc, True, True, 0)
        sc = Gtk.ScrolledWindow(); sc.set_vexpand(True); fc.pack_start(sc, True, True, 0)
        self.tv = Gtk.TextView(editable=False, monospace=True, left_margin=10, top_margin=8); sc.add(self.tv)
        row = Gtk.Box(spacing=12); v.pack_start(row, False, False, 0)
        for text, fn in (('Безопасная очистка', self.clean), ('Обновить', self.scan)):
            b = Gtk.Button(label=text); b.set_size_request(-1, 56); b.connect('clicked', lambda _b, f=fn: f()); row.pack_start(b, True, True, 0)
        self.connect('destroy', Gtk.main_quit); self.show_all(); self.scan()

    def scan(self):
        st = os.statvfs('/'); tot, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        self.head.set_text('Свободно %s' % human(free)); self.total.set(1 - free / tot, '%s из %s' % (human(tot - free), human(tot)))
        used_b = max(1, tot - free)
        def work():
            for name, paths in CATS:
                n = du(paths); GLib.idle_add(lambda name=name, n=n: self.rows[name].set(min(1, n / used_b), human(n)))
            r = subprocess.run('nice -n 15 ionice -c3 du -xk --max-depth=1 /root 2>/dev/null | sort -rn | head -9', shell=True, capture_output=True, text=True).stdout
            lines = ['%10s  %s' % (human(int(a) * 1024), b) for a, b in (l.split('\t', 1) for l in r.splitlines() if '\t' in l)]
            GLib.idle_add(lambda: self.tv.get_buffer().set_text('\n'.join(lines)))
        threading.Thread(target=work, daemon=True).start()

    def clean(self):
        d = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.YES_NO,
                              text='Очистить кэши пакетов, эскизы, временные файлы и старые журналы? Ваши файлы и настройки не затрагиваются.')
        if d.run() == Gtk.ResponseType.YES:
            subprocess.Popen(['rembly-optimize', '--quiet']).wait(); self.scan()
        d.destroy()


if __name__ == '__main__':
    Storage(); Gtk.main()
