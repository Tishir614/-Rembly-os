#!/usr/bin/env python3
"""rembley-ai - OPTIONAL AI helper for errors that rembley-doctor does not know. It is NOT built in and NOT magic:
it needs network and an OpenAI-compatible endpoint that YOU configure in /etc/rembley/ai.conf (a local Ollama on your PC/phone,
or any provider with a free tier and your own key). No endpoint configured -> it does nothing.

  rembley-ai explain [--stdin | FILE]   send the error text (secrets/IPs/MACs/keys masked), print explanation + suggested commands
  rembley-ai fix     [--stdin | FILE]   same, then OFFER each command; runs it only if you type y. Dangerous commands are refused.

The AI can be wrong. Nothing runs without your confirmation, and a deny-list blocks partitions, flashing, nvram/nvdata, rm -rf /, etc."""
import json, os, re, subprocess, sys, urllib.request

CONF = '/etc/rembley/ai.conf'
DENY = re.compile(r'(\bmkfs|\bdd\b|fastboot|flash|nvram|nvdata|protect[12]|secro|/dev/(mmcblk|sd|mtd)|\bfdisk|\bparted|\bwipefs|rm\s+-[a-z]*r[a-z]*f?\s+(/|~|\*|/\*|/etc|/usr|/var|/root|/data)(\s|$)|:\(\)\s*\{|\bshutdown|\breboot\s+-f|chmod\s+-R\s+\S+\s+/(\s|$)|\bcurl\b[^|]*\|\s*(ba)?sh|\bwget\b[^|]*\|\s*(ba)?sh)', re.I)


def conf():
    c = {'endpoint': '', 'model': '', 'key': ''}
    try:
        for l in open(CONF):
            l = l.strip()
            if l and not l.startswith('#') and '=' in l:
                k, v = l.split('=', 1); c[k.strip().lower()] = v.strip()
    except OSError: pass
    return c


def mask(t):
    t = re.sub(r'\b([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b', 'XX:MAC', t)
    t = re.sub(r'\b\d{1,3}(\.\d{1,3}){3}\b', 'x.x.x.x', t)
    t = re.sub(r'(?i)(psk|password|passwd|pass|key|token|secret|imei)\s*[=:]\s*\S+', r'\1=***', t)
    t = re.sub(r'\b\d{14,16}\b', '***', t)
    return t[-6000:]


def ask(text, c):
    body = {'model': c['model'], 'temperature': 0.1, 'messages': [
        {'role': 'system', 'content': 'You help fix errors on Rembley OS (Ubuntu 20.04 armhf, 2 GB RAM tablet, no systemd, Xorg+GTK3, apt). '
         'Answer in Russian. First a short cause. Then safe shell commands, each in its own ```sh block, one command per block. '
         'Never suggest partition, flashing, nvram or destructive commands. If unsure, say so.'},
        {'role': 'user', 'content': mask(text)}]}
    h = {'Content-Type': 'application/json'}
    if c['key']: h['Authorization'] = 'Bearer ' + c['key']
    req = urllib.request.Request(c['endpoint'].rstrip('/') + '/chat/completions', json.dumps(body).encode(), h)
    with urllib.request.urlopen(req, timeout=90) as r:
        return json.load(r)['choices'][0]['message']['content']


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('explain', 'fix'):
        print(__doc__); return 2
    c = conf()
    if not c['endpoint'] or not c['model']:
        print('ИИ не настроен. Впишите endpoint и model в %s (см. комментарии в файле). Без этого rembley-doctor работает по своим правилам.' % CONF); return 1
    args = sys.argv[2:]
    text = sys.stdin.read() if '--stdin' in args or not args else open(args[0], errors='replace').read()
    try: ans = ask(text, c)
    except Exception as e:
        print('ИИ недоступен: %s' % e); return 1
    print(ans)
    if sys.argv[1] == 'fix':
        for cmd in re.findall(r'```(?:sh|bash)?\n(.+?)\n```', ans, re.S):
            cmd = cmd.strip()
            if '\n' in cmd or DENY.search(cmd):
                print('\n[пропущено, небезопасно или несколько строк] %s' % cmd.splitlines()[0]); continue
            if input('\nВыполнить: %s ? [y/N] ' % cmd).lower() == 'y':
                print('rc=%d' % subprocess.run(cmd, shell=True).returncode)
    return 0


if __name__ == '__main__':
    sys.exit(main())
