#!/usr/bin/env python3
"""rembly-ai - OPTIONAL AI helper for errors that rembly-doctor does not know. It is NOT built in and NOT magic:
it needs network and a provider that YOU configure: in Rembly Code (✦ ИИ → ⚙, stored in ~/.config/rembly/ai.json) or in /etc/rembly/ai.conf
(a local Ollama on your PC/phone, any OpenAI-compatible server, or the Anthropic API with your own key). Nothing configured -> it does nothing.

  rembly-ai explain [--stdin | FILE]   send the error text (secrets/IPs/MACs/keys masked), print explanation + suggested commands
  rembly-ai fix     [--stdin | FILE]   same, then OFFER each command; runs it only if you type y. Dangerous commands are refused.

The AI can be wrong. Nothing runs without your confirmation, and a deny-list blocks partitions, flashing, nvram/nvdata, rm -rf /, etc."""
import os, re, subprocess, sys
sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
import rembly_ai as ai                      # one shared setup: the key / local server entered in Rembly Code (~/.config/rembly/ai.json) or in /etc/rembly/ai.conf

CONF = '/etc/rembly/ai.conf'
DENY = ai.DENY


def conf():
    return ai.load()


def mask(t):
    t = re.sub(r'\b([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b', 'XX:MAC', t)
    t = re.sub(r'\b\d{1,3}(\.\d{1,3}){3}\b', 'x.x.x.x', t)
    t = re.sub(r'\b\d{14,16}\b', '***', t)
    return ai.mask_secrets(t)[-6000:]


def ask(text, c):
    system = ('You help fix errors on Rembly OS (Ubuntu 20.04 armhf, 2 GB RAM tablet, no systemd, Xorg+GTK3, apt). '
              'Answer in Russian. First a short cause. Then safe shell commands, each in its own ```sh block, one command per block. '
              'Never suggest partition, flashing, nvram or destructive commands. If unsure, say so.')
    return ai.Client(c).chat([{'role': 'user', 'content': mask(text)}], system=system, max_tokens=1200)


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('explain', 'fix'):
        print(__doc__); return 2
    c = conf()
    if not ai.configured(c):
        print('ИИ не настроен. Введите ключ или адрес локального сервера в Rembly Code (кнопка «✦ ИИ», затем ⚙) или впишите endpoint и model в %s. Без этого rembly-doctor работает по своим правилам.' % CONF); return 1
    args = sys.argv[2:]
    text = sys.stdin.read() if '--stdin' in args or not args else open(args[0], errors='replace').read()
    try: ans = ask(text, c)
    except ai.AIError as e:
        print('ИИ недоступен: %s' % e); return 1
    except Exception as e:
        print('ИИ недоступен: %s' % e); return 1
    print(ans)
    if sys.argv[1] == 'fix':
        for cmd in re.findall(r'```(?:sh|bash)?\n(.+?)\n```', ans, re.S):
            cmd = cmd.strip()
            if '\n' in cmd or DENY.search(cmd):
                print('\n[пропущено, небезопасно или несколько строк] %s' % cmd.splitlines()[0]); continue
            if input('\nВыполнить: %s ? [y/N] ' % cmd).lower() == 'y':
                print('rc=%d' % subprocess.run(cmd, shell=True).returncode)
    return 0


if __name__ == '__main__':
    sys.exit(main())
