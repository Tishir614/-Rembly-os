#!/usr/bin/env python3
"""rembley-taskman - task manager like on a PC, built for touch: what is using CPU and memory, one big button to close a program."""
import os, signal, sys, time
sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
import rembleyui as ui
from rembleyui import *
ui.install_crash_handler()
PROTECT = {'init', 'Xorg', 'rembley-shell', 'xfwm4', 'dbus-daemon', 'udevd', 'systemd-udevd', 'adbd', 'earlyoom', 'rembley-desktop', 'rembley-doctor'}
TCK = os.sysconf('SC_CLK_TCK'); PAGE = os.sysconf('SC_PAGE_SIZE')


def snapshot():
    out = {}
    for pid in filter(str.isdigit, os.listdir('/proc')):
        try:
            st = open('/proc/%s/stat' % pid).read(); name = st[st.index('(') + 1:st.rindex(')')]; f = st[st.rindex(')') + 2:].split()
            cpu = int(f[11]) + int(f[12]); rss = int(f[21]) * PAGE
            ppid = int(f[1])
            if ppid == 2 or pid == '2' or rss == 0: continue                    # kernel threads
            out[int(pid)] = (name, cpu, rss)
        except Exception: pass
    return out


class TaskMan(Gtk.Window):
    def __init__(self):
        super().__init__(title='Диспетчер задач'); self.set_default_size(820, 620); self.set_position(Gtk.WindowPosition.CENTER)
        ui.init_theme()
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); v.set_border_width(14); self.add(v)
        self.head = Gtk.Label(xalign=0); self.head.get_style_context().add_class('rl-title'); v.pack_start(self.head, False, False, 0)
        self.mem = Gtk.ProgressBar(show_text=True); v.pack_start(self.mem, False, False, 0)
        self.store = Gtk.ListStore(int, str, float, float)
        self.tree = Gtk.TreeView(model=self.store); self.tree.set_headers_clickable(True)
        for i, (t, w) in enumerate((('PID', 80), ('Программа', 320), ('ЦП, %', 110), ('Память, МБ', 130))):
            r = Gtk.CellRendererText(); c = Gtk.TreeViewColumn(t, r, text=i); c.set_min_width(w); c.set_sort_column_id(i); self.tree.append_column(c)
        self.store.set_sort_column_id(2, Gtk.SortType.DESCENDING)
        sc = Gtk.ScrolledWindow(); sc.add(self.tree); v.pack_start(sc, True, True, 0)
        row = Gtk.Box(spacing=10); v.pack_start(row, False, False, 0)
        for text, fn in (('Закрыть программу', lambda: self.kill(signal.SIGTERM)), ('Завершить принудительно', lambda: self.kill(signal.SIGKILL)),
                         ('Освободить память', lambda: ui.sh('rembley-optimize --quiet; notify-send "Память освобождена"'))):
            b = Gtk.Button(label=text); b.set_size_request(-1, 56); b.connect('clicked', lambda _b, f=fn: f()); row.pack_start(b, True, True, 0)
        self.prev, self.t0 = snapshot(), time.time(); self.tick(); GLib.timeout_add_seconds(2, self.tick)
        self.connect('destroy', Gtk.main_quit); self.show_all()

    def kill(self, sig):
        model, it = self.tree.get_selection().get_selected()
        if not it: return
        pid, name = model[it][0], model[it][1]
        if name in PROTECT or pid == os.getpid() or pid == 1:
            d = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text='«%s» — часть системы, её нельзя закрывать отсюда.' % name); d.run(); d.destroy(); return
        try: os.kill(pid, sig)
        except OSError: pass

    def tick(self):
        now, cur = time.time(), snapshot(); dt = max(now - self.t0, 0.1)
        sel = None
        m, it = self.tree.get_selection().get_selected()
        if it: sel = m[it][0]
        self.store.clear()
        for pid, (name, cpu, rss) in cur.items():
            pc = (cpu - self.prev.get(pid, (0, cpu, 0))[1]) / TCK / dt * 100
            self.store.append([pid, name, round(max(pc, 0), 1), round(rss / 1048576, 1)])
        self.prev, self.t0 = cur, now
        if sel is not None:
            for r in self.store:
                if r[0] == sel: self.tree.get_selection().select_iter(r.iter); break
        mi = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo') if ':' in l}
        used = mi['MemTotal'] - mi.get('MemAvailable', 0)
        self.mem.set_fraction(used / mi['MemTotal']); self.mem.set_text('Память: %d из %d МБ   Подкачка (zram): %d МБ' % (used // 1024, mi['MemTotal'] // 1024, (mi['SwapTotal'] - mi['SwapFree']) // 1024))
        la = open('/proc/loadavg').read().split()[:3]; self.head.set_text('Нагрузка: %s   Процессов: %d' % (' '.join(la), len(cur)))
        return True


if __name__ == '__main__':
    TaskMan(); Gtk.main()
