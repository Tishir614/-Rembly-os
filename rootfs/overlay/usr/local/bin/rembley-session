#!/bin/sh
# Starts Xorg on the stock framebuffer (/dev/graphics/fb0) and the Rembley desktop.
export HOME=/root XDG_RUNTIME_DIR=/run/user/0 DISPLAY=:0 LANG=C.UTF-8
mkdir -p $XDG_RUNTIME_DIR /run/rembley; chmod 700 $XDG_RUNTIME_DIR
LOG=/var/log/rembley-x.log
[ -f /etc/rembley/display.conf ] && . /etc/rembley/display.conf
ROTATE=${ROTATE:-CW}          # CW = landscape 1280x800 (panel is portrait 800x1280). none|CW|CCW|UD
case $ROTATE in
  CW)  MATRIX="0 1 0 -1 0 1 0 0 1" ;;      CCW) MATRIX="0 -1 1 1 0 0 0 0 1" ;;
  UD)  MATRIX="-1 0 1 0 -1 1 0 0 1" ;;     *)   MATRIX="1 0 0 0 1 0 0 0 1"; ROTATE=none ;;
esac
D=/etc/X11/xorg.conf.d
cat > $D/10-rembley-display.conf <<C
Section "Device"
    Identifier "A73fb"
    Driver     "fbdev"
    Option     "fbdev" "/dev/graphics/fb0"
    Option     "ShadowFB" "true"
    Option     "Rotate" "$ROTATE"
EndSection
Section "Monitor"
    Identifier "M0"
    DisplaySize 217 136
EndSection
Section "Screen"
    Identifier "S0"
    Device "A73fb"
    Monitor "M0"
EndSection
Section "ServerFlags"
    Option "BlankTime" "0"
    Option "StandbyTime" "0"
    Option "SuspendTime" "0"
    Option "OffTime" "0"
EndSection
C
if [ -e /run/rembley/static-input ]; then
  # fallback: no udev detection -> enumerate input devices ourselves (no hotplug)
  {
    echo 'Section "ServerFlags"'; echo '  Option "AutoAddDevices" "false"'; echo '  Option "AutoEnableDevices" "false"'; echo 'EndSection'
    n=0; layout=""
    for d in /sys/class/input/event*; do
      [ -e "$d/device/name" ] || continue
      name=$(cat "$d/device/name"); dev=/dev/input/$(basename "$d"); n=$((n+1)); extra=""
      case "$name" in
        mtk-tpd|*[Tt]ouch*) extra="  Option \"TransformationMatrix\" \"$MATRIX\"" ;;
        *[Kk]eyboard*|*[Mm]ouse*|*HID*|*[Pp]ointer*) ;;
        *) continue ;;
      esac
      echo "Section \"InputDevice\""; echo "  Identifier \"in$n\""; echo "  Driver \"libinput\""
      echo "  Option \"Device\" \"$dev\""; [ -n "$extra" ] && echo "$extra"; echo "EndSection"
      layout="$layout
  InputDevice \"in$n\" \"SendCoreEvents\""
    done
    echo 'Section "ServerLayout"'; echo '  Identifier "L0"'; echo '  Screen "S0"'; printf '%s\n' "$layout"; echo 'EndSection'
  } > $D/30-rembley-input.conf
else
  cat > $D/30-rembley-input.conf <<C
Section "InputClass"
    Identifier "rembley-touch"
    MatchProduct "mtk-tpd"
    MatchDevicePath "/dev/input/event*"
    Driver "libinput"
    Option "TransformationMatrix" "$MATRIX"
EndSection
C
fi
exec xinit /usr/local/bin/rembley-xinitrc -- /usr/bin/Xorg :0 \
     -nolisten tcp -noreset -novtswitch -sharevts -keeptty -dpi 140 -logfile $LOG
