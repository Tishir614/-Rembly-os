#!/bin/sh
# Install the RUNNING Rembly system onto the tablet's internal userdata partition, so it no longer needs the USB/SD rootfs.
#   rembly-install-internal [--yes] [--dry-run]            (target: the partition named "userdata", checked via sysfs PARTNAME)
#   rembly-install-internal --target DEV --force-target    (testing only: any block device, e.g. a loop device)
#   --source DIR   copy this directory instead of "/"       --progress FILE  write "percent" updates there
# Only ONE partition is ever written (userdata). Android's system/vendor/boot, nvram, nvdata, protect*, secro are never touched.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
YES=0; DRY=0; TARGET=""; FORCE=0; SRC=/; PROG=/run/rembly/install.progress
while [ $# -gt 0 ]; do case "$1" in
  --yes) YES=1 ;; --dry-run) DRY=1 ;; --target) TARGET=$2; shift ;; --force-target) FORCE=1 ;; --source) SRC=$2; shift ;; --progress) PROG=$2; shift ;;
  -h|--help) sed -n '2,7p' "$0"; exit 0 ;; *) echo "unknown argument: $1"; exit 2 ;; esac; shift; done
die() { echo "ERROR: $*" >&2; echo "error: $*" > "$PROG" 2>/dev/null; exit 1; }
say() { echo "== $*"; }
mkdir -p "$(dirname "$PROG")"; echo "0" > "$PROG" 2>/dev/null

# 1. find the target: the userdata partition by its GPT name
if [ -z "$TARGET" ]; then
  for u in /sys/class/block/*/uevent; do grep -qx 'PARTNAME=userdata' "$u" 2>/dev/null && { TARGET=/dev/$(basename "$(dirname "$u")"); break; }; done
  [ -n "$TARGET" ] || die "partition 'userdata' not found (no PARTNAME=userdata in /sys/class/block)"
else
  [ "$FORCE" = 1 ] || die "--target needs --force-target (this is for testing only)"
fi
[ -b "$TARGET" ] || die "$TARGET is not a block device"
if [ "$FORCE" = 0 ]; then
  case "$(basename "$TARGET")" in mmcblk0p*) ;; *) die "refusing: $TARGET is not an eMMC partition" ;; esac
  grep -qx "PARTNAME=userdata" "/sys/class/block/$(basename "$TARGET")/uevent" 2>/dev/null || die "refusing: $TARGET is not named userdata"
fi
# 2. never overwrite what we are running from, or anything mounted
grep -q "^$TARGET " /proc/mounts && die "$TARGET is mounted (are you already running from it?)"
dev_root=$(awk '$2=="/" && $1 ~ /^\/dev\// {d=$1} END{print d}' /proc/mounts)
[ "$dev_root" = "$TARGET" ] && die "the running system IS on $TARGET already"

# 3. sizes
if [ "$SRC" = / ]; then used_kb=$(df -Pk / | awk 'NR==2{print $3}'); else used_kb=$(du -skx "$SRC" | cut -f1); fi
tsz=$(( $(cat "/sys/class/block/$(basename "$TARGET")/size") / 2 ))   # KiB
need=$(( used_kb * 115 / 100 + 200000 ))
say "copy ${used_kb} KiB; target $TARGET is ${tsz} KiB (need about ${need} KiB)"
[ "$need" -lt "$tsz" ] || die "target too small"
say "PLAN: format $TARGET as ext4 labelled REMBLY (ERASES everything on it), copy '$SRC' into it, verify."
[ "$DRY" = 1 ] && { say "dry-run: nothing written"; exit 0; }
if [ "$YES" = 0 ]; then printf 'Type YES to erase %s and install: ' "$TARGET"; read -r a; [ "$a" = YES ] || die "aborted, nothing was written"; fi

# 3b. Wi-Fi/BT helper files are copied together with the system: fetch them from Android's own partitions first (read-only), best effort
if [ -z "$SRC_NODRIVERS" ] && [ ! -x /system/bin/wmt_launcher ] && [ "$SRC" = / ]; then
  say "getting Wi-Fi drivers from the tablet's Android partitions (read-only)"; rembly-drivers install --auto 2>&1 | tail -3
fi
# 4. do it
say "formatting"; echo "2" > "$PROG"
mke2fs -q -t ext4 -L REMBLY -F -E lazy_itable_init=1 "$TARGET" || die "mkfs failed"
M=/mnt/rembly-target; mkdir -p $M; mount -t ext4 -o noatime "$TARGET" $M || die "cannot mount the new filesystem"
say "copying (this takes a few minutes)"
# --info=progress2 prints a running percentage; mirror it to the progress file for the GUI
rsync -aHAXx --numeric-ids --info=progress2 --exclude='/lost+found' --exclude='/tmp/*' --exclude='/run/*' --exclude='/var/cache/apt/archives/*.deb' "${SRC%/}/" $M/ 2>&1 | \
  tr '\r' '\n' | { last=-1; while read -r line; do
    p=$(echo "$line" | sed -n 's/.* \([0-9]\{1,3\}\)%.*/\1/p')
    [ -n "$p" ] && [ "$p" != "$last" ] && { last=$p; echo "$(( 5 + p * 90 / 100 ))" > "$PROG"; printf '\r  copied %s%% ' "$p"; }
  done; }; echo
for d in proc sys dev run tmp mnt newroot; do mkdir -p $M/$d; done; chmod 1777 $M/tmp
[ -x $M/sbin/init ] || { umount $M; die "copy incomplete: /sbin/init missing in the new system"; }
echo "installed-internal $(date +%s)" > $M/etc/rembly/installed-internal 2>/dev/null
sync; echo "97" > "$PROG"; umount $M || die "umount failed"
say "checking the new filesystem"; e2fsck -fn "$TARGET" >/dev/null 2>&1 || die "e2fsck found problems on the new filesystem"
lbl=$(dd if="$TARGET" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\0'); [ "$lbl" = REMBLY ] || die "label check failed ('$lbl')"
echo "100" > "$PROG"; echo "done" >> "$PROG"
say "DONE. Rembly is installed on $TARGET. Next start with 'fastboot boot A73-linux-test.img' will find it by itself (USB/SD are checked first: unplug them to boot from internal)."
