#!/usr/bin/env python3
"""Rembly touch gestures daemon. Reads the touchscreen (mtk-tpd) passively (NO grab: X keeps normal touch even if this crashes)
and adds what a mouse-less tablet needs:
  * long press (hold ~0.65 s without moving)  -> right click at that point
  * edge swipes (from a screen edge inward)   -> top: quick settings, left: app launcher, right: window switcher
  * optional two-finger drag (SCROLL2=1)      -> scroll wheel
Config /etc/rembly/touch.conf: LONGPRESS=1 EDGES=1 SCROLL2=0 LP_MS=650 EDGE_PX=14
usage: rembly-touchd [--device /dev/input/eventN] [--dry]   (--dry prints actions instead of injecting them)"""
import glob, os, select, struct, sys, time

EV = struct.Struct('llHHi')
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
SYN_REPORT, SYN_MT_REPORT = 0, 2
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x2f, 0x35, 0x36, 0x39
BTN_TOUCH = 0x14a
DRY = '--dry' in sys.argv
RAW_W, RAW_H = 800, 1280                                   # panel native size (mtk-tpd reports 0..800 x 0..1280)


def conf():
    c = {'LONGPRESS': 1, 'EDGES': 1, 'SCROLL2': 0, 'LP_MS': 650, 'EDGE_PX': 14}
    for path in (os.environ.get('REMBLY_TOUCH_CONF', '/etc/rembly/touch.conf'),):
        try:
            for l in open(path):
                if '=' in l and not l.startswith('#'):
                    k, v = l.strip().split('=', 1)
                    try: c[k] = int(v)
                    except ValueError: pass
        except OSError: pass
    return c


def rotation():
    try:
        for l in open('/etc/rembly/display.conf'):
            if l.startswith('ROTATE='): return l.strip().split('=', 1)[1]
    except OSError: pass
    return 'CW'


# same matrices as rembly-session: normalized raw (x, y) -> normalized screen (x', y')
def to_screen(nx, ny, rot):
    if rot == 'CW': return ny, 1 - nx
    if rot == 'CCW': return 1 - ny, nx
    if rot == 'UD': return 1 - nx, 1 - ny
    return nx, ny


def find_device():
    sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
    try:
        import rembly_touch
        r = rembly_touch.find()
        if r:
            global RAW_W, RAW_H
            rg = rembly_touch.ranges(r[0])
            if rg: RAW_W, RAW_H = rg                      # the panel's real coordinate range, not a guess
            return r[0]
    except Exception:
        pass
    for d in sorted(glob.glob('/sys/class/input/event*')):
        try:
            if open(d + '/device/name').read().strip() == 'mtk-tpd': return '/dev/input/' + os.path.basename(d)
        except OSError: pass
    return None


class Act:
    def __init__(self):
        self.x = None
        if not DRY:
            sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
            import remblyx; self.x = remblyx.XConn(); self.sw, self.sh = self.x.size()
        else: self.sw, self.sh = 1280, 800

    def right_click(self, sx, sy):
        print('ACTION right-click at %d,%d' % (sx, sy), flush=True)
        if self.x: self.x.click(3, sx, sy)

    def ctl(self, cmd):
        print('ACTION ctl %s' % cmd, flush=True)
        if DRY: return
        try:
            fd = os.open('/run/rembly/ctl', os.O_WRONLY | os.O_NONBLOCK); os.write(fd, (cmd + '\n').encode()); os.close(fd)
        except OSError: pass

    def scroll(self, up):
        print('ACTION scroll %s' % ('up' if up else 'down'), flush=True)
        if self.x: self.x.click(4 if up else 5)


def main():
    dev = sys.argv[sys.argv.index('--device') + 1] if '--device' in sys.argv else find_device()
    if not dev: sys.exit('touchscreen (mtk-tpd) not found')
    f = open(dev, 'rb', buffering=0); act = Act(); c = conf(); rot = rotation(); last_conf = time.time()
    slots, cur = {}, 0                    # type B protocol state
    frame = []                            # type A protocol: contacts of the current frame
    pending = {}                          # raw x/y of the contact being assembled (type A)
    typeB = False
    track = {'t0': None, 'p0': None, 'p': None, 'fired': False, 'edge': None, 'n': 0, 'scroll_y': None, 'scroll_acc': 0}

    def points():
        return list(slots.values()) if typeB else list(frame)

    def screen_pt(p):
        nx, ny = to_screen(min(1, max(0, p[0] / RAW_W)), min(1, max(0, p[1] / RAW_H)), rot)
        return nx * act.sw, ny * act.sh

    def on_frame():
        nonlocal c, rot, last_conf
        pts = [p for p in points() if p[0] is not None and p[1] is not None]
        now = time.monotonic()
        if time.time() - last_conf > 5: c = conf(); rot = rotation(); last_conf = time.time()
        if not pts:                                   # all fingers up
            track.update(t0=None, p0=None, p=None, fired=False, edge=None, n=0, scroll_y=None, scroll_acc=0); return
        sx, sy = screen_pt(pts[0])
        if track['t0'] is None:                       # touch down
            track.update(t0=now, p0=(sx, sy), p=(sx, sy), fired=False, n=len(pts))
            e = c['EDGE_PX']
            track['edge'] = 'top' if sy <= e else 'left' if sx <= e else 'right' if sx >= act.sw - e else None
            return
        track['p'] = (sx, sy); track['n'] = max(track['n'], len(pts))
        dx, dy = sx - track['p0'][0], sy - track['p0'][1]
        if c['EDGES'] and track['edge'] and not track['fired']:
            far = (dy if track['edge'] == 'top' else dx if track['edge'] == 'left' else -dx)
            if far > 130 and now - track['t0'] < 1.2:
                track['fired'] = True
                act.ctl({'top': 'quick', 'left': 'launcher', 'right': 'switcher'}[track['edge']])
        if c['SCROLL2'] and len(pts) == 2:
            _, sy2 = screen_pt(pts[1]); cy = (sy + sy2) / 2
            if track['scroll_y'] is None: track['scroll_y'] = cy
            track['scroll_acc'] += cy - track['scroll_y']; track['scroll_y'] = cy
            while abs(track['scroll_acc']) > 45:
                act.scroll(track['scroll_acc'] > 0); track['scroll_acc'] -= 45 if track['scroll_acc'] > 0 else -45
            track['fired'] = True

    def check_long():
        if not c['LONGPRESS'] or track['t0'] is None or track['fired'] or track['edge'] or track['n'] > 1: return
        if (time.monotonic() - track['t0']) * 1000 >= c['LP_MS']:
            dx, dy = track['p'][0] - track['p0'][0], track['p'][1] - track['p0'][1]
            if dx * dx + dy * dy < 26 * 26:
                track['fired'] = True; act.right_click(*track['p'])

    while True:
        r, _, _ = select.select([f], [], [], 0.1)
        check_long()
        if not r: continue
        data = f.read(EV.size * 64)
        for i in range(0, len(data) - EV.size + 1, EV.size):
            _, _, t, code, val = EV.unpack_from(data, i)
            if t == EV_ABS:
                if code == ABS_MT_SLOT: typeB = True; cur = val; slots.setdefault(cur, [None, None])
                elif code == ABS_MT_TRACKING_ID:
                    if typeB and val == -1: slots.pop(cur, None)
                    elif typeB: slots.setdefault(cur, [None, None])
                elif code == ABS_MT_POSITION_X:
                    if typeB: slots.setdefault(cur, [None, None])[0] = val
                    else: pending['x'] = val
                elif code == ABS_MT_POSITION_Y:
                    if typeB: slots.setdefault(cur, [None, None])[1] = val
                    else: pending['y'] = val
            elif t == EV_SYN and code == SYN_MT_REPORT and not typeB:
                if 'x' in pending and 'y' in pending: frame.append((pending['x'], pending['y']))
                pending.clear()
            elif t == EV_SYN and code == SYN_REPORT:
                on_frame()
                if not typeB: frame.clear()


if __name__ == '__main__':
    main()
