#!/usr/bin/env python3
"""Touch UI for Wi-Fi / USB network / Bluetooth info / SIM. usage: rembley-netui [wifi|usb|bt|modem]

Designed to be used with a finger only: big targets, the on-screen keyboard appears for the password,
the password dialog sits at the top of the screen so the keyboard never covers it."""
import os, subprocess, sys, threading
import gi
gi.require_version('Gtk', '3.0'); gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib
sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
import rembleyui as ui

HAVE_BLOBS = os.path.exists('/system/bin/wmt_launcher')
DEMO = bool(os.environ.get('REMBLEY_DEMO'))


def run(*a, t=60):
    try:
        return subprocess.run(['rembley-net', *a], capture_output=True, text=True, timeout=t)
    except Exception as e:
        class R: stdout = ''; stderr = str(e); returncode = 1
        return R()


def wpa(*a):
    try:
        return subprocess.run(['wpa_cli', '-i', 'wlan0', *a], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ''


def bars(dbm):
    try: v = int(dbm)
    except ValueError: return '▂'
    return '▂▄▆█' if v >= -55 else '▂▄▆' if v >= -67 else '▂▄' if v >= -78 else '▂'


def big_button(text, fn, bg=False):
    b = Gtk.Button(label=text); b.set_size_request(-1, 56)
    b.connect('clicked', lambda _b: (threading.Thread(target=fn, daemon=True).start() if bg else fn())); return b


class PasswordDialog(Gtk.Dialog):
    def __init__(self, parent, ssid):
        super().__init__(title='Пароль для «%s»' % ssid, transient_for=parent, modal=True)
        self.set_default_size(620, 220); self.set_keep_above(True)
        box = self.get_content_area(); box.set_border_width(18); box.set_spacing(12)
        l = Gtk.Label(label='Введите пароль Wi-Fi (клавиатура появится сама)', xalign=0); box.pack_start(l, False, False, 0)
        self.e = Gtk.Entry(); self.e.set_visibility(False); self.e.set_input_purpose(Gtk.InputPurpose.PASSWORD); self.e.set_size_request(-1, 60)
        self.e.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, 'view-reveal-symbolic')
        self.e.connect('icon-press', lambda w, *_: w.set_visibility(not w.get_visibility()))
        self.e.connect('activate', lambda *_: self.response(1)); box.pack_start(self.e, False, False, 0)
        for t, r in (('Подключить', 1), ('Отмена', 0)):
            b = self.add_button(t, r); b.set_size_request(220, 56)
        self.show_all()
        self.connect('map-event', self.on_map)

    def on_map(self, *_):
        self.move(max(0, (Gdk.Screen.get_default().get_width() - 620) // 2), 30)      # top of screen: the keyboard comes up at the bottom
        GLib.idle_add(lambda: (self.e.grab_focus(), ui.osk(True), False)[2])
        GLib.timeout_add(700, lambda: (ui.osk(True), False)[1])                        # onboard may still be starting


class W(Gtk.Window):
    def __init__(self, page):
        super().__init__(title='Сеть'); self.set_default_size(1000, 640); self.maximize()
        nb = Gtk.Notebook(); self.add(nb); nb.set_tab_pos(Gtk.PositionType.TOP); self.nb = nb
        self.scan_busy = False
        # ---------------- Wi-Fi ----------------
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); v.set_border_width(14)
        top = Gtk.Box(spacing=14)
        self.card = Gtk.Label(label='…', xalign=0); self.card.set_line_wrap(True); self.card.get_style_context().add_class('name')
        top.pack_start(self.card, True, True, 0)
        sw_box = Gtk.Box(spacing=8); sw_box.pack_start(Gtk.Label(label='Wi-Fi'), False, False, 0)
        self.sw = Gtk.Switch(); self.sw.set_valign(Gtk.Align.CENTER); self.sw.connect('state-set', self.on_switch); sw_box.pack_start(self.sw, False, False, 0)
        top.pack_end(sw_box, False, False, 0); v.pack_start(top, False, False, 0)
        if not HAVE_BLOBS and not DEMO:
            n = Gtk.Label(label=('Нет файлов Android для чипа Wi-Fi (/system/bin/wmt_launcher).\n'
                                 'На ПК: tools/make-blobs.sh <папка с system.bin и vendor.bin>, затем пересоберите образ (docs/NETWORK.md).'), xalign=0)
            n.set_line_wrap(True); n.get_style_context().add_class('small'); v.pack_start(n, False, False, 0)
        self.scan_btn = big_button('Искать сети', self.scan); v.pack_start(self.scan_btn, False, False, 0)
        self.spin = Gtk.Spinner(); v.pack_start(self.spin, False, False, 0)
        lbl = Gtk.Label(label='Доступные сети', xalign=0); lbl.get_style_context().add_class('rl-title'); v.pack_start(lbl, False, False, 0)
        self.lb = Gtk.ListBox(); self.lb.set_selection_mode(Gtk.SelectionMode.NONE); self.lb.connect('row-activated', self.pick)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sc.add(self.lb); v.pack_start(sc, True, True, 0)
        lbl2 = Gtk.Label(label='Сохранённые сети', xalign=0); lbl2.get_style_context().add_class('rl-title'); v.pack_start(lbl2, False, False, 0)
        self.saved = Gtk.ListBox(); self.saved.set_selection_mode(Gtk.SelectionMode.NONE)
        s2 = Gtk.ScrolledWindow(); s2.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); s2.set_size_request(-1, 130); s2.add(self.saved); v.pack_start(s2, False, False, 0)
        nb.append_page(v, Gtk.Label(label='Wi-Fi'))
        # ---------------- USB ----------------
        v4 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); v4.set_border_width(14)
        u = Gtk.Label(label=('Сеть по USB-кабелю к ПК. В ядре нет RNDIS/Ethernet, поэтому PPP через виртуальный COM-порт.\n'
                             'После «Включить» на ПК выполните:\n  sudo pppd /dev/ttyACM0 115200 192.168.7.1:192.168.7.2 noauth local nodetach\n'
                             'Планшет: 192.168.7.2, затем: ssh root@192.168.7.2\nAdb на секунду отключится и вернётся.'), xalign=0, yalign=0)
        u.set_line_wrap(True); u.set_selectable(True); v4.pack_start(u, False, False, 0)
        self.ust = Gtk.Label(label='', xalign=0); self.ust.set_line_wrap(True)
        for t_, a_ in (('Включить USB-сеть', 'on'), ('Выключить USB-сеть', 'off')):
            v4.pack_start(big_button(t_, lambda a_=a_: self.ui(self.ust.set_text, (lambda r: (r.stdout + r.stderr).strip())(run('usb-ppp', a_, t=30))), True), False, False, 0)
        v4.pack_start(self.ust, False, False, 6); nb.append_page(v4, Gtk.Label(label='USB'))
        # ---------------- Bluetooth ----------------
        v2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); v2.set_border_width(14)
        t = Gtk.Label(label=('Bluetooth недоступен на стоковом ядре: в нём отключён CONFIG_BT (нет Linux-стека Bluetooth), '
                             'поэтому BlueZ работать не может.\n\nУправлять планшетом можно пальцем; клавиатура появляется на экране сама. '
                             'Внешние клавиатуры и мыши работают по USB (OTG).\nДальше возможны: пользовательский стек (BTstack) поверх /dev/stpbt + uinput, '
                             'либо своё ядро. Подробности: docs/NETWORK.md'), xalign=0, yalign=0)
        t.set_line_wrap(True); v2.pack_start(t, False, False, 0); nb.append_page(v2, Gtk.Label(label='Bluetooth'))
        # ---------------- SIM ----------------
        v3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8); v3.set_border_width(14)
        v3.pack_start(Gtk.Label(label='Мобильные данные (SIM) — экспериментально, этап 4 после Wi-Fi.\nУкажите APN оператора.', xalign=0), False, False, 0)
        self.apn = Gtk.Entry(); self.apn.set_placeholder_text('APN, например internet'); self.apn.set_size_request(-1, 56)
        self.apn.connect('focus-in-event', lambda *_: ui.osk(True)); v3.pack_start(self.apn, False, False, 0)
        for t_, f in (('Проверить модем', lambda: self.ui(self.mo.set_text, run('modem-probe').stdout or '(пусто)')), ('Подключить', self.modem_up), ('Отключить', lambda: run('modem-down'))):
            v3.pack_start(big_button(t_, f, True), False, False, 0)
        self.mo = Gtk.Label(label='', xalign=0, yalign=0); self.mo.set_line_wrap(True); self.mo.set_selectable(True)
        s3 = Gtk.ScrolledWindow(); s3.add(self.mo); v3.pack_start(s3, True, True, 0); nb.append_page(v3, Gtk.Label(label='SIM'))

        self.show_all(); nb.set_current_page({'wifi': 0, 'usb': 1, 'bt': 2, 'modem': 3}.get(page, 0))
        self.refresh(); GLib.timeout_add_seconds(4, lambda: (self.refresh(), True)[1])
        if page in ('wifi', None) and (HAVE_BLOBS or DEMO): self.scan()

    # -------- helpers --------
    def ui(self, f, *a): GLib.idle_add(f, *a)

    def refresh(self):
        def w():
            st = run('wifi-status').stdout
            state = ''.join(l.split('=', 1)[1] for l in st.splitlines() if l.startswith('wpa_state=')).strip()
            ssid = ''.join(l.split('=', 1)[1] for l in st.splitlines() if l.startswith('ssid=')).strip()
            ip = ''.join(l.split('=', 1)[1] for l in st.splitlines() if l.startswith('ip_address=')).strip()
            net = wpa('list_networks').splitlines()[1:]
            self.ui(self.show_state, state, ssid, ip, net)
        threading.Thread(target=w, daemon=True).start()

    def show_state(self, state, ssid, ip, net):
        if DEMO: state, ssid, ip = 'COMPLETED', 'MyWiFi', '192.168.1.42'
        if state == 'COMPLETED': self.card.set_text('Подключено: %s\n%s' % (ssid, ('IP ' + ip) if ip else 'получаем адрес…'))
        elif state in ('ASSOCIATING', 'AUTHENTICATING', '4WAY_HANDSHAKE', 'ASSOCIATED'): self.card.set_text('Подключаемся…')
        elif state: self.card.set_text('Не подключено (%s)' % state.lower())
        elif not HAVE_BLOBS: self.card.set_text('Wi-Fi недоступен: нет файлов Android')
        else: self.card.set_text('Wi-Fi выключен или ещё запускается')
        self.sw.handler_block_by_func(self.on_switch); self.sw.set_active(bool(state) or DEMO); self.sw.handler_unblock_by_func(self.on_switch)
        for c in self.saved.get_children(): self.saved.remove(c)
        rows = [l.split('\t') for l in net if l.strip()]
        if DEMO: rows = [['0', 'MyWiFi', 'any', '[CURRENT]'], ['1', 'Cafe', 'any', '']]
        self.known = {r[1] for r in rows if len(r) > 1}
        for r in rows:
            if len(r) < 2: continue
            row = Gtk.ListBoxRow(); h = Gtk.Box(spacing=10); h.set_border_width(8)
            h.pack_start(Gtk.Label(label=r[1] + ('   (текущая)' if len(r) > 3 and 'CURRENT' in r[3] else ''), xalign=0), True, True, 0)
            b = Gtk.Button(label='Забыть'); b.set_size_request(150, 48); b.connect('clicked', lambda _b, i=r[0]: self.forget(i)); h.pack_end(b, False, False, 0)
            row.add(h); self.saved.add(row)
        if not rows:
            self.saved.add(Gtk.Label(label='Нет сохранённых сетей', margin=10))
        self.saved.show_all()

    def forget(self, nid):
        wpa('remove_network', nid); wpa('save_config'); self.refresh()

    def on_switch(self, sw, state):
        threading.Thread(target=lambda: (run('wifi-up' if state else 'wifi-down', t=90), self.ui(self.refresh)), daemon=True).start(); return False

    def scan(self, *_):
        if self.scan_busy: return
        self.scan_busy = True; self.spin.start(); self.scan_btn.set_sensitive(False); self.card.set_text('Поиск сетей…')
        def w():
            r = run('wifi-scan', t=120); self.ui(self.fill, r.stdout, r.stderr)
        threading.Thread(target=w, daemon=True).start()

    def fill(self, out, err):
        self.scan_busy = False; self.spin.stop(); self.scan_btn.set_sensitive(True)
        for c in self.lb.get_children(): self.lb.remove(c)
        rows = [l.split('|') for l in out.splitlines() if l.strip()]
        if DEMO: rows = [['MyWiFi', '-45', '[WPA2-PSK]'], ['Cafe', '-60', '[WPA2-PSK]'], ['Guest', '-72', '[ESS]'], ['Neighbour', '-80', '[WPA2-PSK]']]
        if not rows:
            msg = (err or '').strip()[-200:]
            self.lb.add(Gtk.Label(label='Сети не найдены. ' + (msg or 'Нажмите «Искать сети» ещё раз.'), margin=14, xalign=0)); self.lb.show_all(); self.refresh(); return
        for ssid, sig, fl in rows:
            r = Gtk.ListBoxRow(); r.ssid, r.secure = ssid, ('WPA' in fl or 'WEP' in fl)
            h = Gtk.Box(spacing=12); h.set_border_width(14)
            lab = Gtk.Label(label=ssid, xalign=0); lab.get_style_context().add_class('name'); h.pack_start(lab, True, True, 0)
            h.pack_end(Gtk.Label(label='%s %s dBm' % (bars(sig), sig)), False, False, 0)
            if r.secure: h.pack_end(Gtk.Label(label='🔒'), False, False, 6)
            r.add(h); r.set_size_request(-1, 64); self.lb.add(r)
        self.lb.show_all(); self.refresh()

    def pick(self, _lb, row):
        ssid = getattr(row, 'ssid', None)
        if not ssid: return
        psk = ''; saved = ssid in getattr(self, 'known', set())
        if row.secure and not saved:
            d = PasswordDialog(self, ssid); r = d.run(); psk = d.e.get_text(); d.destroy(); ui.osk(False)
            if r != 1 or not psk: return
        self.card.set_text('Подключение к %s…' % ssid)
        def w():
            r = run('wifi-select', ssid, t=120) if saved else run('wifi-connect', ssid, psk, t=120)
            self.ui(self.card.set_text, ('Подключено к %s' % ssid) if r.returncode == 0 else 'Не удалось подключиться: ' + (r.stdout + r.stderr).strip()[-160:])
            self.ui(self.refresh)
        threading.Thread(target=w, daemon=True).start()

    def modem_up(self):
        a = self.apn.get_text().strip()
        if a: open('/etc/rembley/modem.conf', 'w').write('APN=%s\n' % a)
        r = run('modem-up', t=120); self.ui(self.mo.set_text, (r.stdout + r.stderr).strip() or 'ok')


if __name__ == '__main__':
    ui.init_theme(); W(sys.argv[1] if len(sys.argv) > 1 else 'wifi').connect('destroy', Gtk.main_quit); Gtk.main()
