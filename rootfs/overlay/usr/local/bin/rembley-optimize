#!/bin/bash
# rembley-optimize - safe housekeeping that keeps the tablet quick. Touches only caches/logs/trim; never user files or settings.
#   rembley-optimize          run now (prints what it did)
#   rembley-optimize --quiet  same, no output (used automatically when the tablet is idle)
Q=0; [ "${1:-}" = --quiet ] && Q=1
say() { [ $Q = 1 ] || echo "• $*"; }
before=$(df -m --output=avail / | tail -1 | tr -d ' ')
say "Кэши apt и временные файлы"; apt-get clean >/dev/null 2>&1; rm -rf /var/cache/apt/archives/*.deb /tmp/rembley-* /var/tmp/* 2>/dev/null
say "Старые логи (оставляю последние 200 строк)"
for f in /var/log/*.log; do [ -f "$f" ] && [ "$(stat -c %s "$f")" -gt 262144 ] && { tail -n 200 "$f" > "$f.new" && mv "$f.new" "$f"; }; done
say "Кэш шрифтов, иконок, схем, типов файлов"
fc-cache -s >/dev/null 2>&1; gtk-update-icon-cache -q -f -t /usr/share/icons/Papirus-Dark >/dev/null 2>&1
glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null; update-desktop-database -q 2>/dev/null; update-mime-database /usr/share/mime >/dev/null 2>&1
say "Предкомпиляция Python (быстрее запуск оболочки)"; python3 -m compileall -q /usr/local/lib/rembley >/dev/null 2>&1
if command -v fstrim >/dev/null; then say "TRIM eMMC"; fstrim / >/dev/null 2>&1; fi
say "Эскизы и кэш браузера"; rm -rf /root/.cache/thumbnails /root/.thumbnails /root/.cache/netsurf 2>/dev/null
if [ -z "$(pgrep -f '[a]pt|[d]pkg')" ]; then sync; echo 1 > /proc/sys/vm/drop_caches 2>/dev/null; say "Страничный кэш сброшен"; fi
touch /var/lib/rembley/optimized 2>/dev/null
after=$(df -m --output=avail / | tail -1 | tr -d ' ')
[ $Q = 1 ] || { echo; echo "Свободно: ${before} МБ -> ${after} МБ. ОЗУ: $(awk '/MemAvailable/{printf "%d МБ доступно", $2/1024}' /proc/meminfo)"; }
exit 0
