#!/usr/bin/env python3
"""rembly-selftest: quick health check of everything that matters on the tablet, with advice for every failure.
  rembly-selftest            human readable list      rembly-selftest --json    machine readable (used by rembly-report)"""
import glob, json, os, subprocess, sys, time

RES = []


def add(name, status, detail='', hint=''):
    RES.append({'check': name, 'status': status, 'detail': detail, 'hint': hint})


def read(p, d=''):
    try: return open(p).read().strip()
    except OSError: return d


def run(cmd, t=5):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stdout.strip()
    except Exception: return ''


def checks():
    # --- display
    fb = '/sys/class/graphics/fb0'
    if os.path.exists(fb):
        add('Экран (framebuffer)', 'ok', '%s, %s bpp, stride %s' % (read(fb + '/virtual_size'), read(fb + '/bits_per_pixel'), read(fb + '/stride')))
    else: add('Экран (framebuffer)', 'fail', 'нет /sys/class/graphics/fb0', 'mdev не создал fb0: rembly-report и пришлите вывод dmesg')
    x = run('pidof Xorg')
    add('Графический сервер Xorg', 'ok' if x else 'fail', 'PID %s' % x if x else 'не запущен', '' if x else 'cat /var/log/rembly-x.log')
    # --- touch
    r = run('rembly-touchprobe', 5).strip()
    add('Сенсорный экран', 'ok' if r else 'fail', r or 'не найден', '' if r else 'cat /proc/bus/input/devices ; rembly-touchtest')
    tp = bool(r)
    if tp and run('pgrep -f "[r]embly-touchd"'): add('Жесты (rembly-touchd)', 'ok', 'работает')
    elif tp: add('Жесты (rembly-touchd)', 'warn', 'не запущен', 'cat /var/log/rembly-touchd.log')
    # --- completeness of the install (see rembly-repair)
    rr = run('rembly-repair check', 120); mf = [l for l in rr.splitlines() if l.startswith('Не хватает файлов Rembly')]
    add('Целостность файлов Rembly', 'ok' if 'Итог: всё на месте' in rr else 'warn', (mf[0] if mf else rr.splitlines()[-1] if rr else 'нет ответа'), '' if 'Итог: всё на месте' in rr else 'rembly-repair fix')
    # --- RAM: measured, not claimed
    try:
        import json as _j2
        rj = _j2.loads(run('rembly-ramtest --json', 60) or '{}'); mm = rj['measured']
        add('Оперативная память', {'ok': 'ok', 'warn': 'warn'}.get(rj['verdict'], 'fail'), 'доступно %d МБ, физически %d МБ; проверка: %s' % (mm['usable_mb'], mm['physical_mb'], rj['verdict']), '; '.join(rj['notes']))
    except Exception as e:
        add('Оперативная память', 'warn', 'rembly-ramtest не ответил: %s' % e)
    # --- connectivity chips (see rembly-chips)
    try:
        import json as _j
        for f in _j.loads(run('rembly-chips --json', 20) or '{}').get('functions', []):
            stt = f['state']
            add('Чип: %s (%s)' % (f['function'], f['chip']), 'ok' if stt in ('RUNNING', 'READY') else 'warn', '%s: %s' % (stt, f['why']), f['fix'] if stt not in ('RUNNING',) else '')
    except Exception as e:
        add('Чипы связи', 'warn', 'rembly-chips не ответил: %s' % e)
    # --- media + editor (rembly-player, rembly-code)
    mp = run('command -v mpv')
    add('Плеер: mpv', 'ok' if mp else 'fail', mp or 'не установлен', '' if mp else 'apt-get install mpv  (или rembly-repair fix)')
    cards = read('/proc/asound/cards')
    add('Звуковая карта (ALSA)', 'ok' if cards and 'no soundcards' not in cards else 'warn', (cards.splitlines()[0].strip() if cards else 'нет'),
        '' if cards and 'no soundcards' not in cards else 'видео и музыка будут без звука: cat /proc/asound/cards ; rembly-chips (драйвер звука для этого ядра не проверен)')
    mod = run("python3 -c \"import gi; gi.require_version('GtkSource','4'); gi.require_version('Vte','2.91'); import mutagen; print('ok')\" 2>&1 | tail -1")
    add('Редактор и плеер: библиотеки', 'ok' if mod == 'ok' else 'warn', 'GtkSource, Vte, mutagen на месте' if mod == 'ok' else mod[:120], '' if mod == 'ok' else 'rembly-repair fix (докачает gir1.2-gtksource-4, gir1.2-vte-2.91, python3-mutagen)')
    # --- keyboard
    kb = run('pgrep -f "[o]nboard"')
    add('Экранная клавиатура (Onboard)', 'ok' if kb else 'warn', 'работает' if kb else 'не запущена', '' if kb else 'кнопка клавиатуры в доке запустит её через D-Bus')
    # --- power
    bat = [d for d in glob.glob('/sys/class/power_supply/*') if read(d + '/type') == 'Battery']
    add('Батарея', 'ok' if bat else 'warn', ('%s%% %s' % (read(bat[0] + '/capacity'), read(bat[0] + '/status'))) if bat else 'не видна', '')
    bl = [p for p in ['/sys/class/leds/lcd-backlight/brightness'] + glob.glob('/sys/class/backlight/*/brightness') if os.path.exists(p)]
    add('Подсветка', 'ok' if bl else 'warn', bl[0] if bl else 'не найдена', 'яркость/гашение экрана работать не будут' if not bl else '')
    add('Демон питания', 'ok' if run('pgrep -f "[r]embly-power"') else 'warn', '', 'cat /var/log/rembly-power.log')
    # --- memory / storage
    mi = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo') if ':' in l}
    add('Память', 'ok' if mi['MemAvailable'] > 300 * 1024 else 'warn', 'свободно %d из %d МБ' % (mi['MemAvailable'] // 1024, mi['MemTotal'] // 1024), 'закройте приложения (кнопка «Окна»)' if mi['MemAvailable'] <= 300 * 1024 else '')
    add('Сжатый swap (zram)', 'ok' if mi.get('SwapTotal', 0) > 0 else 'warn', '%d МБ' % (mi.get('SwapTotal', 0) // 1024), '' if mi.get('SwapTotal', 0) else 'cat /var/log/rembly-boot.log')
    st = os.statvfs('/'); free = st.f_bavail * st.f_frsize // 2 ** 20
    add('Свободное место на /', 'ok' if free > 500 else 'warn', '%d МБ' % free, 'rembly-clean освободит место' if free <= 500 else '')
    rd = ''
    for l in read('/proc/mounts').splitlines():
        f = l.split()
        if len(f) > 1 and f[1] == '/' and f[0].startswith('/dev/'): rd = f[0]
    add('Откуда запущена система', 'ok', rd or 'образ (loop) или внешний носитель', '')
    t = time.time()
    add('Часы', 'ok' if t > 1700000000 else 'warn', time.strftime('%F %T'), 'время собьётся без сети: Настройки → Время и язык → NTP' if t <= 1700000000 else '')
    # --- drivers / network
    sysp = os.path.exists('/system/bin/wmt_launcher')
    add('Драйверы Wi-Fi (файлы Android)', 'ok' if sysp else 'warn', 'wmt_launcher найден' if sysp else 'не установлены', '' if sysp else 'rembly-drivers install (берёт из раздела Android на планшете)')
    fwn = len(glob.glob('/vendor/firmware/*')) + len(glob.glob('/system/etc/firmware/*'))
    if sysp: add('Прошивки Wi-Fi', 'ok' if fwn else 'fail', '%d файлов' % fwn, '' if fwn else 'rembly-drivers status')
    nv = os.path.ismount('/nvdata')
    add('NVDATA (калибровка/MAC, только чтение)', 'ok' if nv else 'warn', 'смонтирован' if nv else 'не смонтирован', '' if nv else 'rembly-net nvdata')
    wl = os.path.isdir('/sys/class/net/wlan0')
    add('Интерфейс wlan0', 'ok' if wl else 'warn', read('/sys/class/net/wlan0/operstate') if wl else 'нет', '' if wl else 'rembly-net debug (покажет причину и сам попробует починить)')
    ip = run("ip -4 -o addr show | grep -v ' lo ' | awk '{print $2\":\"$4}' | head -3")
    add('IP-адрес', 'ok' if ip else 'warn', ip or 'нет', '' if ip else 'Wi-Fi не подключён')
    # --- software
    add('Рабочий стол (rembly-shell)', 'ok' if run('pgrep -f "[r]embly-shell$"') else 'fail', '', 'cat /var/log/rembly-x.log /var/log/rembly-crash.log')
    cr = read('/var/log/rembly-crash.log')
    add('Журнал сбоев', 'ok' if not cr else 'warn', 'пуст' if not cr else '%d записей' % cr.count('====') , 'cat /var/log/rembly-crash.log' if cr else '')
    add('udev (горячее подключение USB)', 'ok' if run('pgrep -x systemd-udevd') else 'warn', '', 'USB-клавиатуры могут не подхватываться на лету')


def main():
    checks()
    if '--json' in sys.argv:
        print(json.dumps(RES, ensure_ascii=False, indent=1)); return 0
    col = {'ok': '\033[32m ok \033[0m', 'warn': '\033[33mwarn\033[0m', 'fail': '\033[31mFAIL\033[0m'}
    for r in RES:
        print('[%s] %-42s %s' % (col[r['status']] if sys.stdout.isatty() else r['status'].rjust(4), r['check'], r['detail']))
        if r['hint'] and r['status'] != 'ok': print('       -> %s' % r['hint'])
    bad = sum(1 for r in RES if r['status'] == 'fail'); warn = sum(1 for r in RES if r['status'] == 'warn')
    print('\nИтог: %d проверок, %d ошибок, %d предупреждений' % (len(RES), bad, warn))
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main())
