#!/usr/bin/env python3
"""Rembly Timer: countdown timer, stopwatch with laps, alarm clock. Notifications via dunst (sound if an ALSA card exists)."""
import os, sys, time
sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
import remblyui as ui
from remblyui import *


def beep():
    ui.sh('notify-send -u critical "Rembly" "Время вышло!"; (speaker-test -t sine -f 880 -l 1 -p 400 >/dev/null 2>&1 &)')


def fmt(sec):
    sec = max(0, int(sec)); return '%02d:%02d:%02d' % (sec // 3600, sec % 3600 // 60, sec % 60)


class W(Gtk.Window):
    def __init__(self):
        super().__init__(title='Таймер'); self.set_default_size(720, 520); self.maximize()
        ui.style_app(self)
        nb = Gtk.Notebook(); self.add(nb)
        # ---- countdown ----
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); v.set_border_width(18)
        self.tl = Gtk.Label(label='00:05:00'); self.tl.get_style_context().add_class('clock'); v.pack_start(self.tl, False, False, 8)
        pre = Gtk.Box(spacing=10, homogeneous=True)
        for m in (1, 5, 10, 15, 30, 60):
            b = Gtk.Button(label='%d мин' % m); b.set_size_request(-1, 60); b.connect('clicked', lambda _b, m=m: self.set_timer(m * 60)); pre.pack_start(b, True, True, 0)
        v.pack_start(pre, False, False, 0)
        row = Gtk.Box(spacing=10); self.sp = Gtk.SpinButton.new_with_range(1, 600, 1); self.sp.set_value(5); self.sp.set_size_request(160, 60)
        row.pack_start(Gtk.Label(label='Своё время, минут:'), False, False, 0); row.pack_start(self.sp, False, False, 0)
        b = Gtk.Button(label='Задать'); b.set_size_request(160, 60); b.connect('clicked', lambda _b: self.set_timer(int(self.sp.get_value()) * 60)); row.pack_start(b, False, False, 0)
        v.pack_start(row, False, False, 0)
        ctl = Gtk.Box(spacing=12, homogeneous=True); self.tbtn = Gtk.Button(label='Старт'); self.tbtn.set_size_request(-1, 70); self.tbtn.connect('clicked', self.t_toggle)
        rb = Gtk.Button(label='Сброс'); rb.set_size_request(-1, 70); rb.connect('clicked', lambda _b: self.t_reset()); ctl.pack_start(self.tbtn, True, True, 0); ctl.pack_start(rb, True, True, 0)
        v.pack_start(ctl, False, False, 10); nb.append_page(v, Gtk.Label(label='Таймер'))
        self.t_total = 300; self.t_left = 300; self.t_end = None
        # ---- stopwatch ----
        v2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); v2.set_border_width(18)
        self.sl = Gtk.Label(label='00:00:00.0'); self.sl.get_style_context().add_class('clock'); v2.pack_start(self.sl, False, False, 8)
        c2 = Gtk.Box(spacing=12, homogeneous=True)
        self.sbtn = Gtk.Button(label='Старт'); self.sbtn.set_size_request(-1, 70); self.sbtn.connect('clicked', self.s_toggle)
        lap = Gtk.Button(label='Круг'); lap.set_size_request(-1, 70); lap.connect('clicked', self.s_lap)
        rs = Gtk.Button(label='Сброс'); rs.set_size_request(-1, 70); rs.connect('clicked', lambda _b: self.s_reset())
        for b in (self.sbtn, lap, rs): c2.pack_start(b, True, True, 0)
        v2.pack_start(c2, False, False, 0); self.laps = Gtk.Label(label='', xalign=0, yalign=0); sc = Gtk.ScrolledWindow(); sc.add(self.laps); v2.pack_start(sc, True, True, 0)
        nb.append_page(v2, Gtk.Label(label='Секундомер')); self.s_run = False; self.s_acc = 0.0; self.s_t0 = 0.0; self.s_laps = []
        # ---- alarm ----
        v3 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); v3.set_border_width(18)
        v3.pack_start(Gtk.Label(label='Будильник (сработает один раз, пока включён планшет)', xalign=0), False, False, 0)
        r3 = Gtk.Box(spacing=10); self.hh = Gtk.SpinButton.new_with_range(0, 23, 1); self.mm = Gtk.SpinButton.new_with_range(0, 59, 1)
        for w in (self.hh, self.mm): w.set_size_request(120, 70); w.set_orientation(Gtk.Orientation.HORIZONTAL)
        t = time.localtime(time.time() + 3600); self.hh.set_value(t.tm_hour); self.mm.set_value(0)
        r3.pack_start(self.hh, False, False, 0); r3.pack_start(Gtk.Label(label=':'), False, False, 0); r3.pack_start(self.mm, False, False, 0); v3.pack_start(r3, False, False, 0)
        self.abtn = Gtk.Button(label='Включить будильник'); self.abtn.set_size_request(-1, 70); self.abtn.connect('clicked', self.a_toggle); v3.pack_start(self.abtn, False, False, 0)
        self.al = Gtk.Label(label='Будильник выключен', xalign=0); v3.pack_start(self.al, False, False, 0); nb.append_page(v3, Gtk.Label(label='Будильник')); self.a_at = None
        self.show_all(); GLib.timeout_add(250, self.tick)

    def set_timer(self, sec): self.t_total = self.t_left = sec; self.t_end = None; self.tbtn.set_label('Старт'); self.tl.set_text(fmt(sec))
    def t_toggle(self, *_):
        if self.t_end is None: self.t_end = time.monotonic() + self.t_left; self.tbtn.set_label('Пауза')
        else: self.t_left = self.t_end - time.monotonic(); self.t_end = None; self.tbtn.set_label('Старт')
    def t_reset(self): self.set_timer(self.t_total)
    def s_toggle(self, *_):
        if not self.s_run: self.s_t0 = time.monotonic(); self.s_run = True; self.sbtn.set_label('Стоп')
        else: self.s_acc += time.monotonic() - self.s_t0; self.s_run = False; self.sbtn.set_label('Старт')
    def s_now(self): return self.s_acc + ((time.monotonic() - self.s_t0) if self.s_run else 0)
    def s_lap(self, *_):
        if self.s_run: self.s_laps.append(self.s_now()); self.laps.set_text('\n'.join('Круг %d   %s' % (i + 1, fmt(x) + '.%d' % (x * 10 % 10)) for i, x in enumerate(self.s_laps)))
    def s_reset(self): self.s_run = False; self.s_acc = 0.0; self.s_laps = []; self.sbtn.set_label('Старт'); self.laps.set_text('')
    def a_toggle(self, *_):
        if self.a_at is None:
            now = time.localtime(); at = time.mktime((now.tm_year, now.tm_mon, now.tm_mday, int(self.hh.get_value()), int(self.mm.get_value()), 0, 0, 0, -1))
            if at <= time.time(): at += 86400
            self.a_at = at; self.abtn.set_label('Выключить будильник'); self.al.set_text('Сработает в %s (через %s)' % (time.strftime('%H:%M', time.localtime(at)), fmt(at - time.time())))
        else: self.a_at = None; self.abtn.set_label('Включить будильник'); self.al.set_text('Будильник выключен')
    def tick(self):
        if self.t_end is not None:
            left = self.t_end - time.monotonic(); self.tl.set_text(fmt(left + 0.5))
            if left <= 0: self.t_end = None; self.t_left = 0; self.tbtn.set_label('Старт'); self.tl.set_text('00:00:00'); beep()
        if self.s_run: x = self.s_now(); self.sl.set_text('%s.%d' % (fmt(x), int(x * 10) % 10))
        if self.a_at is not None:
            if time.time() >= self.a_at: self.a_at = None; self.abtn.set_label('Включить будильник'); self.al.set_text('Будильник сработал'); beep()
            else: self.al.set_text('Сработает в %s (через %s)' % (time.strftime('%H:%M', time.localtime(self.a_at)), fmt(self.a_at - time.time())))
        return True


if __name__ == '__main__':
    ui.init_theme(); W().connect('destroy', Gtk.main_quit); Gtk.main()
