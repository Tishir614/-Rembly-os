#!/bin/bash
# rembley-autosetup - STRICT first-boot setup for this tablet. Every step runs, then its RESULT IS CHECKED against the real system:
#   PASS = verified   FAIL = ran but the check failed (retried on the next boots, 3 tries)   WAIT = needs the network   WARN = done, but the tablet differs from the A73 profile
# Nothing is marked done on faith. Report: /var/lib/rembley/autosetup-report.txt (also: rembley-autosetup status). Re-run everything: rembley-autosetup --retry
#   rembley-autosetup            run pending steps          --pending  exit 0 if work remains          status  print the report
D=${REMBLEY_AUTO_DIR:-/var/lib/rembley}; RUND=${REMBLEY_RUN_DIR:-/run/rembley}; S=$RUND/autosetup.status; REP=$D/autosetup-report.txt; mkdir -p $D $RUND
[ "$1" = status ] && { cat $REP 2>/dev/null || echo "Автонастройка ещё не запускалась."; exit 0; }
[ "$1" = --retry ] && { rm -f $D/auto-*; }
declare -A RES DET
tries() { cat $D/auto-$1.tries 2>/dev/null || echo 0; }
# run NAME FUNC : FUNC does the work and prints a one-line detail; it returns 0 (verified), 1 (check failed), 2 (needs network), 3 (done but differs from profile)
run() {
  local n=$1 f=$2 out rc
  if [ -e $D/auto-$n.pass ]; then RES[$n]=PASS; [ -e $D/auto-$n.warn ] && RES[$n]=WARN; DET[$n]="$(cat $D/auto-$n.pass)"; return; fi
  if [ "$(tries $n)" -ge 3 ] && [ -e $D/auto-$n.fail ]; then RES[$n]=FAIL; DET[$n]="$(cat $D/auto-$n.fail) (3 попытки, дальше вручную: rembley-report)"; return; fi
  echo "$n" > $S; echo "== $n $(date +%T)"
  out=$($f 2>&1 | tail -n 1)        # the step reports its verdict through ret() (a file), because the pipe loses its exit code
  rc=$(cat $RUND/step.rc 2>/dev/null || echo 1); rm -f $RUND/step.rc
  case $rc in
    0) RES[$n]=PASS; DET[$n]=$out; echo "$out" > $D/auto-$n.pass ;;
    3) RES[$n]=WARN; DET[$n]=$out; echo "$out" > $D/auto-$n.pass; : > $D/auto-$n.warn ;;
    2) RES[$n]=WAIT; DET[$n]=$out ;;
    *) RES[$n]=FAIL; DET[$n]=$out; echo $(( $(tries $n) + 1 )) > $D/auto-$n.tries; echo "$out" > $D/auto-$n.fail ;;
  esac
}
ret() { echo "$1" > $RUND/step.rc; }
have_net() { ip route 2>/dev/null | grep -q default; }

s_device() {
  /usr/local/bin/rembley-hwprobe --apply --quiet >/dev/null 2>&1; . /etc/rembley/device.conf 2>/dev/null
  case "$DEVICE_MATCH" in
    match) echo "планшет опознан по измерениям (SoC, панель, ОЗУ ${RAM_MB} МБ, ядро $KERNEL): zram ${ZRAM_PCT}%, /tmp ${TMP_MB} МБ${DPI:+, DPI $DPI}"; ret 0 ;;
    partial) echo "часть параметров отличается от профиля A73 (rembley-hwprobe покажет, какие): применены только проверенные значения"; ret 3 ;;
    *) echo "устройство не похоже на A73: применены только значения, зависящие от ОЗУ"; ret 3 ;;
  esac
}
s_dirs() { mkdir -p /root/{Documents,Downloads,Pictures,Music,Videos,Projects,.config/rembley}; for x in Documents Downloads Pictures Music Videos Projects; do [ -d /root/$x ] || { echo "нет папки $x"; ret 1; return; }; done; echo "папки пользователя созданы"; ret 0; }
s_locale() {
  locale -a 2>/dev/null | grep -qi 'ru_RU.utf8' || locale-gen en_US.UTF-8 ru_RU.UTF-8 >/dev/null 2>&1
  update-locale LANG=ru_RU.UTF-8 LC_MESSAGES=en_US.UTF-8 2>/dev/null; [ -s /etc/rembley/kbd.conf ] || echo LAYOUTS=us,ru > /etc/rembley/kbd.conf
  if locale -a 2>/dev/null | grep -qi 'ru_RU.utf8' && grep -q 'us,ru' /etc/rembley/kbd.conf; then echo "локаль ru_RU.UTF-8 есть, раскладка us,ru"; ret 0; else echo "локаль ru_RU.UTF-8 не появилась"; ret 1; fi
}
s_hostname() {
  cur=$(cat /etc/hostname 2>/dev/null); case "$cur" in rembley-*) echo "имя уже $cur"; ret 0; return;; esac
  id=$(cat /sys/class/net/*/address 2>/dev/null | grep -v '^00:00:00' | head -1 | tr -d ':' | tail -c 5)
  [ -n "$id" ] || { echo "нет сетевого адреса для уникального имени: оставляю '$cur'"; ret 3; return; }
  echo "rembley-$id" > /etc/hostname; hostname "rembley-$id"; echo "имя планшета: rembley-$id"; ret 0
}
s_caches() { /usr/local/bin/rembley-optimize --quiet; [ -e $D/optimized ] && { echo "кэши иконок/шрифтов/Python построены"; ret 0; } || { echo "оптимизация не завершилась"; ret 1; }; }
s_touch() {
  r=$(rembley-touchprobe 2>/dev/null) && { echo "тач найден: $r"; ret 0; } || { echo "тач не найден по свойствам устройства (cat /proc/bus/input/devices)"; ret 1; }
}
s_drivers() {
  [ -x /system/bin/wmt_launcher ] || /usr/local/bin/rembley-drivers install --auto >/var/log/rembley-drivers.log 2>&1
  if [ -x /system/bin/wmt_launcher ] && [ -e /system/bin/linker ]; then echo "драйверы Wi-Fi/BT взяты из Android-разделов планшета"; ret 0
  else echo "wmt_launcher/linker не найдены: $(tail -n 1 /var/log/rembley-drivers.log 2>/dev/null)"; ret 1; fi
}
s_net() {
  [ -x /system/bin/wmt_launcher ] || { echo "нужны драйверы (шаг drivers)"; ret 1; return; }
  /usr/local/bin/rembley-net auto >/var/log/rembley-net.log 2>&1
  if [ -d /sys/class/net/wlan0 ]; then echo "интерфейс wlan0 поднят, MAC $(cat /sys/class/net/wlan0/address)"; ret 0
  else echo "wlan0 не появился: $(rembley-net preflight 2>/dev/null | grep MISSING | head -1 | sed 's/^ *//')"; ret 1; fi
}
s_selftest() {
  /usr/local/bin/rembley-selftest --json > $D/selftest-first.json 2>/dev/null
  f=$(grep -o '"status": *"fail"' $D/selftest-first.json 2>/dev/null | wc -l); w=$(grep -o '"status": *"warn"' $D/selftest-first.json 2>/dev/null | wc -l)
  if [ -s $D/selftest-first.json ] && [ "$f" = 0 ]; then echo "самопроверка: ошибок 0, предупреждений $w"; ret 0; else echo "самопроверка: ошибок $f (rembley-selftest)"; ret 1; fi
}
s_update() {
  have_net || { echo "нет сети: проверка обновления отложена"; ret 2; return; }
  /usr/local/bin/rembley-update >/var/log/rembley-update.log 2>&1 || { echo "обновление не скачалось: $(tail -n 1 /var/log/rembley-update.log)"; ret 1; return; }
  echo "версия $(cat /etc/rembley/version 2>/dev/null || echo ?)"; ret 0
}

[ -n "$REMBLEY_AUTO_STEPS" ] && . "$REMBLEY_AUTO_STEPS"      # test hook: replaces the s_* functions
[ "$1" = --pending ] && {
  for n in device dirs locale hostname caches touch drivers net selftest update; do
    [ -e $D/auto-$n.pass ] && continue; [ "$(tries $n)" -ge 3 ] && continue; exit 0; done; exit 1; }

echo "=== rembley-autosetup $(date '+%F %T')"
for n in device dirs locale hostname caches touch drivers net selftest update; do run $n s_$n; done
{
  echo "Автонастройка Rembley, $(date '+%F %T')"; echo
  nfail=0; nwait=0; nwarn=0
  for n in device dirs locale hostname caches touch drivers net selftest update; do
    printf '%-5s %-9s %s\n' "${RES[$n]}" "$n" "${DET[$n]}"
    case ${RES[$n]} in FAIL) nfail=$((nfail+1));; WAIT) nwait=$((nwait+1));; WARN) nwarn=$((nwarn+1));; esac
  done
  echo
  if [ $nfail = 0 ] && [ $nwait = 0 ] && [ $nwarn = 0 ]; then echo "ИТОГ: всё проверено, планшет настроен строго по своим измерениям."
  else echo "ИТОГ: не подтверждено шагов — $((nfail+nwait+nwarn)) (ошибки: $nfail, ждут сеть: $nwait, отличия от профиля: $nwarn). Подробности: rembley-report"; fi
} > $REP
cat $REP; echo done > $S
if grep -q '^ИТОГ: всё проверено' $REP; then notify-send "Rembley настроен" "Все шаги автонастройки подтверждены" 2>/dev/null
else notify-send "Автонастройка: есть замечания" "Откройте: rembley-autosetup status" 2>/dev/null; fi
exit 0
