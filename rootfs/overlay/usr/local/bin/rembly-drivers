#!/usr/bin/env python3
"""rembly-drivers: find the Wi-Fi / Bluetooth / GPS / modem helper programs and firmware of YOUR chip and install them.
These files are proprietary and specific to your exact Android build, so there is no generic place to download them from. Sources, in order:
  1. the tablet's OWN Android partitions (`system`, `vendor`), read-only (debugfs never writes), no internet needed
  2. a USB stick / SD card / Downloads folder holding your firmware copy (a tools/make-blobs.sh pack, or system.img / vendor.img)
  3. a pack you host yourself: /etc/rembly/drivers.conf FW_URL=https://... + FW_SHA256=... (a download without checksum is refused)
After installing, `rembly-chips adapt` matches the firmware set to the detected chip.

  rembly-drivers status
  rembly-drivers install [--auto] [--system DEV] [--vendor DEV] [--root DIR]

--auto    quiet mode used at boot / by the installer (never prompts; always exits 0)
--system/--vendor  use these block devices or image files instead of looking for PARTNAME=system / vendor
--root    install under DIR instead of / (tests)"""
import glob, json, os, subprocess, sys, tarfile, time

sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
import rembly_blobs

SYSFS = os.environ.get('SYSFS', '/sys'); DEVDIR = os.environ.get('DEVDIR', '/dev')


def arg(name, default=None):
    return sys.argv[sys.argv.index(name) + 1] if name in sys.argv else default


ROOT = arg('--root', '')
STATE = ROOT + '/var/lib/rembly'
AUTO = '--auto' in sys.argv


def find_part(name):
    for u in glob.glob(SYSFS + '/class/block/*/uevent'):
        try:
            if ('PARTNAME=%s' % name) in open(u).read().split('\n'):
                return os.path.join(DEVDIR, os.path.basename(os.path.dirname(u)))
        except OSError:
            pass
    return None


def say(msg):
    print(msg, flush=True)


def notify(title, body):
    if not ROOT:
        subprocess.run(['notify-send', title, body], stderr=subprocess.DEVNULL)


def safe_extract(tar_path, dest):
    """Unpack only system/ and vendor/ entries; never absolute or '..' paths; never replace an existing symlink or directory."""
    n = 0
    with tarfile.open(tar_path) as t:
        for m in t.getmembers():
            name = m.name.lstrip('./')
            if not (name.startswith('system/') or name.startswith('vendor/')) or '..' in name.split('/') or m.issym() or m.islnk() or m.isdev():
                continue
            target = os.path.join(dest, name)
            if os.path.islink(target) or (os.path.isdir(target) and not m.isdir()):
                continue
            if m.isdir():
                os.makedirs(target, exist_ok=True); continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            m.name = name; t.extract(m, dest); os.chown(target, 0, 0) if os.geteuid() == 0 else None; n += 1
    return n


def live_status():
    fw = [p for d in ('/vendor/firmware', '/system/etc/firmware') for p in glob.glob(ROOT + d + '/*')]
    rc = ''.join(open(f, errors='replace').read() for g in ('/vendor/etc/init/*.rc', '/vendor/etc/init/hw/*.rc', '/system/etc/init/*.rc') for f in glob.glob(ROOT + g))
    return {'wmt_launcher': os.path.exists(ROOT + '/system/bin/wmt_launcher'), 'wmt_loader': os.path.exists(ROOT + '/system/bin/wmt_loader'),
            'android_linker': os.path.exists(ROOT + '/system/bin/linker'), 'firmware_files': len(fw),
            'wmt_launcher_in_rc': 'service wmt_launcher' in rc, 'mnld_gps': os.path.exists(ROOT + '/system/bin/mnld'),
            'ccci_modem_helpers': len(glob.glob(ROOT + '/system/bin/*ccci*') + glob.glob(ROOT + '/vendor/bin/*ccci*'))}


def status():
    s = live_status(); s['partitions'] = {'system': find_part('system'), 'vendor': find_part('vendor')}
    try: s['last_install'] = json.load(open(STATE + '/drivers.json'))
    except Exception: s['last_install'] = None
    s['wifi_ready'] = bool(s['wmt_launcher'] and s['android_linker'] and s['firmware_files'])
    print(json.dumps(s, indent=2, ensure_ascii=False)); return s


def mark_tried():
    os.makedirs(STATE, exist_ok=True); open(STATE + '/drivers-tried', 'w').write(str(int(time.time())))


def from_partitions():
    """Source 1: the tablet's own Android system/vendor partitions (read-only). -> (tarball, summary, sources) or None"""
    sysdev, vendev = arg('--system', find_part('system')), arg('--vendor', find_part('vendor'))
    cand = [(r, d) for r, d in (('system', sysdev), ('vendor', vendev)) if d and os.path.exists(d)]
    if not cand:
        say('source 1 (Android partitions of the tablet): system/vendor not found'); return None
    good = []
    for r, d in cand:
        if rembly_blobs.looks_like_android(d): good.append((r, d)); say('found Android %s partition: %s (read-only)' % (r, d))
        else: say('skipping %s: does not look like an Android %s tree' % (d, r))
    if not good: say('source 1: no readable Android tree'); return None
    tarp = STATE + '/android-blobs.tar.gz'
    try: s = rembly_blobs.run(good, out=tarp, log=say)
    except RuntimeError as e: say('source 1: ' + str(e)); return None
    return tarp, s, dict(good)


def from_media():
    """Source 2: a copy of the original firmware on a USB stick / SD card / Downloads: a pack made by tools/make-blobs.sh (tar.gz with
    system/ and vendor/), or the raw system/vendor images (sparse ones are expanded). -> same tuple or None"""
    dirs = [d for pat in ('/media/*', '/mnt/*', '/root/Downloads', '/root') for d in glob.glob(ROOT + pat) if os.path.isdir(d)]
    packs, imgs = [], {}
    for d in dirs:
        for f in glob.glob(d + '/*.tar.gz') + glob.glob(d + '/*.tgz') + glob.glob(d + '/*/*.tar.gz'):
            try:
                with tarfile.open(f) as t:
                    names = [m.name.lstrip('./') for m in t.getmembers()[:400]]
                if any(n.startswith(('system/', 'vendor/')) for n in names) and 'MANIFEST.txt' in names: packs.append(f)
            except Exception: pass
        for role in ('system', 'vendor'):
            for pat in ('%s.img', '%s.bin', '%s.raw.img', '%s.img.raw'):
                for f in glob.glob(d + '/' + pat % role) + glob.glob(d + '/*/' + pat % role):
                    imgs.setdefault(role, f)
    if packs:
        say('source 2 (removable media / Downloads): firmware pack %s' % packs[0]); return packs[0], {'binaries': ['(from pack)']}, {'pack': packs[0]}
    if imgs:
        good = []
        for role, f in imgs.items():
            tmp = STATE + '/media-prepare'; os.makedirs(tmp, exist_ok=True)
            try:
                img = rembly_blobs.prepare(f, tmp)
                if rembly_blobs.looks_like_android(img): good.append((role, f)); say('found %s image on media: %s' % (role, f))
            except Exception as e: say('skip %s: %s' % (f, e))
        if good:
            tarp = STATE + '/android-blobs.tar.gz'
            try: return tarp, rembly_blobs.run(good, out=tarp, log=say), dict(good)
            except RuntimeError as e: say('source 2: ' + str(e))
    say('source 2 (USB / SD / Downloads): no firmware pack or system/vendor image found'); return None


def from_url():
    """Source 3: a firmware pack you host yourself. /etc/rembly/drivers.conf: FW_URL=https://... and FW_SHA256=<hex> (REQUIRED: a download
    without a checksum is refused). The pack is a tar.gz made by tools/make-blobs.sh. Nothing is downloaded from anywhere you did not name."""
    conf = {}
    try:
        for l in open(ROOT + '/etc/rembly/drivers.conf'):
            if '=' in l and not l.lstrip().startswith('#'): k, v = l.strip().split('=', 1); conf[k.strip()] = v.strip().strip('"')
    except OSError: pass
    url, want = conf.get('FW_URL', ''), conf.get('FW_SHA256', '').lower()
    if not url: say('source 3 (your own URL): FW_URL is not set in /etc/rembly/drivers.conf'); return None
    if not url.startswith('https://') or len(want) != 64: say('source 3: needs an https:// FW_URL and a 64-hex FW_SHA256; refusing'); return None
    if subprocess.run('ip route | grep -q default', shell=True).returncode != 0: say('source 3: no network yet'); return None
    import hashlib, urllib.request
    dst = STATE + '/download.tar.gz'; h = hashlib.sha256()
    try:
        with urllib.request.urlopen(url, timeout=60) as r, open(dst, 'wb') as f:
            while True:
                b = r.read(1 << 20)
                if not b: break
                f.write(b); h.update(b)
    except Exception as e: say('source 3: download failed: %s' % e); return None
    if h.hexdigest() != want: os.remove(dst); say('source 3: CHECKSUM MISMATCH (got %s): file deleted, nothing installed' % h.hexdigest()); return None
    say('source 3: downloaded and verified (sha256 matches)'); return dst, {'binaries': ['(from download)']}, {'url': url}


def install():
    os.makedirs(STATE, exist_ok=True)
    got = None
    for src in (from_partitions, from_media, from_url):                       # first source that yields files wins
        got = src()
        if got: break
    if not got:
        msg = ("No driver files found: not in the tablet's Android partitions, not on USB/SD/Downloads, no verified download configured. "
               "Options: (1) plug in a USB stick with your system.img/vendor.img or the pack from tools/make-blobs.sh; "
               "(2) put FW_URL and FW_SHA256 into /etc/rembly/drivers.conf (docs/NETWORK.md).")
        say(msg); notify('Драйверы чипов', 'Файлы не найдены: вставьте флешку с копией прошивки или укажите ссылку (docs/NETWORK.md)')
        mark_tried(); return 0 if AUTO else 1
    tarp, s, sources = got
    n = safe_extract(tarp, ROOT or '/')
    st = live_status(); st.update({'time': int(time.time()), 'sources': sources, 'files_installed': n, 'binaries': s['binaries']})
    json.dump(st, open(STATE + '/drivers.json', 'w'), indent=2); mark_tried()
    say('installed %d files; Wi-Fi launcher: %s, firmware files: %d, rc entry: %s' % (n, st['wmt_launcher'], st['firmware_files'], st['wmt_launcher_in_rc']))
    if not ROOT:
        subprocess.run(['rembly-chips', 'adapt'])                                 # match the firmware set to the detected chip(s)
        # small helpers that DO come from the Ubuntu archive (regulatory database, wpa_supplicant, iw): fetch them when a network is up
        if subprocess.run('ip route | grep -q default', shell=True).returncode == 0:
            say('network is up: installing regulatory database and Wi-Fi tools from Ubuntu'); subprocess.run(['rembly-pkg', 'install', 'wireless-regdb', 'crda', 'iw', 'wpasupplicant', 'rfkill'])
        if st['wmt_launcher']:
            say('starting Wi-Fi'); subprocess.run(['rembly-net', 'auto'])
    notify('Драйверы установлены' if st['wmt_launcher'] else 'Драйверы: неполный набор',
           'Wi-Fi готов: откройте значок Wi-Fi в трее' if st['wmt_launcher'] else 'Не найден wmt_launcher, подробности: rembly-drivers status')
    return 0


if __name__ == '__main__':
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if cmd == 'status': status()
    elif cmd == 'install': sys.exit(install())
    else: print(__doc__); sys.exit(2)
