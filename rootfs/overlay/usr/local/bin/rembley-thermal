#!/bin/sh
# Thermal guard for a passively cooled tablet. Reads the hottest thermal zone every 15 s (almost free).
#   >= 80 C : battery-saver mode (lower clocks), notification      >= 90 C : screen brightness is lowered too
#   <= 70 C : the profile you chose is restored
# It never writes to anything except the CPU governor, the backlight and the eco flag, and never shuts the tablet down.
hot() { m=0; for z in ${THERMAL_GLOB:-/sys/class/thermal/thermal_zone*/temp}; do v=$(cat "$z" 2>/dev/null) || continue; [ -n "$v" ] || continue
        [ "$v" -gt 1000 ] 2>/dev/null && v=$((v / 1000)); [ "$v" -gt "$m" ] 2>/dev/null && m=$v; done; echo "$m"; }
state=ok; saved=""; savedbl=""
while true; do
  t=$(hot)
  if [ "$t" -ge 80 ] && [ "$state" = ok ]; then
    state=hot; saved=$(rembley-profile status); rembley-eco on >/dev/null 2>&1
    notify-send -u critical "Планшет горячий (${t}°C)" "Включён режим экономии, чтобы он остыл" 2>/dev/null
    echo "$(date +%T) ${t}C -> eco (was $saved)" >> ${THERMAL_LOG:-/var/log/rembley-thermal.log}
  fi
  if [ "$t" -ge 90 ] && [ "$state" = hot ]; then
    state=hotter
    for b in ${BL_GLOB:-/sys/class/backlight/*/brightness}; do [ -w "$b" ] && { savedbl="$b=$(cat "$b")"; mx=$(cat "$(dirname "$b")/max_brightness" 2>/dev/null || echo 255); echo $((mx / 4)) > "$b"; }; done
    echo "$(date +%T) ${t}C -> backlight lowered" >> ${THERMAL_LOG:-/var/log/rembley-thermal.log}
  fi
  if [ "$t" -le 70 ] && [ "$state" != ok ]; then
    state=ok; [ -n "$savedbl" ] && { echo "${savedbl#*=}" > "${savedbl%%=*}"; savedbl=""; }      # brightness back to what it was
    rembley-profile "${saved:-balanced}" >/dev/null 2>&1; echo "$(date +%T) ${t}C -> back to ${saved:-balanced}" >> ${THERMAL_LOG:-/var/log/rembley-thermal.log}
  fi
  sleep ${THERMAL_SLEEP:-15}
done
