#!/usr/bin/env python3
"""Rembley power daemon: screen dim/off on idle, hardware power key, low-battery protection,
clock persistence (the tablet has no usable RTC). Config: /etc/rembley/power.conf (DIM_S, OFF_S, LOCK)."""
import glob, os, select, signal, struct, subprocess, sys, threading, time

CONF = os.environ.get('REMBLEY_POWER_CONF', '/etc/rembley/power.conf')
STATE = '/run/rembley'; os.makedirs(STATE, exist_ok=True)
EV = struct.Struct('llHHi')                  # 32-bit ARM kernel input_event (16 bytes); native layout elsewhere
KEY_POWER = 116


def conf():
    c = {'DIM_S': 60, 'OFF_S': 120, 'LOCK': 0, 'DIM_LEVEL': 20}
    try:
        for l in open(CONF):
            if '=' in l and not l.startswith('#'):
                k, v = l.strip().split('=', 1)
                try: c[k] = int(v)
                except ValueError: pass
    except Exception: pass
    if os.path.exists(STATE + '/eco'): c['DIM_S'] = max(10, c['DIM_S'] // 2); c['OFF_S'] = max(20, c['OFF_S'] // 2)
    return c


def run(cmd, t=3):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stdout.strip()
    except Exception: return ''


def backlight():
    for p in ('/sys/class/leds/lcd-backlight/brightness', *sorted(glob.glob('/sys/class/backlight/*/brightness')), *sorted(glob.glob('/sys/class/leds/*/brightness'))):
        if os.path.exists(p) and os.access(p, os.W_OK): return p


BL = os.environ.get('REMBLEY_BL') or backlight()
level = {'saved': 128, 'state': 'on'}


def bl_get():
    try: return int(open(BL).read())
    except Exception: return 128


def bl_set(v):
    try: open(BL, 'w').write(str(int(v)))
    except Exception: pass


def set_state(st, lock=False):
    if level['state'] == st or not BL: return
    if level['state'] == 'on': level['saved'] = max(bl_get(), 30)
    level['state'] = st
    if st == 'on': bl_set(level['saved'])
    elif st == 'dim': bl_set(max(3, level['saved'] * conf()['DIM_LEVEL'] // 100))
    elif st == 'off':
        bl_set(0)
        if lock and conf()['LOCK']: subprocess.Popen('rembley-lock', shell=True)


def shell_signal(sig):
    for p in run("pgrep -f '[r]embley-shell$'").split():
        try: os.kill(int(p), sig)
        except Exception: pass


_XC = None


def idle_s():
    """Seconds since the last touch/key. In-process XScreenSaver query (no xprintidle spawn every 2 s)."""
    global _XC
    try:
        if _XC is None:
            sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
            import rembleyx; _XC = rembleyx.XConn()
        v = _XC.idle_ms()
        if v is not None: return v / 1000
    except Exception:
        _XC = None
    v = run('xprintidle', 2)
    return int(v) / 1000 if v.isdigit() else 0


def power_key_thread():
    devs = {}
    for d in glob.glob('/sys/class/input/event*'):
        try:
            words = open(d + '/device/capabilities/key').read().split()
            bit = KEY_POWER; w = len(words) - 1 - bit // 32
            if w >= 0 and int(words[w], 16) >> (bit % 32) & 1:
                devs[open('/dev/input/' + os.path.basename(d), 'rb', buffering=0)] = d
        except Exception: pass
    if not devs: return
    down = None
    while True:
        r, _, _ = select.select(list(devs), [], [], 0.3)
        for f in r:
            try: data = f.read(EV.size)
            except Exception: continue
            if len(data) < EV.size: continue
            _, _, t, code, val = EV.unpack(data)
            if t == 1 and code == KEY_POWER:
                if val == 1: down = time.time()
                elif val == 0 and down:
                    if time.time() - down < 1.2:
                        set_state('on' if level['state'] == 'off' else 'off', lock=True)
                    down = None
        if down and time.time() - down >= 1.2:                  # long press -> power menu
            down = None; set_state('on'); shell_signal(signal.SIGUSR1)


def battery_loop():
    warned = set()
    while True:
        time.sleep(30)
        for d in glob.glob('/sys/class/power_supply/*'):
            try:
                if open(d + '/type').read().strip() != 'Battery': continue
                cap = int(open(d + '/capacity').read()); st = open(d + '/status').read().strip()
            except Exception: continue
            if st == 'Charging' or st == 'Full':
                warned.clear()
                if os.path.exists(STATE + '/eco-auto'): os.remove(STATE + '/eco-auto'); run('rembley-eco off')   # power is back: leave auto-saver
                continue
            if cap <= 20 and not os.path.exists(STATE + '/eco') :                                              # auto battery saver
                open(STATE + '/eco-auto', 'w').close(); run('rembley-eco on')
            for lim, msg in ((15, 'Низкий заряд: %d%%'), (5, 'Критический заряд: %d%%! Подключите зарядку')):
                if cap <= lim and lim not in warned:
                    warned.add(lim); run('notify-send -u critical "Батарея" "%s"' % (msg % cap))
            if cap <= 2:
                run('notify-send -u critical "Батарея" "Выключение, чтобы не потерять данные"'); time.sleep(3)
                run('sync; /bin/busybox poweroff -f', 10)


def time_loop():
    os.makedirs('/var/lib/rembley', exist_ok=True)
    while True:
        try: open('/var/lib/rembley/lasttime', 'w').write(str(int(time.time())))
        except Exception: pass
        time.sleep(600)


def restore(*_):
    set_state('on'); sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, restore); signal.signal(signal.SIGINT, restore)
    for f in (power_key_thread, battery_loop, time_loop): threading.Thread(target=f, daemon=True).start()
    while True:
        time.sleep(2)
        c = conf(); i = idle_s()
        if i < 1.5:
            if level['state'] != 'on': set_state('on')
            continue
        if level['state'] == 'off': continue
        playing = run('playerctl status 2>/dev/null', 2) == 'Playing'
        if i >= c['OFF_S'] and not playing: set_state('off', lock=True)
        elif i >= c['DIM_S'] and not playing: set_state('dim')


if __name__ == '__main__':
    main()
