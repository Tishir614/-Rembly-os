#!/bin/sh
# Chromium/Electron apps refuse to start without user namespaces (the stock kernel has none). This makes a copy of an app's launcher
# in ~/.local/share/applications that starts it with --no-sandbox.   usage: rembly-nosandbox APP.desktop | APPNAME
n=$1; [ -n "$n" ] || { echo "usage: rembly-nosandbox NAME   (e.g. code, chromium, discord)"; exit 1; }
src=$(ls "$n" "/usr/share/applications/$n.desktop" "/usr/local/share/applications/$n.desktop" 2>/dev/null | head -1)
[ -f "$src" ] || { echo "no launcher found for '$n'"; exit 1; }
d=/root/.local/share/applications; mkdir -p $d; out=$d/$(basename "$src")
sed -E 's#^(Exec=)([^ ]+)#\1\2 --no-sandbox#' "$src" > "$out"
echo "created $out:"; grep '^Exec=' "$out" | head -3
echo "Security note: --no-sandbox removes the browser's sandbox. Only use it for sites/apps you trust."
