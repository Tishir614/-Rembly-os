#!/bin/bash
# rembly-update - update Rembly OS with ONE command.
#   rembly-update               check -> download -> test the new files -> back up the old ones -> install -> restart the shell
#   rembly-update --check       only say whether a newer version exists
#   rembly-update --system      additionally run apt upgrade (Ubuntu packages; needs ~free space, see rembly-pkg)
#   rembly-update --rollback    put back the files from the last backup
#   rembly-update DIR|GIT_URL   use another source (e.g. a USB copy of the repo)
#   rembly-update --repair LIST restore only the files listed in LIST (one path per line, relative to /): used by rembly-repair
# Your settings are never overwritten: /etc/rembly/*.conf, ai.conf, pin, hostname, timezone, ~/.config.
# Source and branch: /etc/rembly/update.conf. Security: the download is protected by HTTPS to the repo owner, nothing more -
# new files are syntax-checked before install and the previous ones are backed up, but they are NOT signed.
set -u
R=${REMBLY_ROOT:-}   # test hook: install into another root folder instead of /
CONF=$R/etc/rembly/update.conf; BK=$R/var/backups/rembly; VER=$R/etc/rembly/version; WORK=$R/var/cache/rembly-src
REPO=; BRANCH=; TOKEN=; [ -r $CONF ] && . $CONF
GIT=(git); [ -n "$TOKEN" ] && GIT=(git -c "http.extraHeader=Authorization: Basic $(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)")   # private repo
REPAIR=""; if [ "${1:-}" = --repair ]; then REPAIR=${2:?usage: rembly-update --repair LISTFILE}; shift 2; fi    # used by rembly-repair: restore ONLY the listed files
CHECK=0; SYS=0; ROLL=0; SRC=
for a in "$@"; do case $a in --check) CHECK=1;; --system) SYS=1;; --rollback) ROLL=1;; -h|--help) sed -n '2,10p' "$0"; exit 0;; *) SRC=$a;; esac; done
say() { echo "== $*"; }
KEEP=(--exclude=/etc/hostname --exclude='/etc/rembly/*.conf' --exclude=/etc/rembly/pin --exclude=/etc/rembly/timezone --exclude=/etc/rembly/ai.conf --exclude=/etc/rembly/version --exclude=/root/.config/)

if [ $ROLL = 1 ]; then
  last=$(ls -1t $BK/*.tar.gz 2>/dev/null | head -1); [ -n "$last" ] || { echo "no backup in $BK"; exit 1; }
  tar -C "${R:-/}" -xzf "$last" && say "restored $last" && { command -v rembly-restart-shell >/dev/null && rembly-restart-shell; }; exit 0
fi

# ---- get the source ----
[ -z "$SRC" ] && [ -d "${REMBLY_REPO:-}/rootfs/overlay" ] && SRC=$REMBLY_REPO      # a folder (USB copy of the repo) works offline too
if [ -n "$SRC" ] && [ -d "$SRC/rootfs/overlay" ]; then DIR=$SRC; NEW=$(git -C "$SRC" rev-parse --short HEAD 2>/dev/null || echo local)
else
  URL=${SRC:-${REMBLY_REPO:-$REPO}}; [ -n "$URL" ] || { echo "no source: set REPO= in $CONF or pass a git URL / folder"; exit 1; }
  [ -n "$R" ] || ip route 2>/dev/null | grep -q default || { echo "no network. Connect Wi-Fi first (Settings -> Network)."; exit 1; }
  mkdir -p $WORK
  if [ ! -d $WORK/.git ] || [ "$(git -C $WORK remote get-url origin 2>/dev/null)" != "$URL" ]; then rm -rf $WORK; git init -q $WORK && git -C $WORK remote add origin "$URL"; fi
  say "checking $URL ${BRANCH:+($BRANCH)}"
  "${GIT[@]}" -C $WORK fetch -q --depth 1 origin ${BRANCH:-HEAD} || { echo "download failed"; exit 1; }
  NEW=$(git -C $WORK rev-parse --short FETCH_HEAD); DIR=$WORK
fi
if [ -n "$REPAIR" ]; then
  [ "$DIR" = $WORK ] && { git -C $WORK checkout -q -f FETCH_HEAD || exit 1; }
  n=0; miss=0; badn=0
  while IFS= read -r p; do
    case "$p" in ''|/*|*..*) continue;; esac
    src="$DIR/rootfs/overlay/$p"; [ -f "$src" ] || { miss=$((miss + 1)); continue; }
    case "$(head -c 40 "$src" | head -1)" in                                  # never install a file that does not even parse
      '#!/bin/sh'*|'#!/bin/bash'*) bash -n "$src" 2>/dev/null || { badn=$((badn + 1)); continue; } ;;
      '#!/usr/bin/env python3'*) python3 -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$src" 2>/dev/null || { badn=$((badn + 1)); continue; } ;;
    esac
    mkdir -p "$(dirname "$R/$p")" && cp -a "$src" "$R/$p" && n=$((n + 1))
  done < "$REPAIR"
  echo "repaired $n files ($miss not present in the repository version, $badn skipped: failed the syntax check)"; exit 0
fi
OLD=$(cat $VER 2>/dev/null || echo none)
echo "installed: $OLD   available: $NEW"
if [ "$OLD" = "$NEW" ] && [ $SYS = 0 ]; then echo "Already up to date."; exit 0; fi
if [ $CHECK = 1 ]; then
  if [ "$OLD" != "$NEW" ]; then
    echo "Update available."
    if [ "$DIR" = $WORK ]; then echo "--- what's new ---"; git -C $WORK show FETCH_HEAD:CHANGELOG.md 2>/dev/null | sed -n '1,14p'; fi
  fi; exit 0
fi

if [ "$DIR" = $WORK ]; then git -C $WORK checkout -q -f FETCH_HEAD || exit 1; fi
if [ "$OLD" != "$NEW" ]; then
  # ---- test the new files BEFORE touching the system ----
  say "testing new files"
  bad=0
  while IFS= read -r f; do
    case "$(head -c 40 "$f" 2>/dev/null | head -1)" in
      '#!/bin/sh'*|'#!/bin/bash'*) bash -n "$f" 2>/dev/null || { echo "  syntax error: $f"; bad=1; } ;;
      '#!/usr/bin/env python3'*) python3 -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$f" 2>/dev/null || { echo "  syntax error: $f"; bad=1; } ;;
    esac
  done < <(find "$DIR/rootfs/overlay/usr/local/bin" "$DIR/rootfs/overlay/etc/rembly/rc.d" -type f 2>/dev/null)
  for f in "$DIR"/rootfs/overlay/usr/local/lib/rembly/*.py; do [ -f "$f" ] || continue; python3 -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$f" 2>/dev/null || { echo "  syntax error: $f"; bad=1; }; done
  [ $bad = 0 ] || { echo "The new version failed the checks - NOTHING was changed."; exit 1; }
  # ---- space + backup of exactly the files that will change ----
  mkdir -p $BK; free=$(df -m --output=avail "${R:-/}" | tail -1 | tr -d ' ')
  [ "$free" -gt 150 ] || { echo "only ${free} MB free: run rembly-clean first"; exit 1; }
  say "backing up files that will change"
  list=$(rsync -ain "${KEEP[@]}" "$DIR/rootfs/overlay/" "$R/" 2>/dev/null | awk '/^[<>c.][fL]/ {sub(/^[^ ]+ /,""); print}')
  ts=$(date +%Y%m%d-%H%M%S)
  ( cd "${R:-/}" && printf '%s\n' $list | while read -r p; do [ -e "$p" ] && echo "$p"; done | tar -czf $BK/$ts.tar.gz -T - 2>/dev/null )
  ls -1t $BK/*.tar.gz 2>/dev/null | tail -n +6 | xargs -r rm -f          # keep the last 5
  say "installing"
  rsync -a "${KEEP[@]}" "$DIR/rootfs/overlay/" "$R/" || { echo "install failed - run: rembly-update --rollback"; exit 1; }
  [ -n "$R" ] || {
  chmod +x /usr/local/bin/rembly-* /usr/sbin/init /etc/rembly/rc.d/*.sh 2>/dev/null
  find /usr/local/lib/rembly -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null
  python3 -m compileall -q /usr/local/lib/rembly >/dev/null 2>&1
  glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null; }
  echo "$NEW" > $VER
  [ -x "$R/usr/local/bin/rembly-repair" ] && python3 "$R/usr/local/bin/rembly-repair" manifest "$DIR/rootfs/overlay" > "$R/usr/share/rembly/MANIFEST.sha256.new" 2>/dev/null && mv "$R/usr/share/rembly/MANIFEST.sha256.new" "$R/usr/share/rembly/MANIFEST.sha256"   # what a complete install looks like now
  # does anything need a reboot? (init / rc.d / sysctl) otherwise just restart the shell
  NEEDBOOT=0; echo "$list" | grep -qE 'sbin/init|rc\.d/' && NEEDBOOT=1
fi
if [ $SYS = 1 ]; then
  say "Ubuntu packages (apt upgrade)"
  rembly-pkg update && DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confold upgrade
fi
say "done: $OLD -> $NEW   (undo: rembly-update --rollback)"
if [ "${NEEDBOOT:-0}" = 1 ]; then echo "init/rc.d changed: reboot to apply everything."; else [ -z "$R" ] && command -v rembly-restart-shell >/dev/null && rembly-restart-shell >/dev/null 2>&1; fi
exit 0
