#!/usr/bin/env python3
"""rembley-repair - finds what is MISSING (or damaged) after a first flash and fetches it for you.
  rembley-repair check      list missing / changed Rembley files, missing Ubuntu packages, missing connectivity drivers (exit 0 = all complete)
  rembley-repair fix        repair what can be repaired right now (needs network for downloads)
  rembley-repair fix --all  also restore files that were CHANGED (overwrites your edits of Rembley's own programs)
  rembley-repair firstboot  first start after flashing: deep check (our files by hash, every Ubuntu package file by dpkg -V), waits for the network, downloads what
                            did not arrive or arrived damaged; repeats at the next starts until complete (rc.d/07-firstrepair.sh)
  rembley-repair auto       at every login (started by the desktop): quick local check; if something is missing, wait for the network, then fix
  rembley-repair fix --from DIR   take the files from a folder with a copy of the repository (USB stick) instead of the network
  rembley-repair manifest DIR   print the manifest of an overlay folder (used by the image build and by rembley-update)
Where things come from: Rembley's own files  -> the repository in /etc/rembley/update.conf (same source as rembley-update; only the missing files are copied,
each must pass a syntax check);  Ubuntu packages -> rembley-pkg (apt);  Wi-Fi/BT drivers -> rembley-drivers (tablet partitions, USB, your own checked URL).
The expected file list is /usr/share/rembley/MANIFEST.sha256 (made when the image was built / updated), packages: /usr/share/rembley/packages.txt.
It cannot repair the kernel/boot image (that is flashed from the PC) and it never touches nvram/nvdata or Android partitions."""
import hashlib, json, os, subprocess, sys, time

ROOT = os.environ.get('REMBLEY_ROOT', '')
MAN = ROOT + '/usr/share/rembley/MANIFEST.sha256'
PKGS = ROOT + '/usr/share/rembley/packages.txt'
STATE = ROOT + '/var/lib/rembley'
LOG = ROOT + '/var/log/rembley-repair.log'
CODE = ('usr/local/bin/', 'usr/local/lib/rembley/', 'usr/sbin/init', 'etc/rembley/rc.d/', 'usr/share/rembley/', 'usr/share/themes/Rembley/', 'etc/udev/rules.d/', 'usr/share/applications/rembley')
SKIP = ('etc/hostname', 'etc/rembley/version', 'etc/rembley/buildtime', 'etc/rembley/pin', 'etc/rembley/timezone', 'etc/rembley/ai.conf', 'etc/rembley/drivers.conf',
        'etc/rembley/update.conf', 'etc/rembley/device.conf', 'usr/share/rembley/MANIFEST.sha256', 'usr/share/rembley/packages.txt')


def log(msg):
    line = time.strftime('%F %T ') + msg; print(line, flush=True)
    try:
        with open(LOG, 'a') as f: f.write(line + '\n')
    except OSError: pass


def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''): h.update(b)
    return h.hexdigest()


def skipped(rel):
    return rel in SKIP or '__pycache__' in rel or rel.endswith('.pyc')


def manifest(d):
    for dp, dn, fn in os.walk(d):
        dn.sort()
        for f in sorted(fn):
            full = os.path.join(dp, f); rel = os.path.relpath(full, d)
            if skipped(rel) or os.path.islink(full): continue
            print('%s  %s' % (sha(full), rel))


def load_manifest():
    out = {}
    try:
        for l in open(MAN):
            h, _, p = l.rstrip('\n').partition('  ')
            if h and p: out[p] = h
    except OSError: pass
    return out


def installed(pkg):
    r = subprocess.run(['dpkg-query', '-W', '-f', '${Status}', pkg], capture_output=True, text=True)
    return 'install ok installed' in r.stdout


def check():
    man = load_manifest(); res = {'missing': [], 'changed': [], 'packages': [], 'drivers': False, 'manifest': bool(man)}
    for rel, h in sorted(man.items()):
        p = ROOT + '/' + rel
        if not os.path.lexists(p): res['missing'].append(rel)
        elif rel.startswith(CODE) and os.path.isfile(p) and sha(p) != h: res['changed'].append(rel)
    try: pk = [l.strip() for l in open(PKGS) if l.strip()]
    except OSError: pk = []
    if pk and not ROOT: res['packages'] = [p for p in pk if not installed(p)]
    res['drivers'] = not ROOT and not os.path.exists('/system/bin/wmt_launcher')
    return res


def problems(r): return len(r['missing']) + len(r['packages']) + (1 if r['drivers'] else 0)


def show(r):
    if not r['manifest']: print('Список файлов (MANIFEST.sha256) не найден: проверка файлов невозможна.')
    print('Не хватает файлов Rembley: %d' % len(r['missing'])); [print('   - ' + p) for p in r['missing'][:25]]
    if len(r['missing']) > 25: print('   … и ещё %d' % (len(r['missing']) - 25))
    print('Изменено вручную/повреждено: %d' % len(r['changed'])); [print('   ~ ' + p) for p in r['changed'][:15]]
    print('Не хватает пакетов Ubuntu: %d %s' % (len(r['packages']), ' '.join(r['packages'][:20])))
    print('Драйверы Wi-Fi/BT (из прошивки): %s' % ('НЕ установлены' if r['drivers'] else 'на месте'))
    print('Итог: ' + ('всё на месте' if problems(r) == 0 else 'есть недостающее: rembley-repair fix'))


def online():
    return subprocess.run('ip route 2>/dev/null | grep -q default', shell=True).returncode == 0


def notify(t, b):
    if not ROOT: subprocess.run(['notify-send', t, b], stderr=subprocess.DEVNULL)


def fix(allfiles=False):
    r = check(); todo = list(r['missing']) + (list(r['changed']) if allfiles else [])
    if problems(r) == 0 and not todo: log('nothing to repair'); return 0
    if not online() and not ROOT: log('no network: cannot download yet'); return 2
    if todo:
        lst = STATE + '/repair-list.txt'; os.makedirs(STATE, exist_ok=True); open(lst, 'w').write('\n'.join(todo) + '\n')
        log('restoring %d files from the repository: %s' % (len(todo), ', '.join(todo[:6]) + (' …' if len(todo) > 6 else '')))
        rc = subprocess.run(['rembley-update', '--repair', lst]).returncode
        if rc != 0: log('rembley-update --repair failed (rc=%d); is the repository reachable? see /etc/rembley/update.conf' % rc)
    if r['packages'] and not ROOT:
        log('installing missing Ubuntu packages: %s' % ' '.join(r['packages'][:12]))
        subprocess.run(['rembley-pkg', 'update'])
        for i in range(0, len(r['packages']), 8):                                  # in small groups: one unknown package must not block the rest
            grp = r['packages'][i:i + 8]
            if subprocess.run(['rembley-pkg', 'install'] + grp).returncode != 0:
                for p in grp: subprocess.run(['rembley-pkg', 'install', p])
    if r['drivers'] and not ROOT:
        log('connectivity drivers missing: looking for them (tablet partitions, USB, your URL)')
        subprocess.run(['rembley-drivers', 'install', '--auto'])
    r2 = check(); left = problems(r2) + (len(r2['changed']) if allfiles else 0)
    json.dump({'time': int(time.time()), 'before': {k: (len(v) if isinstance(v, list) else v) for k, v in r.items()}, 'left': left}, open(STATE + '/repair.json', 'w'))
    log('repair finished: %d problem(s) left' % left)
    return 0 if left == 0 else 1


def deep_pkg_verify():
    """First boot only: dpkg checks every file of every installed package against its md5sums (slow on eMMC -> lowest CPU and I/O priority).
    Returns {package: [bad files]} for files that are MISSING or DAMAGED. Our own files (they replaced some package files on purpose), config files
    and anything under /etc /var /usr/share/doc are ignored."""
    if ROOT: return {}
    ours = {'/' + p for p in load_manifest()}
    try:
        out = subprocess.run(['nice', '-n', '19', 'ionice', '-c3', 'dpkg', '-V'], capture_output=True, text=True, timeout=1500).stdout
    except Exception as e:
        log('deep package check did not finish: %s' % e); return {}
    bad = []
    for l in out.splitlines():
        parts = l.split(None, 2)
        if len(parts) < 2: continue
        flags, rest = parts[0], l[len(parts[0]):].strip()
        isconf = rest.startswith('c ')
        path = rest[2:].strip() if isconf else rest
        if isconf or not path.startswith('/') or path in ours or path.startswith(('/etc/', '/var/', '/usr/share/doc/', '/usr/share/man/', '/usr/lib/python3/dist-packages/__pycache__')) or '__pycache__' in path: continue
        if flags == 'missing' or '5' in flags[:3] or flags[2:3] == '5': bad.append(path)
    pk = {}
    for path in bad[:400]:
        r = subprocess.run(['dpkg', '-S', path], capture_output=True, text=True)
        if r.returncode == 0: pk.setdefault(r.stdout.split(':')[0].strip(), []).append(path)
    return pk


def firstboot():
    """The first start after flashing: find EVERYTHING that did not arrive intact and fetch it. Runs until it succeeds (flag), at most 6 boots."""
    flag, tries = STATE + '/repair-firstboot-done', STATE + '/repair-firstboot-tries'
    if os.path.exists(flag): return 0
    os.makedirs(STATE, exist_ok=True)
    n = int(open(tries).read()) if os.path.exists(tries) else 0
    if n >= 6: log('first-boot repair gave up after 6 boots: run rembley-repair fix'); return 1
    open(tries, 'w').write(str(n + 1))
    r = check(); deep = deep_pkg_verify()
    # on the very first start nothing was edited yet, so a file that differs from the manifest is damage: restore it too
    todo = len(r['missing']) + len(r['changed']) + len(r['packages']) + sum(len(v) for v in deep.values()) + (1 if r['drivers'] else 0)
    log('first start: %d missing file(s), %d damaged, %d missing package(s), %d package(s) with damaged files, drivers %s' % (
        len(r['missing']), len(r['changed']), len(r['packages']), len(deep), 'missing' if r['drivers'] else 'ok'))
    if todo == 0 or (todo == 1 and r['drivers'] and not (r['missing'] or r['changed'])):
        if todo: log('only the connectivity drivers are missing: rembley-autosetup handles them')
        open(flag, 'w').write(str(int(time.time()))); log('first-start check: everything arrived intact'); return 0
    notify('Rembley: часть файлов не доехала', 'Найдено: %d. Докачаю при первом подключении к сети (Wi-Fi: значок в трее).' % todo)
    waited = 0
    while not ROOT and not online() and waited < 1800: time.sleep(20); waited += 20
    if not ROOT and not online(): log('no network within 30 minutes: will try again at the next start'); return 2
    rc = fix(allfiles=True)
    for pkg in sorted(deep):                                                        # damaged files of Ubuntu packages: reinstall just those packages
        log('reinstalling %s (damaged: %s)' % (pkg, ', '.join(deep[pkg][:3])))
        subprocess.run(['apt-get', 'install', '--reinstall', '-y', '--no-install-recommends', pkg])
    r2 = check()
    if problems(r2) - (1 if r2['drivers'] else 0) + len(r2['changed']) == 0:
        open(flag, 'w').write(str(int(time.time()))); log('first-start repair complete'); notify('Rembley: всё докачано', 'Файлы системы на месте')
        return 0
    log('first-start repair incomplete (rc=%d); will retry at the next start' % rc); notify('Rembley: докачано не всё', 'Повторю при следующем запуске. Подробности: rembley-repair check'); return 1


def auto():
    r = check()
    if problems(r) == 0: return 0                                                  # the normal case: nothing to do, nothing shown
    log('login check: %d missing file(s), %d missing package(s), drivers %s' % (len(r['missing']), len(r['packages']), 'missing' if r['drivers'] else 'ok'))
    notify('Rembley: не хватает файлов', 'Найдено недостающее (%d). Докачаю сам, как только появится сеть.' % problems(r))
    waited = 0
    while not ROOT and not online() and waited < 1800: time.sleep(20); waited += 20             # up to 30 minutes for Wi-Fi
    rc = fix()
    notify('Rembley: недостающее восстановлено' if rc == 0 else 'Rembley: восстановлено не всё', 'Подробности: rembley-repair check' if rc else 'Проверка пройдена')
    return rc


if __name__ == '__main__':
    if '--from' in sys.argv: os.environ['REMBLEY_REPO'] = sys.argv[sys.argv.index('--from') + 1]       # offline: a folder with a copy of the repository (USB)
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'check'
    if cmd == 'manifest': manifest(sys.argv[2] if len(sys.argv) > 2 else '.')
    elif cmd == 'check': r = check(); show(r); sys.exit(0 if problems(r) == 0 else 1)
    elif cmd == 'fix': sys.exit(fix('--all' in sys.argv))
    elif cmd == 'auto': sys.exit(auto())
    elif cmd == 'firstboot': sys.exit(firstboot())
    else: print(__doc__)
