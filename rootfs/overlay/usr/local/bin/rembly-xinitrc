#!/bin/sh
# Runs inside Xorg. Everything graphical must live under ONE D-Bus session (onboard, dunst, shell talk over it).
[ -f /etc/profile.d/rembly-linux.sh ] && . /etc/profile.d/rembly-linux.sh
export XDG_CURRENT_DESKTOP=XFCE GTK_OVERLAY_SCROLLING=1 GDK_SCALE=1
[ -f /etc/rembly/display.conf ] && . /etc/rembly/display.conf; DPI=${DPI:-140}
[ -f /etc/rembly/kbd.conf ] && . /etc/rembly/kbd.conf
printf "Xft.dpi: $DPI\\nXft.antialias: 1\nXft.hinting: 1\nXft.hintstyle: hintslight\nXft.rgba: none\nXcursor.size: 32\\n" | xrdb -merge
xset s off -dpms 2>/dev/null
setxkbmap -layout ${LAYOUTS:-us,ru} -option grp:alt_shift_toggle,grp:win_space_toggle 2>/dev/null
xset r rate 300 35 2>/dev/null
# udev-mode sanity check: if the touchscreen was not picked up, restart X in static-input mode once
( sleep 6
  TPN=$(rembly-touchprobe name 2>/dev/null); [ -n "$TPN" ] || TPN=mtk-tpd
  if ! xinput list --name-only 2>/dev/null | grep -qF "$TPN"; then
    if [ ! -e /run/rembly/static-input ]; then touch /run/rembly/static-input; pkill -x Xorg; fi
  fi ) &
exec dbus-launch --exit-with-session /usr/local/bin/rembly-desktop
