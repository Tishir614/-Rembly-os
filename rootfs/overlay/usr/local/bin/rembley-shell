def avail_apps():
    return [a for a in APPS if DEMO or have(a[2])]


class SquareAvatar(Gtk.DrawingArea):
    """Framed square picture, like the fetch window of the reference."""
    def __init__(self, size):
        super().__init__(); self.size = size; self.set_size_request(size, size)
        self.pb = None
        for p in (CFG + '/avatar.png', SHARE + '/avatar.png'):
            try: self.pb = GdkPixbuf.Pixbuf.new_from_file_at_size(p, size - 6, size - 6); break
            except Exception: continue

    def do_draw(self, cr):
        s = self.size
        if self.pb is not None: Gdk.cairo_set_source_pixbuf(cr, self.pb, 3, 3); cr.paint()
        cr.set_source_rgba(1, 1, 1, 0.95); cr.set_line_width(2); cr.rectangle(1, 1, s - 2, s - 2); cr.stroke()


class Visualizer(Gtk.DrawingArea):
    """cava-style bars. They move only while sound is really playing (ALSA says RUNNING); otherwise they rest, which costs no CPU."""
    N = 26
    REST = [.30, .22, .45, .28, .55, .40, .72, .50, .36, .86, .48, .32, .38, .62, .44, .30, .90, .52, .34, .58, .42, .26, .33, .21, .47, .29]

    def __init__(self):
        super().__init__(); self.set_size_request(200, 120); self.v = list(self.REST); self.playing = False; self.obscured = False
        GLib.timeout_add(1000, self.poll)

    def poll(self):
        try:
            on = any('RUNNING' in open(f).read() for f in glob.glob('/proc/asound/card*/pcm*p/sub*/status'))
        except Exception: on = False
        if DEMO: on = False
        if on and not self.playing and not self.obscured: GLib.timeout_add(90, self.tick)
        if not on and self.playing: self.v = list(self.REST); self.queue_draw()
        self.playing = on; return True

    def tick(self):
        if not self.playing or system_busy(): return False
        for i in range(self.N):
            tgt = random.random() ** 1.4
            self.v[i] = max(tgt, self.v[i] * 0.82) if tgt > self.v[i] else self.v[i] * 0.86
        self.queue_draw(); return True

    def do_draw(self, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height(); gap = 6; bw = (w - gap * (self.N - 1)) / self.N
        for i, v in enumerate(self.v):
            bh = max(3, v * (h - 6)); x = i * (bw + gap)
            cr.set_source_rgba(0.96, 0.96, 0.96, 0.95); cr.rectangle(x, h - bh, bw, bh); cr.fill()


class Home(Win):
    """Desktop: the wallpaper with three tiled "windows" - fetch card, audio bars, apps - and the bar on top (see Bar)."""
    def __init__(self, sw, sh_, wall, blur):
        super().__init__(wall, blur, (0, 0), type=Gtk.WindowType.TOPLEVEL)
        self.sw, self.sh = sw, sh_
        self.set_type_hint(Gdk.WindowTypeHint.DESKTOP); self.set_decorated(False)
        self.set_default_size(sw, sh_); self.move(0, 0); self.set_keep_below(True)
        self.fixed = Gtk.Fixed(); self.add(self.fixed)
        self.launcher = None
        fx, fy = sw / 1280.0, (sh_ - BAR) / 760.0
        self.build_visualizer(int(60 * fx), BAR + int(380 * fy), int(420 * fx), int(330 * fy))
        self.build_fetch(int(748 * fx), BAR + int(70 * fy), int(470 * fx), int(215 * fy))
        self.build_apps(int(420 * fx), BAR + int(250 * fy), int(400 * fx), int(300 * fy))
        GLib.timeout_add_seconds(15, self.refresh_fetch)

    def put(self, w, x, y, ww, hh):
        w.set_size_request(ww, hh); self.fixed.put(w, x, y)

    def show_home(self): sh('wmctrl -k on')

    def open_launcher(self, cat):
        if self.launcher is None: self.launcher = Launcher(self.sw, self.sh - BAR, self.wall, self.blur)
        self.launcher.show_cat(cat)

    def tile(self, name, ic, cmd, px):
        b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('tile')
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4); v.pack_start(appicon(ic, px), False, False, 0)
        l = Gtk.Label(label=name); l.set_ellipsize(Pango.EllipsizeMode.END); l.set_max_width_chars(11); v.pack_start(l, False, False, 0)
        b.add(v); b.connect('clicked', lambda _b: sh(cmd)); return b

    # ---- window 1: audio bars ----
    def build_visualizer(self, x, y, w, h):
        g = Glass(radius=3, tint=(0.04, 0.04, 0.04, 0.70)); g.set_border_width(22)
        self.viz = Visualizer(); g.pack_start(self.viz, True, True, 0)
        self.put(g, x, y, w, h)
        self.add_events(Gdk.EventMask.VISIBILITY_NOTIFY_MASK)
        self.connect('visibility-notify-event', lambda wd, e: setattr(self.viz, 'obscured', e.state == Gdk.VisibilityState.FULLY_OBSCURED) or False)

    # ---- window 2: fetch card ----
    def fetch_lines(self):
        try: osn = [l.split('=', 1)[1].strip().strip('"') for l in open('/etc/os-release') if l.startswith('PRETTY_NAME=')][0]
        except Exception: osn = 'Linux'
        arch = out('dpkg --print-architecture', 2) or 'armhf'
        try:
            mi = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo') if ':' in l}
            ram = '%d MiB / %d MiB' % ((mi['MemTotal'] - mi['MemAvailable']) // 1024, mi['MemTotal'] // 1024)
        except Exception: ram = '?'
        if DEMO: osn, ram = 'Ubuntu 20.04.6 LTS', '1126 MiB / 1843 MiB'
        if not hasattr(self, '_pk'): self._pk = len(glob.glob('/var/lib/dpkg/info/*.list')) if not DEMO else 587
        return ['%s %s' % (osn.replace(' LTS', ''), arch), ram, '%d (dpkg)' % self._pk, 'xfce4-terminal', 'Rembly Shell', 'github.com/Tishir614/-Rembly-os']

    def build_fetch(self, x, y, w, h):
        g = Glass(radius=3, tint=(0.04, 0.04, 0.04, 0.72)); g.set_border_width(18)
        g.pack_start(SquareAvatar(118), False, False, 0)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2); col.set_margin_start(22); col.set_valign(Gtk.Align.CENTER)
        t = Gtk.Label(label='R E M B L Y | O S', xalign=0); t.get_style_context().add_class('ff-title'); col.pack_start(t, False, False, 0)
        sep = '-' * 24
        for text, cls in ((sep, 'ff-sep'),):
            l = Gtk.Label(label=text, xalign=0); l.get_style_context().add_class(cls); col.pack_start(l, False, False, 0)
        self.ff = []
        for line in self.fetch_lines():
            l = Gtk.Label(label=line, xalign=0); l.get_style_context().add_class('ff-line'); l.set_ellipsize(Pango.EllipsizeMode.END); col.pack_start(l, False, False, 0); self.ff.append(l)
        l = Gtk.Label(label=sep, xalign=0); l.get_style_context().add_class('ff-sep'); col.pack_start(l, False, False, 0)
        sw_ = Gtk.DrawingArea(); sw_.set_size_request(200, 14)
        cols = [(1, 1, 1), (.86, .86, .86), (.72, .72, .72), (.58, .58, .58), (.45, .45, .45), (.33, .33, .33), (.22, .22, .22), (.12, .12, .12)]
        def draw(wd, cr):
            for i, c in enumerate(cols): cr.set_source_rgb(*c); cr.rectangle(i * 24, 2, 20, 8); cr.fill()
        sw_.connect('draw', draw); col.pack_start(sw_, False, False, 2)
        g.pack_start(col, True, True, 0)
        self.put(g, x, y, w, h)

    def refresh_fetch(self):
        if getattr(self, 'ff', None):
            for l, t in zip(self.ff, self.fetch_lines()): l.set_text(t)
        return True

    # ---- window 3: apps ----
    def build_apps(self, x, y, w, h):
        g = Glass(radius=3, tint=(0.04, 0.04, 0.04, 0.78), orientation=Gtk.Orientation.VERTICAL); g.set_border_width(14)
        grid = Gtk.Grid(column_homogeneous=True, row_homogeneous=True, row_spacing=2, column_spacing=2)
        for i, (name, ic, cmd) in enumerate(avail_apps()[:12]): grid.attach(self.tile(name, ic, cmd, 46), i % 4, i // 4, 1, 1)
        g.pack_start(grid, True, True, 0)
        more = Gtk.Button(label='все приложения  >'); more.set_relief(Gtk.ReliefStyle.NONE); more.get_style_context().add_class('bar-btn'); more.connect('clicked', lambda _b: self.open_launcher(None))
        g.pack_end(more, False, False, 0)
        self.put(g, x, y, w, h)


class Launcher(Win):
    def __init__(self, w, h, wall, blur):
        super().__init__(wall, blur, (0, BAR), type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False); self.set_default_size(w, h); self.move(0, BAR); self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_skip_taskbar_hint(True); self.set_keep_above(True)
        outer = Glass(orientation=Gtk.Orientation.VERTICAL, spacing=8, radius=8, tint=(0.04, 0.04, 0.04, 0.84)); outer.set_border_width(16)
        self.add(outer)
        top = Gtk.Box(spacing=10); self.search = Gtk.Entry(); self.search.set_placeholder_text('Поиск приложений')
        self.search.get_style_context().add_class('rl-search'); self.search.connect('changed', lambda *_: self.fill())
        self.search.connect('focus-in-event', lambda *_: osk(True))
        close = Gtk.Button(label='✕'); close.set_relief(Gtk.ReliefStyle.NONE); close.connect('clicked', lambda _b: self.close_())
        top.pack_start(self.search, True, True, 0); top.pack_end(close, False, False, 0); outer.pack_start(top, False, False, 0)
        self.fb = Gtk.FlowBox(); self.fb.set_max_children_per_line(10); self.fb.set_selection_mode(Gtk.SelectionMode.NONE)
        self.fb.set_homogeneous(True)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sc.add(self.fb)
        outer.pack_start(sc, True, True, 0); self.cat = None
        self.apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()), key=lambda a: a.get_name().lower())

    def show_cat(self, cat):
        self.cat = cat; self.search.set_text(''); self.fill()
        self.fb.set_can_focus(True); self.set_focus(self.fb)           # focus the grid BEFORE mapping: a focused search box would pop the keyboard up
        self.show_all(); self.present()

    def close_(self):
        osk(False); self.hide()

    def fill(self):
        for c in self.fb.get_children(): self.fb.remove(c)
        q = self.search.get_text().lower()
        for a in self.apps:
            cats = (getattr(a, 'get_categories', lambda: '')() or '')
            if self.cat and self.cat not in cats: continue
            if q and q not in a.get_name().lower(): continue
            b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('tile')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            ic = a.get_icon(); n = ic.get_names()[0] if isinstance(ic, Gio.ThemedIcon) else 'application-x-executable'
            v.pack_start(appicon(n, 52), False, False, 0)
            l = Gtk.Label(label=a.get_name()); l.set_ellipsize(Pango.EllipsizeMode.END); l.set_max_width_chars(13); v.pack_start(l, False, False, 0)
            b.add(v); b.connect('clicked', lambda _b, app=a: (launch_gapp(app), self.close_()))
            self.fb.add(b)
        if not self.fb.get_children():
            self.fb.add(Gtk.Label(label='Ничего не найдено'))
        self.fb.show_all()


def power_dialog(parent):
    d = Gtk.Dialog(title='Выключение', transient_for=parent, modal=True); d.set_decorated(False); d.set_keep_above(True)
    d.set_position(Gtk.WindowPosition.CENTER_ALWAYS); ui.style_app(d)
    box = d.get_content_area(); box.set_border_width(26); box.set_spacing(14)
    t = Gtk.Label(label='Что сделать с планшетом?'); t.get_style_context().add_class('rcard-title'); box.pack_start(t, False, False, 6)
    for txt, rid, cls in (('⏻  Выключить', 1, 'btn-danger'), ('↻  Перезагрузить', 2, 'btn-main'), ('Отмена', 0, 'btn-neutral')):
        b = Gtk.Button(label=txt); b.get_style_context().add_class(cls); b.set_size_request(320, 60); b.connect('clicked', lambda _b, r=rid: d.response(r)); box.pack_start(b, False, False, 0)
    d.show_all(); r = d.run(); d.destroy()
    if r == 1: sh('sync; /bin/busybox poweroff -f')
    elif r == 2: sh('sync; /bin/busybox reboot -f')


def read(path, default=''):
    try: return open(path).read().strip()
    except Exception: return default


def audio_ctl():
    n = out("amixer scontrols 2>/dev/null | head -1 | sed -n \"s/.*'\\(.*\\)'.*/\\1/p\"", 2)
    return n or 'Master'


class QuickPanel(Win):
    inst = None

    @classmethod
    def toggle(cls, sw, sh_, wall, blur):
        if cls.inst is not None and cls.inst.get_visible():
            cls.inst.hide(); return
        if cls.inst is None: cls.inst = cls(sw, sh_, wall, blur)
        cls.inst.refresh(); cls.inst.show_all(); cls.inst.present()

    def __init__(self, sw, sh_, wall, blur):
        w, h = 372, 690
        super().__init__(wall, blur, (sw - w - 10, BAR + 4), type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False); self.set_default_size(w, h); self.move(sw - w - 10, BAR + 4)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG); self.set_skip_taskbar_hint(True); self.set_keep_above(True)
        self.connect('focus-out-event', lambda *_: (self.hide(), False)[1])
        box = Glass(orientation=Gtk.Orientation.VERTICAL, spacing=8, radius=8, tint=(0.04, 0.04, 0.04, 0.86)); box.set_border_width(16)
        self.add(box)
        t = Gtk.Label(label='Быстрые настройки', xalign=0); t.get_style_context().add_class('rl-title'); box.pack_start(t, False, False, 4)
        self.bl = backlight_path(); self.ac = audio_ctl()
        self.s_br = self.slider(box, ['display-brightness', 'weather-clear'], 5, 255, self.set_brightness)
        self.s_vol = self.slider(box, ['audio-volume-high', 'audio-speakers'], 0, 100, self.set_volume)
        grid = Gtk.Grid(column_homogeneous=True, row_homogeneous=True, row_spacing=4, column_spacing=4); box.pack_start(grid, True, True, 6)
        self.tg = {}
        items = [('Wi-Fi', ['network-wireless', 'network-wireless-signal-excellent'], lambda: sh('rembley-netui')),
                 ('Bluetooth', ['bluetooth'], lambda: sh('rembley-netui bt')),
                 ('SIM', ['network-cellular-signal-excellent', 'phone'], lambda: sh('rembley-netui modem')),
                 ('Клавиатура', ['input-keyboard'], lambda: sh('dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard org.onboard.Onboard.Keyboard.ToggleVisible')),
                 ('Скриншот', ['applets-screenshooter', 'camera-photo', 'image-x-generic'], self.screenshot),
                 ('Не беспокоить', ['notification-disabled', 'preferences-system-notifications'], lambda: sh('rembley-dnd')),
                 ('Экономия', ['battery-good', 'battery'], lambda: sh('rembley-eco toggle')),
                 ('Поворот', ['object-rotate-right', 'view-refresh'], self.rotate),
                 ('Блокировка', ['system-lock-screen', 'lock'], lambda: (self.hide(), sh('rembley-lock'))),
                 ('Настройки', ['preferences-system'], lambda: (self.hide(), sh('rembley-settings'))),
                 ('Профиль', ['battery-level-60-symbolic', 'battery-good', 'preferences-system-power'], lambda: sh('rembley-profile next')),
                 ('Хранилище', ['drive-harddisk', 'drive-harddisk-symbolic', 'disk-usage-analyzer'], lambda: (self.hide(), sh('rembley-storage'))),
                 ('Диспетчер', ['utilities-system-monitor', 'org.xfce.taskmanager'], lambda: (self.hide(), sh('rembley-taskman'))),
                 ('Обновление', ['system-software-update', 'software-update-available', 'view-refresh'], lambda: (self.hide(), sh('rembley-updater'))),
                 ('Оптимизация', ['utilities-system-monitor', 'preferences-system-performance'], lambda: (self.hide(), sh('xfce4-terminal --hold --title=Оптимизация -e "rembley-optimize"'))),
                 ('Язык EN/RU', ['preferences-desktop-locale', 'input-keyboard'], lambda: sh('xdotool key ISO_Next_Group')),
                 ('Отчёт', ['dialog-information', 'help-about'], lambda: (self.hide(), sh('xfce4-terminal -e "rembley-report"'))),
                 ('Выключение', ['system-shutdown'], lambda: (self.hide(), power_dialog(None)))]
        for i, (name, ic, fn) in enumerate(items):
            b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('tile')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2); v.pack_start(icon(ic, 32), False, False, 0)
            l = Gtk.Label(label=name); l.set_ellipsize(Pango.EllipsizeMode.END); l.set_max_width_chars(12); v.pack_start(l, False, False, 0)
            b.add(v); b.connect('clicked', lambda _b, f=fn: f()); grid.attach(b, i % 3, i // 3, 1, 1)

    def slider(self, box, ic, lo, hi, cb):
        r = Gtk.Box(spacing=10); r.pack_start(icon(ic, 26), False, False, 0)
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1); sc.set_draw_value(False); sc.set_size_request(-1, 44)
        sc.connect('value-changed', lambda w: cb(int(w.get_value()))); r.pack_start(sc, True, True, 0); box.pack_start(r, False, False, 0); return sc

    def refresh(self):
        if self.bl: self.s_br.set_value(int(read(self.bl, '128') or 128))
        m = out("amixer sget '%s' 2>/dev/null | grep -o '[0-9]*%%' | head -1" % self.ac, 2)
        self.s_vol.set_value(int(m.strip('%')) if m else 70)

    def set_brightness(self, v):
        if self.bl: write_sys(self.bl, v)

    def set_volume(self, v):
        if getattr(self, '_vt', None): GLib.source_remove(self._vt)
        self._vt = GLib.timeout_add(150, lambda: (sh("amixer -q sset '%s' %d%% unmute" % (self.ac, v)), setattr(self, '_vt', None), False)[2])

    def screenshot(self):
        self.hide()
        GLib.timeout_add(400, lambda: (sh('mkdir -p ~/Pictures; f=~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png; scrot "$f" && notify-send "Скриншот сохранён" "$f"'), False)[1])

    def rotate(self):
        order = ['CW', 'none', 'CCW', 'UD']; cur = 'CW'
        for l in read('/etc/rembley/display.conf').splitlines():
            if l.startswith('ROTATE='): cur = l.split('=', 1)[1]
        nxt = order[(order.index(cur) + 1) % 4] if cur in order else 'CW'
        sh('rembley-rotate %s' % nxt.lower())


class Switcher(Win):
    """Task switcher: one card per open window."""
    inst = None

    @classmethod
    def toggle(cls, sw, h, wall, blur):
        if cls.inst is not None and cls.inst.get_visible():
            cls.inst.hide(); return
        if cls.inst is None: cls.inst = cls(sw, h, wall, blur)
        cls.inst.fill(); cls.inst.show_all(); cls.inst.present()

    def __init__(self, w, h, wall, blur):
        super().__init__(wall, blur, (0, BAR), type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False); self.set_default_size(w, h); self.move(0, BAR); self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_skip_taskbar_hint(True); self.set_keep_above(True)
        outer = Glass(orientation=Gtk.Orientation.VERTICAL, spacing=8, radius=8, tint=(0.04, 0.04, 0.04, 0.88)); outer.set_border_width(16)
        self.add(outer)
        top = Gtk.Box(); t = Gtk.Label(label='Открытые окна', xalign=0); t.get_style_context().add_class('rl-title')
        close = Gtk.Button(label='✕'); close.set_relief(Gtk.ReliefStyle.NONE); close.connect('clicked', lambda _b: self.hide())
        top.pack_start(t, True, True, 0); top.pack_end(close, False, False, 0); outer.pack_start(top, False, False, 0)
        self.fb = Gtk.FlowBox(); self.fb.set_selection_mode(Gtk.SelectionMode.NONE); self.fb.set_max_children_per_line(4); self.fb.set_homogeneous(True)
        sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC); sc.add(self.fb); outer.pack_start(sc, True, True, 0)

    def fill(self):
        for c in self.fb.get_children(): self.fb.remove(c)
        n = 0
        for line in out('wmctrl -l -x', 2).splitlines():
            p = line.split(None, 4)
            if len(p) < 5 or p[1] == '-1' or p[2].lower().startswith(('rembley-shell', 'xfce4-panel', 'onboard', 'desktop')) or not p[4].strip(): continue
            wid, cls, title = p[0], p[2].split('.')[0].lower(), p[4]
            cls = {'rembley-store': 'softwarecenter', 'rembley-settings': 'preferences-system', 'rembley-netui': 'network-wireless', 'rembley-touchtest': 'input-tablet', 'rembley-lock': 'system-lock-screen', 'xfce4-terminal': 'utilities-terminal', 'thunar': 'system-file-manager'}.get(cls, cls)
            n += 1
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); card.set_border_width(8)
            b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('tile')
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6); v.pack_start(appicon([cls, cls.replace('xfce4-', ''), 'application-x-executable'], 72), False, False, 0)
            l = Gtk.Label(label=title); l.set_ellipsize(Pango.EllipsizeMode.END); l.set_max_width_chars(22); v.pack_start(l, False, False, 0)
            b.add(v); b.connect('clicked', lambda _b, i=wid: (sh('wmctrl -ia %s' % i), self.hide()))
            x = Gtk.Button(label='Закрыть'); x.set_relief(Gtk.ReliefStyle.NONE); x.connect('clicked', lambda _b, i=wid: (sh('wmctrl -ic %s' % i), GLib.timeout_add(500, lambda: (self.fill(), self.show_all(), False)[2])))
            card.pack_start(b, True, True, 0); card.pack_start(x, False, False, 0); self.fb.add(card)
        if n == 0: self.fb.add(Gtk.Label(label='Нет открытых окон'))
        self.fb.show_all()


class Bar(Win):
    """Top bar in the style of the reference: pills with a thin pink frame - launcher + workspace dots, media, track, CPU, RAM, tray, network, volume, clock."""
    PH = 30

    def __init__(self, sw, sh_, wall, blur):
        super().__init__(wall, blur, (0, 0), type=Gtk.WindowType.TOPLEVEL)
        self.sw, self.sh = sw, sh_
        self.set_type_hint(Gdk.WindowTypeHint.DOCK); self.set_decorated(False)
        self.set_default_size(sw, BAR); self.move(0, 0); self.set_keep_above(True)
        self.fixed = Gtk.Fixed(); self.add(self.fixed); self.pills = []
        self.net_txt, self.vol_txt, self.track_txt = 'wlan0: нет сети', '--%', 'Rembley OS'
        x = 8
        x = self.build_left(x); x = self.build_media(x); self.build_title(x)
        self.build_right()
        self.connect('realize', self.on_realize)
        self._cpu = None
        GLib.timeout_add_seconds(1, self.cur_ws); GLib.timeout_add_seconds(3, self.stats); GLib.timeout_add_seconds(5, self.status); GLib.timeout_add(700, self.lang_tick)
        self.status(); self.cur_ws(); self.stats()

    def pill(self, x, w):
        g = Glass(radius=5, spacing=2, tint=(0.04, 0.04, 0.04, 0.90)); g.set_border_width(2)
        g.set_size_request(w, self.PH); self.fixed.put(g, x, 5); self.pills.append((x, 5, w, self.PH)); return g

    def btn(self, child, cb, cls='bar-btn'):
        b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class(cls)
        b.add(child if not isinstance(child, str) else Gtk.Label(label=child)); b.connect('clicked', lambda _b: cb()); return b

    def label(self, text=''):
        l = Gtk.Label(label=text); l.get_style_context().add_class('bar-lbl'); return l

    def build_left(self, x):
        p = self.pill(x, 150)
        try: logo = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(SHARE + '/logo-mark-small.png', 22, 22))
        except Exception: logo = Gtk.Label(label='R')
        p.pack_start(self.btn(logo, lambda: ctl_cmd('launcher')), False, False, 0)
        self.wsb = []
        for i in range(4):
            b = self.btn('•', lambda n=i: sh('wmctrl -s %d' % n), 'wsdot'); p.pack_start(b, False, False, 0); self.wsb.append(b)
        return x + 150 + 6

    def build_media(self, x):
        p = self.pill(x, 116)
        for ic, cmd in (('media-skip-backward', 'previous'), ('media-playback-start', 'play-pause'), ('media-skip-forward', 'next')):
            p.pack_start(self.btn(icon(ic, 16), lambda c=cmd: sh('playerctl ' + c)), False, False, 0)
        return x + 116 + 6

    def build_title(self, x):
        p = self.pill(x, 270); self.title = self.label(self.track_txt); self.title.set_ellipsize(Pango.EllipsizeMode.END); self.title.set_max_width_chars(32)
        p.pack_start(self.title, True, True, 6)

    def build_right(self):
        widths = [('cpu', 78), ('ram', 78), ('tray', 214), ('net', 176), ('vol', 76), ('clock', 64)]
        total = sum(w for _, w in widths) + 6 * (len(widths) - 1); x = self.sw - 8 - total
        for name, w in widths:
            p = self.pill(x, w); x += w + 6
            if name == 'cpu': self.cpu_l = self.label('CPU --%'); p.pack_start(self.cpu_l, True, True, 6)
            elif name == 'ram': self.ram_l = self.label('RAM --%'); p.pack_start(self.ram_l, True, True, 6)
            elif name == 'tray':
                self.wifi, self.bt, self.sim = Gtk.Button(), Gtk.Button(), Gtk.Button()
                for b, cmd in ((self.bt, 'rembley-netui bt'), (self.sim, 'rembley-netui modem')):
                    b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('bar-btn'); b.connect('clicked', lambda _b, c=cmd: sh(c)); p.pack_start(b, False, False, 0)
                self.lang = self.btn('EN', self.switch_lang); p.pack_start(self.lang, False, False, 0)
                self.bat = self.label('--%'); p.pack_end(self.btn(self.bat, lambda: QuickPanel.toggle(self.sw, self.sh, self.wall, self.blur)), False, False, 0)
            elif name == 'net': self.net_l = self.label(self.net_txt); self.net_l.set_ellipsize(Pango.EllipsizeMode.END); p.pack_start(self.btn(self.net_l, lambda: sh('rembley-netui')), True, True, 0)
            elif name == 'vol': self.vol_l = self.label('♪ --%'); p.pack_start(self.btn(self.vol_l, lambda: QuickPanel.toggle(self.sw, self.sh, self.wall, self.blur)), True, True, 0)
            elif name == 'clock': self.tc = self.label('--:--'); p.pack_start(self.btn(self.tc, lambda: QuickPanel.toggle(self.sw, self.sh, self.wall, self.blur)), True, True, 0)

    # ---- live values ----
    def stats(self):
        try:
            a = [int(v) for v in open('/proc/stat').readline().split()[1:8]]; idle, tot = a[3] + a[4], sum(a)
            cpu = (1 - (idle - self._cpu[1]) / max(1, tot - self._cpu[0])) if self._cpu else 0; self._cpu = (tot, idle)
            mi = {l.split(':')[0]: int(l.split()[1]) for l in open('/proc/meminfo') if ':' in l}; ram = 1 - mi['MemAvailable'] / mi['MemTotal']
            if DEMO: cpu, ram = .20, .31
            self.cpu_l.set_text('CPU %d%%' % round(cpu * 100)); self.ram_l.set_text('RAM %d%%' % round(ram * 100))
        except Exception: pass
        t = time.localtime(); self.tc.set_text('20:44' if DEMO else time.strftime('%H:%M', t))
        return True

    def lang_tick(self):
        x = xconn(); g = x.kbd_group() if x else None
        if g is not None: self.lang.get_child().set_text(('EN', 'RU', 'L3', 'L4')[min(g, 3)])
        return True

    def switch_lang(self):
        """One tap: next keyboard layout (English <-> Russian); the on-screen keyboard follows the system layout."""
        x = xconn(); g = x.kbd_group() if x else None
        if g is not None and x.kbd_lock(1 - g if g < 2 else 0): self.lang_tick()
        else: sh('xdotool key ISO_Next_Group')

    def status(self):
        def work():
            wl, ssid = '', ''
            try:
                wl = open('/sys/class/net/wlan0/operstate').read().strip()
                if wl == 'up':                                    # up but not associated -> link quality 0 in /proc/net/wireless
                    q = [l.split() for l in open('/proc/net/wireless').read().splitlines()[2:] if l.strip().startswith('wlan0')]
                    if not q or float(q[0][2].rstrip('.')) <= 0: wl = 'down'
                    else: ssid = out("wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^ssid=//p'", 2)
            except Exception: pass
            btm = 'on' if os.path.exists('/sys/class/bluetooth/hci0') else 'off'
            sim = 'on' if os.path.exists('/sys/class/net/ppp0') else 'off'
            cap, chg = None, ''
            for d in glob.glob('/sys/class/power_supply/*'):
                try:
                    if open(d + '/type').read().strip() == 'Battery': cap = open(d + '/capacity').read().strip(); chg = open(d + '/status').read().strip()
                except Exception: pass
            m = out("amixer sget '%s' 2>/dev/null | grep -o '[0-9]*%%' | head -1" % audio_ctl(), 2) if not DEMO else '50%'
            tr = out('playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null', 2) if not DEMO else '3AM - Luna'
            GLib.idle_add(self.set_status, wl, btm, sim, cap, chg, ssid, m, tr)
        threading.Thread(target=work, daemon=True).start(); return True

    def set_status(self, wl, btm, sim, cap, chg, ssid, vol, track):
        def setb(b, names):
            for c in b.get_children(): b.remove(c)
            b.add(icon(names, 18)); b.show_all()
        setb(self.bt, ['bluetooth-active' if btm == 'on' or DEMO else 'bluetooth-disabled', 'bluetooth'])
        setb(self.sim, ['network-cellular-signal-excellent' if sim == 'on' else 'network-cellular-offline', 'phone'])
        self.bat.set_text('85%' if DEMO else (('%s%%%s' % (cap, '+' if chg == 'Charging' else '')) if cap else 'AC'))
        self.net_l.set_text('wlan0: Aesthetic' if DEMO else ('wlan0: %s' % ssid if ssid else ('wlan0: нет сети' if wl != 'up' else 'wlan0: ...')))
        self.vol_l.set_text('♪ %s' % (vol or '--%'))
        self.title.set_text(track if track and track.strip(' -') else 'Rembley OS')

    def cur_ws(self):
        x = xconn(); cur = str(x.current_desktop()) if x else out("wmctrl -d | awk '$2==\"*\"{print $1}'", 1)
        if cur == getattr(self, '_ws_cur', None): return True
        self._ws_cur = cur
        for i, b in enumerate(self.wsb):
            on = (i == 2) if DEMO else cur == str(i); ctx = b.get_style_context()
            (ctx.add_class if on else ctx.remove_class)('cur'); b.get_child().set_text('◉' if on else '•')
        return True

    def on_realize(self, *_):
        rects = []
        for x, y, w, h in self.pills:                         # click-through everywhere but the pills (shape = union of small-radius rectangles)
            r = 5
            for yy in range(h):
                e = r - yy - .5 if yy < r else (yy - (h - r) + .5 if yy >= h - r else None)
                d = 0 if e is None else r - math.sqrt(max(0, r * r - e * e))
                rects.append((int(x + d), y + yy, max(1, int(w - 2 * d)), 1))
        shape_window(self.get_window(), rects)
        gw = self.get_window()
        if GdkX11 is not None:
            try:                                              # reserve the strip on TOP so maximised windows start below the bar
                sh('xprop -id %d -f _NET_WM_STRUT_PARTIAL 32c -set _NET_WM_STRUT_PARTIAL "0,0,%d,0,0,0,0,0,0,%d,0,0"' % (gw.get_xid(), BAR, self.sw - 1))
                sh('xprop -id %d -f _NET_WM_STRUT 32c -set _NET_WM_STRUT "0,0,%d,0"' % (gw.get_xid(), BAR))
            except Exception: pass


def shape_window(gw, rects):
    import ctypes
    cl, gl = ctypes.CDLL('libcairo.so.2'), ctypes.CDLL('libgdk-3.so.0')
    class RI(ctypes.Structure):
        _fields_ = [('x', ctypes.c_int), ('y', ctypes.c_int), ('w', ctypes.c_int), ('h', ctypes.c_int)]
    arr = (RI * len(rects))(*[RI(*r) for r in rects])
    cl.cairo_region_create_rectangles.restype = ctypes.c_void_p
    reg = cl.cairo_region_create_rectangles(arr, len(rects))
    pg = ctypes.pythonapi.PyCapsule_GetPointer; pg.restype = ctypes.c_void_p; pg.argtypes = [ctypes.py_object, ctypes.c_char_p]
    ptr = pg(gw.__gpointer__, None)
    for fn in (gl.gdk_window_shape_combine_region, gl.gdk_window_input_shape_combine_region):
        fn.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int]; fn(ptr, reg, 0, 0)
    cl.cairo_region_destroy.argtypes = [ctypes.c_void_p]; cl.cairo_region_destroy(reg)


def automax_start():
    """Maximize every new normal window (finger-friendly: no tiny windows to drag/resize).
    Watches _NET_CLIENT_LIST in-process; spawns wmctrl/xprop only for a window that just appeared."""
    seen = set()

    def check():
        x = xconn()
        if x is None: return True
        ids = set(x.clients())
        for wid in ids - seen:
            types = x.window_types(wid)
            if '_NET_WM_WINDOW_TYPE_NORMAL' in types or not types:
                cls = out('xprop -id %d WM_CLASS' % wid, 2).lower()
                if not any(k in cls for k in ('rembley-shell', 'onboard', 'dunst', 'xfce4-notifyd')):
                    sh('wmctrl -i -r 0x%x -b add,maximized_vert,maximized_horz' % wid)
        seen.clear(); seen.update(ids)
        return True
    GLib.timeout_add(1500, check)


def round_rects(w, h, r):
    rects = []
    for yy in range(h):
        e = r - yy - .5 if yy < r else (yy - (h - r) + .5 if yy >= h - r else None)
        d = 0 if e is None else r - math.sqrt(max(0, r * r - e * e))
        rects.append((int(d), yy, max(1, int(w - 2 * d)), 1))
    return rects


class Fab(Gtk.Window):
    """Floating keyboard button above the tray: apps without accessibility (terminal) never auto-show the keyboard."""
    def __init__(self, sw, sh_):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        S = 56
        self.set_type_hint(Gdk.WindowTypeHint.DOCK); self.set_decorated(False); self.set_keep_above(True); self.set_resizable(False)
        self.set_default_size(S, S); self.move(sw - S - 14, sh_ - S - 14); self.get_style_context().add_class('rl-win')
        b = Gtk.Button(); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('fab'); b.set_size_request(S, S)
        b.add(appicon(['input-keyboard', 'keyboard'], S))
        b.connect('clicked', lambda _b: ctl_cmd('keyboard')); self.add(b)
        self.connect('realize', lambda *_: shape_window(self.get_window(), round_rects(S, S, 15)))


def ctl_cmd(cmd, ctx=None):
    """Commands from rembley-touchd (edge swipes) or `echo cmd > /run/rembley/ctl`."""
    c = ctx or ctl_cmd.ctx
    if cmd == 'quick': QuickPanel.toggle(c['sw'], c['sh'], c['wall'], c['blur'])
    elif cmd == 'launcher': c['home'].open_launcher(None)
    elif cmd == 'switcher': Switcher.toggle(c['sw'], c['sh'] - BAR, c['wall'], c['blur'])
    elif cmd == 'power': power_dialog(None)
    elif cmd == 'home': sh('wmctrl -k on')
    elif cmd == 'keyboard': sh('dbus-send --type=method_call --dest=org.onboard.Onboard /org/onboard/Onboard/Keyboard org.onboard.Onboard.Keyboard.ToggleVisible')


def ctl_listen():
    path = '/run/rembley/ctl'
    try:
        os.makedirs('/run/rembley', exist_ok=True)
        if os.path.exists(path): os.remove(path)
        os.mkfifo(path, 0o660)
        rfd = os.open(path, os.O_RDONLY | os.O_NONBLOCK); ctl_listen.wfd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)   # 2nd end keeps the FIFO from hitting EOF
    except OSError:
        return
    def cb(fd, cond):
        for line in os.read(fd, 4096).decode('utf8', 'replace').split():
            try: ctl_cmd(line)
            except Exception as e: print('ctl error', line, e, file=sys.stderr)
        return True
    GLib.io_add_watch(rfd, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN, cb)


def main():
    ui.init_theme()
    sw, sh_ = screen_size()
    wall, blur = load_wallpaper(sw, sh_)
    home = Home(sw, sh_, wall, blur); bar = Bar(sw, sh_, wall, blur)
    home.show_all(); bar.show_all()
    fab = Fab(sw, sh_); fab.show_all()
    ctl_cmd.ctx = {'sw': sw, 'sh': sh_, 'wall': wall, 'blur': blur, 'home': home}; ctl_listen()
    home.get_window().lower()
    # control signals (used by rembley-power for the hardware power key)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda: (power_dialog(None), True)[1])
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, lambda: (QuickPanel.toggle(sw, sh_, wall, blur), True)[1])
    if not DEMO: automax_start()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, lambda: os.execv(sys.executable, [sys.executable] + sys.argv))
    if not os.path.exists(CFG + '/first-run-done') and not DEMO:
        sh('rembley-settings --welcome')
    Gtk.main()


if __name__ == '__main__':
    main()
