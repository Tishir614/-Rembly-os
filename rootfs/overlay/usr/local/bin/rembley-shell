#!/usr/bin/env python3
"""Rembley Shell: touch-first desktop for the A73 tablet (GTK3, no compositor needed).

Glass look = a blurred copy of the wallpaper painted behind each panel (done once, so it costs
nothing while running). Windows: home (desktop layer), bar (dock + workspaces + tray, with strut),
launcher (all apps), quick settings, task switcher."""
import glob, json, math, os, random, shutil, signal, subprocess, sys, threading, time, urllib.request
sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
import rembleyui as ui
from rembleyui import *
try:
    import rembleyx
except Exception:
    rembleyx = None
_X = None


def xconn():
    """One in-process X connection for the main thread (property reads cost ~0.05 ms; no subprocess polling)."""
    global _X
    if _X is None and rembleyx is not None:
        try: _X = rembleyx.XConn()
        except Exception: _X = False
    return _X or None


