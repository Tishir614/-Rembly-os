#!/bin/sh
# Battery saver: powersave governor + shorter screen timeouts (read by rembly-power). usage: rembly-eco on|off|toggle|status
# The governor is chosen from what THIS kernel offers (scaling_available_governors); a missing one is skipped, never forced.
mkdir -p /run/rembly
avail() { cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null; }
pick() { for g in "$@"; do case " $(avail) " in *" $g "*) echo "$g"; return;; esac; done; }   # first preferred governor that exists
set_gov() { [ -n "$1" ] || return 0; for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "$1" > "$g" 2>/dev/null; done; }
case "$1" in
  on)  touch /run/rembly/eco; set_gov "$(pick powersave conservative)"; notify-send "Экономия включена" 2>/dev/null ;;
  off) rm -f /run/rembly/eco; set_gov "$(pick interactive schedutil ondemand)"; notify-send "Экономия выключена" 2>/dev/null ;;
  perf) rm -f /run/rembly/eco; set_gov "$(pick performance interactive schedutil ondemand)" ;;
  toggle) if [ -e /run/rembly/eco ]; then "$0" off; else "$0" on; fi ;;
  *) [ -e /run/rembly/eco ] && echo on || echo off ;;
esac
