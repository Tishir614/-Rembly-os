#!/usr/bin/env python3
"""Rembly Code - a light code editor in the spirit of VS Code, built for this tablet (GTK + GtkSourceView + VTE, no Electron):
file explorer, tabs, syntax highlighting, find/replace, quick-open palette, integrated terminal, Run (F5), git branch, session restore.
It starts in a second and stays smooth on 2 GB RAM: highlighting is switched off for big files, undo history is bounded, nothing runs in the background.
usage: rembly-code [FILE | FOLDER ...]"""
import json, os, subprocess, sys, threading
sys.path[:0] = ['/usr/local/lib/rembly', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembly')]
import gi
gi.require_version('Gtk', '3.0'); gi.require_version('GtkSource', '4')
from gi.repository import Gtk, Gdk, GLib, GtkSource, Pango
import remblyui as ui
import rembly_term as rt
try:
    import rembly_aiui as aiui                                  # AI chat / edit / project wizard; the editor works without it
except Exception:
    aiui = None

CFGF = os.path.join(ui.CFG, 'code.json')
CSS = b"""
.rcode notebook > header { background-color: #0b0b0b; border-bottom: 1px solid rgba(255,255,255,0.25); }
.rcode notebook > header > tabs > tab { padding: 2px 6px 2px 12px; min-height: 40px; border-radius: 0; border-right: 1px solid rgba(255,255,255,0.12); background-color: #0b0b0b; }
.rcode notebook > header > tabs > tab:checked { background-image: none; background-color: #1c1c1c; box-shadow: inset 0 -2px 0 #ffffff; }
.rcode button.tabx { min-height: 30px; min-width: 30px; padding: 0; border-radius: 4px; background-image: none; background-color: transparent; border: none; box-shadow: none; }
.rcode button.tabx:hover { background-color: rgba(255,255,255,0.18); }
.rcode treeview.view { font-family: 'Fira Code', monospace; font-size: 13px; }
.rcode paned > separator { background-color: rgba(255,255,255,0.22); min-width: 2px; min-height: 2px; }
.rcode .code-status { background-color: #0b0b0b; border-top: 1px solid rgba(255,255,255,0.25); padding: 4px 10px; font-family: 'Fira Code', monospace; font-size: 12px; }
"""
IGNORE = {'.git', 'node_modules', '__pycache__', '.cache', '.venv', 'venv', '.idea', '.mypy_cache', 'target', 'build', 'dist'}
BIG = 1_500_000            # bytes: above this, no syntax highlighting (keeps the UI smooth)
RUN = {'.py': 'python3 "{f}"', '.js': 'node "{f}"', '.sh': 'bash "{f}"', '.c': 'gcc -O1 -o /tmp/rembly-a.out "{f}" && /tmp/rembly-a.out',
       '.cpp': 'g++ -O1 -o /tmp/rembly-a.out "{f}" && /tmp/rembly-a.out', '.cc': 'g++ -O1 -o /tmp/rembly-a.out "{f}" && /tmp/rembly-a.out',
       '.html': 'xdg-open "{f}"', '.php': 'php "{f}"', '.rb': 'ruby "{f}"', '.pl': 'perl "{f}"', '.lua': 'lua "{f}"', '.go': 'go run "{f}"'}


def load_cfg():
    try: return json.load(open(CFGF))
    except Exception: return {}


def save_cfg(c):
    try: os.makedirs(ui.CFG, exist_ok=True); json.dump(c, open(CFGF, 'w'))
    except OSError: pass


class Doc:
    def __init__(self, path, text, win):
        self.path, self.win = path, win
        self.buf = GtkSource.Buffer(); self.buf.set_max_undo_levels(200)
        lm = GtkSource.LanguageManager.get_default()
        lang = lm.guess_language(path, None) if path else None
        if lang is not None and lang.get_id() == 'python' and lm.get_language('python3') is not None: lang = lm.get_language('python3')
        big = len(text.encode('utf8', 'ignore')) > BIG
        if big: self.buf.set_highlight_syntax(False); self.buf.set_max_undo_levels(20)
        elif lang is not None: self.buf.set_language(lang)
        self.buf.set_highlight_matching_brackets(not big)
        self.buf.begin_not_undoable_action(); self.buf.set_text(text); self.buf.end_not_undoable_action(); self.buf.set_modified(False)
        self.buf.place_cursor(self.buf.get_start_iter())
        self.view = GtkSource.View.new_with_buffer(self.buf)
        v = self.view
        v.set_show_line_numbers(True); v.set_highlight_current_line(not big); v.set_auto_indent(True); v.set_indent_on_tab(True)
        v.set_insert_spaces_instead_of_tabs(path is None or not path.endswith(('Makefile', '.go')))
        v.set_tab_width(4); v.set_smart_home_end(GtkSource.SmartHomeEndType.BEFORE); v.set_show_right_margin(True); v.set_right_margin_position(100)
        v.set_wrap_mode(Gtk.WrapMode.WORD_CHAR if win.wrap else Gtk.WrapMode.NONE); v.set_monospace(True)
        v.set_left_margin(6); v.set_top_margin(4); v.set_bottom_margin(120)
        v.set_indent_width(4)
        try: v.set_background_pattern(GtkSource.BackgroundPatternType.NONE)
        except Exception: pass
        self.big = big; self.lang = lang.get_name() if lang else 'Текст'
        self.scroll = Gtk.ScrolledWindow(); self.scroll.add(v)
        self.buf.connect('modified-changed', lambda *_: win.refresh_tab(self)); self.buf.connect('notify::cursor-position', lambda *_: win.update_status(self))
        v.connect('focus-out-event', lambda *_: win.autosave(self) and False)
        win.apply_font(v)

    @property
    def name(self): return os.path.basename(self.path) if self.path else 'без имени'

    def text(self):
        return self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), True)

    def save(self, path=None):
        path = path or self.path
        if not path: return False
        with open(path, 'w', encoding='utf8', newline='') as f: f.write(self.text())
        self.path = path; self.buf.set_modified(False); return True


class Code(Gtk.Window):
    def __init__(self, args):
        super().__init__(title='Rembly Code'); ui.init_theme(); ui.style_app(self); self.get_style_context().add_class('rcode')
        p = Gtk.CssProvider(); p.load_from_data(CSS); Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        sw, sh_ = ui.screen_size(); self.narrow = sw < 1000                 # portrait mode / small panel: no button labels, explorer hidden until asked for
        self.set_default_size(min(1180, sw), (sh_ - 70) if self.narrow else min(720, sh_ - 60)); self.set_position(Gtk.WindowPosition.CENTER)
        if sw <= 1100: self.maximize()
        c = load_cfg(); self.cfg = c
        self.folder = c.get('folder') or os.path.expanduser('~/Projects'); self.font = int(c.get('font', 12)); self.wrap = bool(c.get('wrap', False))
        self.scheme = c.get('scheme', 'rembly-matrix' if ui.HACKER else 'rembly'); self.autosave_on = bool(c.get('autosave', False)); self.docs = []
        sm = GtkSource.StyleSchemeManager.get_default(); sm.append_search_path(os.path.join(ui.SHARE, 'gtksource', 'styles'))
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); self.add(root)
        root.pack_start(self.build_toolbar(), False, False, 0)
        self.search_bar = self.build_search(); root.pack_start(self.search_bar, False, False, 0)
        self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL); root.pack_start(self.paned, True, True, 0)
        self.paned.pack1(self.build_explorer(), False, False)
        self.side = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL); self.paned.pack2(self.side, True, False)                       # editor+terminal | AI chat (landscape)
        self.vpaned = Gtk.Paned(orientation=Gtk.Orientation.VERTICAL); self.side.pack1(self.vpaned, True, False)
        self.nb = Gtk.Notebook(); self.nb.set_scrollable(True); self.nb.set_show_border(False); self.nb.connect('switch-page', lambda nb, w, n: GLib.idle_add(self.update_status, self.doc_at(n)))
        self.vpaned.pack1(self.nb, True, False)
        self.bottom = Gtk.Notebook(); self.bottom.set_show_border(False); self.vpaned.pack2(self.bottom, False, False)               # bottom panel: terminal (+ AI chat on a narrow screen)
        self.term_box = self.build_terminal(); self.bottom.append_page(self.term_box, Gtk.Label(label='Терминал'))
        self.ai_panel = aiui.ChatPanel(self) if aiui else None
        if self.ai_panel is not None:
            if self.narrow: self.bottom.append_page(self.ai_panel, Gtk.Label(label='ИИ'))
            else: self.ai_panel.set_size_request(430, -1); self.side.pack2(self.ai_panel, False, False)
        self.status = Gtk.Label(xalign=0); self.status.get_style_context().add_class('code-status'); self.status.set_ellipsize(Pango.EllipsizeMode.START)
        root.pack_start(self.status, False, False, 0)
        self.paned.set_position(250); self.set_folder(self.folder)
        self.connect('delete-event', self.on_close); self.connect('key-press-event', self.on_key)
        opened = 0
        for a in args:
            p = os.path.abspath(a)
            if os.path.isdir(p): self.set_folder(p)
            elif os.path.isfile(p): self.open_file(p); opened += 1
        if not opened:
            for p in c.get('files', []):
                if os.path.isfile(p): self.open_file(p)
        if not self.docs: self.new_doc()
        self.show_all(); self.bottom.hide(); self.search_bar.set_search_mode(False)
        if self.ai_panel is not None and not self.narrow: self.ai_panel.hide()
        if self.narrow: self.explorer.hide()
        GLib.timeout_add_seconds(10, self.git_tick); self.git_tick(); self.update_status(self.current())
        GLib.timeout_add_seconds(60, lambda: (self.autosave_all(), True)[1])

    # ---------------- chrome ----------------
    def tb(self, ic, tip, cb, label=None):
        b = Gtk.Button(); b.set_tooltip_text(tip); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('bar-btn')
        box = Gtk.Box(spacing=6); box.pack_start(ui.icon(ic, 22), False, False, 0)
        if label: box.pack_start(Gtk.Label(label=label), False, False, 0)
        b.add(box); b.connect('clicked', lambda _b: cb()); b.set_size_request(-1, 46); return b

    def build_toolbar(self):
        bar = Gtk.Box(spacing=2); bar.set_margin_start(6); bar.set_margin_end(6); bar.set_margin_top(4); bar.set_margin_bottom(4)
        L = (lambda t: None if self.narrow else t)
        items = [(['view-list-tree', 'sidebar'], 'Проводник (Ctrl+B)', self.toggle_explorer, None), (['folder-open', 'document-open'], 'Открыть папку', self.pick_folder, L('Папка')), (['document-new'], 'Новый файл', self.new_doc, None),
                 (['document-save'], 'Сохранить (Ctrl+S)', self.save_current, None), (['edit-undo'], 'Отменить', lambda: self.act('undo'), None), (['edit-redo'], 'Вернуть', lambda: self.act('redo'), None),
                 (['edit-find'], 'Поиск (Ctrl+F)', self.toggle_search, None), (['system-run', 'system-search'], 'Быстрое открытие (Ctrl+P)', self.palette, L('Палитра')),
                 (['media-playback-start'], 'Запустить файл (F5)', self.run_current, L('Запуск')), (['utilities-terminal'], 'Терминал (Ctrl+`)', self.toggle_terminal, L('Терминал')),
                 (['input-keyboard'], 'Экранная клавиатура', self.toggle_osk, None)]
        for ic, tip, cb, lab in items: bar.pack_start(self.tb(ic, tip, cb, lab), False, False, 0)
        ab = Gtk.Button(label='✦' if self.narrow else '✦ ИИ'); ab.set_tooltip_text('ИИ: чат, правка выделенного (Ctrl+K), создание проектов (Ctrl+L)'); ab.set_relief(Gtk.ReliefStyle.NONE); ab.get_style_context().add_class('bar-btn')
        ab.set_size_request(-1, 46); ab.connect('clicked', lambda _b: self.toggle_ai()); bar.pack_start(ab, False, False, 0)
        if not self.narrow: bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)
        for txt, cb, tip in (() if self.narrow else (('A−', lambda: self.zoom(-1), 'Мельче'), ('A+', lambda: self.zoom(1), 'Крупнее'), ('↵', self.toggle_wrap, 'Перенос строк'), ('◐', self.toggle_scheme, 'Тема: ч/б или «матрица»'))):
            b = Gtk.Button(label=txt); b.set_relief(Gtk.ReliefStyle.NONE); b.get_style_context().add_class('bar-btn'); b.set_tooltip_text(tip); b.set_size_request(46, 46); b.connect('clicked', lambda _b, f=cb: f()); bar.pack_start(b, False, False, 0)
        self.git_l = Gtk.Label(label=''); self.git_l.get_style_context().add_class('mono'); bar.pack_end(self.git_l, False, False, 10)
        return bar

    def build_search(self):
        sb = Gtk.SearchBar(); box = Gtk.Box(spacing=6)
        self.find_e = Gtk.SearchEntry(); self.find_e.set_placeholder_text('найти'); self.find_e.set_width_chars(26)
        self.repl_e = Gtk.Entry(); self.repl_e.set_placeholder_text('заменить на'); self.repl_e.set_width_chars(22)
        for w in (self.find_e, self.repl_e): w.connect('focus-in-event', lambda *_: ui.osk(True))
        box.pack_start(self.find_e, False, False, 0)
        for txt, cb in (('↓', lambda: self.find_step(1)), ('↑', lambda: self.find_step(-1))):
            b = Gtk.Button(label=txt); b.connect('clicked', lambda _b, f=cb: f()); b.set_size_request(46, 40); box.pack_start(b, False, False, 0)
        box.pack_start(self.repl_e, False, False, 6)
        for txt, cb in (('Заменить', self.replace_one), ('Все', self.replace_all)):
            b = Gtk.Button(label=txt); b.connect('clicked', lambda _b, f=cb: f()); b.set_size_request(-1, 40); box.pack_start(b, False, False, 0)
        self.find_e.connect('search-changed', lambda *_: self.find_update()); self.find_e.connect('activate', lambda *_: self.find_step(1))
        sb.add(box); sb.connect_entry(self.find_e); return sb

    def build_explorer(self):
        self.store = Gtk.TreeStore(str, str, bool)                          # label, path, is_dir
        self.tree = Gtk.TreeView(model=self.store); self.tree.set_headers_visible(False); self.tree.set_activate_on_single_click(True)
        r = Gtk.CellRendererText(); r.set_property('ellipsize', Pango.EllipsizeMode.END); r.set_property('ypad', 7)
        col = Gtk.TreeViewColumn('', r, text=0); self.tree.append_column(col)
        self.tree.connect('row-expanded', self.on_expand); self.tree.connect('row-activated', self.on_activate)
        sw = Gtk.ScrolledWindow(); sw.set_size_request(210, -1); sw.add(self.tree)
        self.exp_title = Gtk.Label(xalign=0); self.exp_title.get_style_context().add_class('mono'); self.exp_title.set_margin_start(10); self.exp_title.set_margin_top(6); self.exp_title.set_margin_bottom(6)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.pack_start(self.exp_title, False, False, 0); box.pack_start(sw, True, True, 0); self.explorer = box
        return box

    def build_terminal(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.set_size_request(-1, 230); self.spawned = False; self.term_size = 11
        t = rt.make_terminal(self.term_size) if rt.available() else None; self.term = t
        if t is None:
            box.pack_start(Gtk.Label(label='Встроенный терминал недоступен (gir1.2-vte-2.91). Откройте xfce4-terminal.'), True, True, 0); return box
        sc = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL, adjustment=t.get_vadjustment())
        row = Gtk.Box(); row.pack_start(t, True, True, 0); row.pack_start(sc, False, False, 0); box.pack_start(row, True, True, 0)
        box.pack_start(rt.KeyBar(t, font_cb=self.term_font), False, False, 0); t.connect('child-exited', self.on_shell_exit)
        return box

    def term_font(self, d):
        self.term_size = max(8, min(22, self.term_size + d)); self.term.set_font(Pango.FontDescription('Fira Code %d' % self.term_size))

    def on_shell_exit(self, *_):
        self.spawned = False
        if self.bottom.get_visible() and self.bottom.get_current_page() == 0: GLib.idle_add(self.spawn_shell)

    def spawn_shell(self):
        if not self.term or self.spawned: return
        self.spawned = True
        rt.spawn(self.term, ['/bin/bash', '-l'], cwd=self.folder, callback=self.on_spawned)

    def on_spawned(self, pid, error):
        for cmd in getattr(self, 'pending', []): GLib.timeout_add(250, self.feed, cmd)       # let bash print its first prompt
        self.pending = []

    def feed(self, cmd):
        rt.feed(self.term, cmd + '\n'); return False

    def show_bottom(self, page):
        self.bottom.show_all(); self.bottom.set_current_page(page); self.vpaned.set_position(max(200, self.get_allocated_height() - (580 if page == 1 else 360)))
        if page == 0 and self.term: self.spawn_shell(); self.term.grab_focus()
        elif page == 1 and self.ai_panel is not None and self.narrow: self.ai_panel.entry.grab_focus()

    def term_run(self, cmd):
        if not self.term: subprocess.Popen(['xfce4-terminal', '--hold', '-e', 'bash -c %s' % json.dumps(cmd)], cwd=self.folder); return
        was = self.spawned; self.show_bottom(0)
        if was: self.feed(cmd)
        else: self.pending = getattr(self, 'pending', []) + [cmd]

    # ---------------- explorer ----------------
    def set_folder(self, path):
        self.folder = path; self.cfg['folder'] = path; self.store.clear(); self.exp_title.set_text('[ %s ]' % (os.path.basename(path.rstrip('/')) or '/'))
        self.fill(None, path); self.set_title('Rembly Code — %s' % os.path.basename(path.rstrip('/')))
        if getattr(self, 'term', None) and self.spawned and not self.bottom.get_visible():         # a shell opened in the old folder: replace it on the next show
            try: self.term.get_pty().close()
            except Exception: pass

    def fill(self, parent, path):
        try: ents = sorted(os.scandir(path), key=lambda e: (not e.is_dir(follow_symlinks=False), e.name.lower()))
        except OSError: return
        for e in ents[:2000]:
            if e.name in IGNORE or (e.name.startswith('.') and e.name not in ('.gitignore', '.env')): continue
            isd = e.is_dir(follow_symlinks=False)
            it = self.store.append(parent, [e.name + ('/' if isd else ''), e.path, isd])
            if isd: self.store.append(it, ['…', '', False])

    def on_expand(self, tree, it, path):
        child = self.store.iter_children(it)
        if child is not None and self.store[child][0] == '…':
            self.store.remove(child); self.fill(it, self.store[it][1])

    def on_activate(self, tree, path, col):
        row = self.store[path]
        if row[2]:
            tree.collapse_row(path) if tree.row_expanded(path) else tree.expand_row(path, False)
        else: self.open_file(row[1])

    def pick_folder(self):
        d = Gtk.FileChooserDialog(title='Открыть папку', parent=self, action=Gtk.FileChooserAction.SELECT_FOLDER)
        d.add_buttons('Отмена', Gtk.ResponseType.CANCEL, 'Открыть', Gtk.ResponseType.OK); d.set_current_folder(self.folder)
        if d.run() == Gtk.ResponseType.OK: self.set_folder(d.get_filename())
        d.destroy()

    # ---------------- documents ----------------
    def doc_at(self, n):
        w = self.nb.get_nth_page(n)
        return next((d for d in self.docs if d.scroll is w), None)

    def current(self):
        n = self.nb.get_current_page(); return self.doc_at(n) if n >= 0 else None

    def new_doc(self):
        self.add_doc(Doc(None, '', self))

    def open_file(self, path):
        for d in self.docs:
            if d.path == path: self.nb.set_current_page(self.nb.page_num(d.scroll)); return d
        try:
            sz = os.path.getsize(path)
            if sz > 30_000_000: self.msg('Файл больше 30 МБ: он не открывается в редакторе (откройте в терминале: less, vim).'); return None
            with open(path, 'rb') as f: raw = f.read()
            if b'\0' in raw[:4096]: self.msg('Это двоичный файл, а не текст.'); return None
            text = raw.decode('utf8', 'replace')
        except OSError as e:
            self.msg('Не удалось открыть: %s' % e); return None
        d = Doc(path, text, self); self.add_doc(d); return d

    def add_doc(self, d):
        self.docs.append(d)
        lab = Gtk.Box(spacing=4); d.tab_l = Gtk.Label(label=d.name); d.tab_l.set_width_chars(8); d.tab_l.set_max_width_chars(22); d.tab_l.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        x = Gtk.Button(label='✕'); x.get_style_context().add_class('tabx'); x.set_relief(Gtk.ReliefStyle.NONE); x.connect('clicked', lambda _b: self.close_doc(d))
        lab.pack_start(d.tab_l, True, True, 0); lab.pack_start(x, False, False, 0); lab.show_all()
        n = self.nb.append_page(d.scroll, lab); self.nb.set_tab_reorderable(d.scroll, True); d.scroll.show_all(); self.nb.set_current_page(n)
        self.apply_scheme(d); d.view.grab_focus(); self.update_status(d)

    def refresh_tab(self, d):
        d.tab_l.set_text(('● ' if d.buf.get_modified() else '') + d.name)

    def close_doc(self, d):
        if d.buf.get_modified():
            r = self.ask('Сохранить «%s» перед закрытием?' % d.name, ('Не сохранять', 1), ('Отмена', 0), ('Сохранить', 2))
            if r == 0: return
            if r == 2 and not self.save_doc(d): return
        self.nb.remove_page(self.nb.page_num(d.scroll)); self.docs.remove(d)
        if not self.docs: self.new_doc()

    def save_doc(self, d):
        if not d.path:
            dlg = Gtk.FileChooserDialog(title='Сохранить как', parent=self, action=Gtk.FileChooserAction.SAVE)
            dlg.add_buttons('Отмена', Gtk.ResponseType.CANCEL, 'Сохранить', Gtk.ResponseType.OK); dlg.set_current_folder(self.folder); dlg.set_do_overwrite_confirmation(True)
            ok = dlg.run() == Gtk.ResponseType.OK; p = dlg.get_filename() if ok else None; dlg.destroy()
            if not p: return False
            d.path = p
            lang = GtkSource.LanguageManager.get_default().guess_language(p, None)
            if lang: d.buf.set_language(lang); d.lang = lang.get_name()
        try: d.save()
        except OSError as e: self.msg('Не удалось сохранить: %s' % e); return False
        self.refresh_tab(d); self.check_syntax(d); return True

    def save_current(self):
        d = self.current()
        if d: self.save_doc(d)

    def autosave(self, d):
        if self.autosave_on and d.path and d.buf.get_modified():
            try: d.save(); self.refresh_tab(d)
            except OSError: pass
        return True

    def autosave_all(self):
        for d in self.docs: self.autosave(d)

    def check_syntax(self, d):
        """after saving a Python file: a quick syntax check (compile only), result in the status bar"""
        if not d.path or not d.path.endswith('.py'): return
        try: compile(d.text(), d.path, 'exec'); self.flash('✔ синтаксис Python в порядке')
        except SyntaxError as e: self.flash('✖ строка %s: %s' % (e.lineno, e.msg))

    def flash(self, text):
        self._flash = text; self.update_status(self.current()); GLib.timeout_add_seconds(6, lambda: (setattr(self, '_flash', ''), self.update_status(self.current()), False)[2])

    def update_status(self, d):
        if d is None: return
        it = d.buf.get_iter_at_mark(d.buf.get_insert())
        s = '%s   |   %s   |   стр %d, ст %d   |   UTF-8   |   шрифт %d%s%s' % (d.path or 'без имени', d.lang, it.get_line() + 1, it.get_line_offset() + 1, self.font,
                                                                             '   |   БОЛЬШОЙ ФАЙЛ: без подсветки' if d.big else '', ('   |   ' + self._flash) if getattr(self, '_flash', '') else '')
        self.status.set_text(s)

    # ---------------- actions ----------------
    def act(self, what):
        d = self.current()
        if d is None: return
        if what == 'undo' and d.buf.can_undo(): d.buf.undo()
        elif what == 'redo' and d.buf.can_redo(): d.buf.redo()

    def apply_font(self, view):
        view.override_font(Pango.FontDescription('Fira Code %d' % self.font))

    def zoom(self, delta):
        self.font = max(8, min(26, self.font + delta)); self.cfg['font'] = self.font
        for d in self.docs: self.apply_font(d.view)
        self.update_status(self.current())

    def toggle_wrap(self):
        self.wrap = not self.wrap; self.cfg['wrap'] = self.wrap
        for d in self.docs: d.view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR if self.wrap else Gtk.WrapMode.NONE)

    def apply_scheme(self, d):
        s = GtkSource.StyleSchemeManager.get_default().get_scheme(self.scheme)
        if s: d.buf.set_style_scheme(s)

    def toggle_scheme(self):
        self.scheme = 'rembly-matrix' if self.scheme == 'rembly' else 'rembly'; self.cfg['scheme'] = self.scheme
        for d in self.docs: self.apply_scheme(d)

    def toggle_explorer(self):
        if self.explorer.get_visible(): self.explorer.hide()
        else: self.explorer.show_all()

    def toggle_osk(self):
        self.osk_on = not getattr(self, 'osk_on', False); ui.osk(self.osk_on)

    def toggle_panel(self, page):
        if self.bottom.get_visible() and self.bottom.get_current_page() == page: self.bottom.hide()
        else: self.show_bottom(page)

    def toggle_terminal(self): self.toggle_panel(0)

    def toggle_ai(self):
        if self.ai_panel is None: self.msg('Модуль ИИ не найден (rembly_aiui.py). Выполните: rembly-repair fix'); return
        if self.narrow: self.toggle_panel(1); return
        if self.ai_panel.get_visible(): self.ai_panel.hide(); return
        self.show_ai()

    def show_ai(self):
        if self.narrow: self.show_bottom(1); return
        self.ai_panel.show_all(); self.ai_panel.stop_b.hide() if not self.ai_panel.busy else None; self.side.set_position(max(400, self.side.get_allocated_width() - 440)); self.ai_panel.entry.grab_focus()

    def ai_edit(self):
        if aiui: aiui.ai_edit(self)

    def ai_new_project(self):
        if aiui: aiui.new_project(self)

    def ai_settings(self):
        if aiui and aiui.open_settings(self) and self.ai_panel is not None: self.ai_panel.refresh_title()

    def run_current(self):
        d = self.current()
        if d is None: return
        if d.path is None and not self.save_doc(d): return
        if d.buf.get_modified(): self.save_doc(d)
        ext = os.path.splitext(d.path)[1].lower(); cmd = RUN.get(ext)
        if os.access(d.path, os.X_OK) and not cmd: cmd = '"{f}"'
        if not cmd: self.flash('Для «%s» нет команды запуска' % ext); return
        self.term_run('cd "%s" && %s' % (os.path.dirname(d.path), cmd.format(f=d.path)))

    # ---------------- find / replace ----------------
    def toggle_search(self):
        on = not self.search_bar.get_search_mode(); self.search_bar.set_search_mode(on)
        if on:
            d = self.current()
            if d and d.buf.get_has_selection():
                a, b = d.buf.get_selection_bounds(); self.find_e.set_text(d.buf.get_text(a, b, False))
            self.find_e.grab_focus()

    def ctx(self):
        d = self.current()
        if d is None: return None, None
        if getattr(d, 'sctx', None) is None:
            d.ss = GtkSource.SearchSettings(); d.ss.set_wrap_around(True); d.sctx = GtkSource.SearchContext.new(d.buf, d.ss)
        return d, d.sctx

    def find_update(self):
        d, c = self.ctx()
        if c: d.ss.set_search_text(self.find_e.get_text() or None); self.find_step(1)

    def find_step(self, direction):
        d, c = self.ctx()
        if not c or not self.find_e.get_text(): return
        it = d.buf.get_iter_at_mark(d.buf.get_insert())
        if d.buf.get_has_selection(): it = d.buf.get_selection_bounds()[1 if direction > 0 else 0]
        fn = getattr(c, 'forward2' if direction > 0 else 'backward2', None) or getattr(c, 'forward' if direction > 0 else 'backward')   # the names differ between GtkSource builds
        r = fn(it); ok, a, b = r[0], r[1], r[2]
        if ok: d.buf.select_range(a, b); d.view.scroll_to_iter(a, 0.2, False, 0, 0)

    def replace_one(self):
        d, c = self.ctx()
        if not c or not d.buf.get_has_selection(): self.find_step(1); return
        a, b = d.buf.get_selection_bounds()
        try: c.replace(a, b, self.repl_e.get_text(), -1)
        except Exception: pass
        self.find_step(1)

    def replace_all(self):
        d, c = self.ctx()
        if c:
            try: n = c.replace_all(self.repl_e.get_text(), -1); self.flash('заменено: %d' % n)
            except Exception: pass

    # ---------------- palette ----------------
    def project_files(self, limit=4000):
        out = []
        for dp, dn, fn in os.walk(self.folder):
            dn[:] = [x for x in dn if x not in IGNORE and not x.startswith('.')]
            for f in fn:
                if not f.startswith('.'): out.append(os.path.join(dp, f))
            if len(out) > limit: break
        return out

    def palette(self):
        dlg = Gtk.Dialog(title='Быстрое открытие', transient_for=self, modal=True); ui.style_app(dlg); dlg.set_default_size(640, 520)
        box = dlg.get_content_area(); box.set_border_width(10); box.set_spacing(8)
        ent = Gtk.SearchEntry(); ent.set_placeholder_text('файл или команда (">" — только команды)'); box.pack_start(ent, False, False, 0)
        lb = Gtk.ListBox(); sc = Gtk.ScrolledWindow(); sc.set_vexpand(True); sc.add(lb); box.pack_start(sc, True, True, 0)
        cmds = [('› Сохранить', self.save_current), ('› Сохранить всё', lambda: [self.save_doc(d) for d in list(self.docs)]), ('› Запустить файл', self.run_current),
                ('› Терминал', self.toggle_terminal), ('› Открыть папку…', self.pick_folder), ('› Тема: ч/б ↔ матрица', self.toggle_scheme),
                ('› Перенос строк', self.toggle_wrap), ('› Шрифт крупнее', lambda: self.zoom(1)), ('› Шрифт мельче', lambda: self.zoom(-1)), ('› Поиск', self.toggle_search), ('› Новый файл', self.new_doc),
                ('› Автосохранение: ' + ('выкл' if self.autosave_on else 'вкл'), self.toggle_autosave)]
        cmds += [('› ИИ: чат (Ctrl+L)', self.toggle_ai), ('› ИИ: изменить выделенное (Ctrl+K)', self.ai_edit), ('› ИИ: создать проект…', self.ai_new_project), ('› ИИ: ключ или локальный сервер…', self.ai_settings)]
        if ui.have('code-rembly'): cmds.append(('› Открыть эту папку в настоящем VS Code', lambda: subprocess.Popen(['code-rembly', self.folder], start_new_session=True)))
        else: cmds.append(('› Установить настоящий VS Code (тяжёлый, по желанию)…', lambda: self.term_run('rembly-install-vscode')))
        files = self.project_files(); items = [(c[0], c[1]) for c in cmds] + [(os.path.relpath(p, self.folder), (lambda p=p: self.open_file(p))) for p in files]
        state = {'items': []}

        def refill(*_):
            for ch in lb.get_children(): lb.remove(ch)
            q = ent.get_text().lower().strip(); only_cmd = q.startswith('>'); q = q.lstrip('> ').strip(); shown = 0; state['items'] = []
            for label, fn in items:
                if only_cmd and not label.startswith('›'): continue
                if q and not all(part in label.lower() for part in q.split()): continue
                row = Gtk.ListBoxRow(); l = Gtk.Label(label=label, xalign=0); l.set_ellipsize(Pango.EllipsizeMode.START); l.get_style_context().add_class('mono'); l.set_margin_top(7); l.set_margin_bottom(7); l.set_margin_start(8); row.add(l)
                lb.add(row); state['items'].append(fn); shown += 1
                if shown >= 60: break
            lb.show_all(); first = lb.get_row_at_index(0)
            if first: lb.select_row(first)

        def run(row):
            if row is None: return
            fn = state['items'][row.get_index()]; dlg.destroy(); fn()
        ent.connect('search-changed', refill); ent.connect('activate', lambda *_: run(lb.get_selected_row())); lb.connect('row-activated', lambda _l, r: run(r))
        refill(); dlg.show_all(); ent.grab_focus(); dlg.run(); dlg.destroy()

    def toggle_autosave(self):
        self.autosave_on = not self.autosave_on; self.cfg['autosave'] = self.autosave_on; self.flash('автосохранение: %s' % ('вкл' if self.autosave_on else 'выкл'))

    def git_tick(self):
        def work():
            br = ''
            try:
                if os.path.isdir(os.path.join(self.folder, '.git')):
                    br = subprocess.run(['git', '-C', self.folder, 'rev-parse', '--abbrev-ref', 'HEAD'], capture_output=True, text=True, timeout=3).stdout.strip()
                    dirty = subprocess.run(['git', '-C', self.folder, 'status', '--porcelain'], capture_output=True, text=True, timeout=5).stdout.strip()
                    br = '⎇ %s%s' % (br, ' *' if dirty else '')
            except Exception: pass
            GLib.idle_add(self.git_l.set_text, br)
        threading.Thread(target=work, daemon=True).start(); return True

    # ---------------- misc ----------------
    def msg(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text=text); ui.style_app(d); d.run(); d.destroy()

    def ask(self, text, *buttons):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION, text=text); ui.style_app(d)
        for label, rid in buttons: d.add_button(label, rid)
        r = d.run(); d.destroy(); return r if r in [b[1] for b in buttons] else 0

    def on_key(self, w, e):
        ctrl = e.state & Gdk.ModifierType.CONTROL_MASK; k = Gdk.keyval_name(e.keyval)
        if ctrl and k in ('s', 'S'): self.save_current(); return True
        if ctrl and k in ('o', 'O'): self.pick_folder(); return True
        if ctrl and k in ('f', 'F'): self.toggle_search(); return True
        if ctrl and k in ('p', 'P'): self.palette(); return True
        if ctrl and k in ('b', 'B'): self.toggle_explorer(); return True
        if ctrl and k in ('k', 'K'): self.ai_edit(); return True
        if ctrl and k in ('l', 'L'): self.toggle_ai(); return True
        if ctrl and k in ('w', 'W'): d = self.current(); self.close_doc(d) if d else None; return True
        if ctrl and k in ('grave',): self.toggle_terminal(); return True
        if ctrl and k in ('plus', 'equal', 'KP_Add'): self.zoom(1); return True
        if ctrl and k in ('minus', 'KP_Subtract'): self.zoom(-1); return True
        if k == 'F5': self.run_current(); return True
        if k == 'Escape' and self.search_bar.get_search_mode(): self.search_bar.set_search_mode(False); return True
        return False

    def on_close(self, *_):
        dirty = [d for d in self.docs if d.buf.get_modified()]
        if dirty:
            r = self.ask('Есть несохранённые файлы (%d). Сохранить их?' % len(dirty), ('Не сохранять', 1), ('Отмена', 0), ('Сохранить всё', 2))
            if r == 0: return True
            if r == 2:
                for d in dirty:
                    if not self.save_doc(d): return True
        self.cfg['files'] = [d.path for d in self.docs if d.path]; save_cfg(self.cfg); Gtk.main_quit(); return False


if __name__ == '__main__':
    w = Code(sys.argv[1:]); Gtk.main()
