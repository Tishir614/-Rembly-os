#!/usr/bin/env python3
"""rembley-storage - where did the space go? Touch UI: bars per category, biggest folders in your home, one button for safe cleanup."""
import os, subprocess, sys, threading
sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
import rembleyui as ui
from rembleyui import *
ui.install_crash_handler()
CATS = [('Система и программы', ['/usr', '/lib', '/bin', '/sbin', '/opt']), ('Пакеты и их кэш', ['/var/cache', '/var/lib/apt', '/var/lib/dpkg']),
        ('Ваши файлы', ['/root/Documents', '/root/Downloads', '/root/Pictures', '/root/Music', '/root/Videos', '/root/Projects']),
        ('Кэш приложений', ['/root/.cache']), ('Журналы', ['/var/log'])]


def du(paths):
    paths = [p for p in paths if os.path.exists(p)]
    if not paths: return 0
    r = subprocess.run(['nice', '-n', '15', 'ionice', '-c3', 'du', '-sxk'] + paths, capture_output=True, text=True)
    return sum(int(l.split()[0]) for l in r.stdout.splitlines() if l.split() and l.split()[0].isdigit()) * 1024


def human(n):
    for u in ('Б', 'КБ', 'МБ', 'ГБ'):
        if n < 1024 or u == 'ГБ': return '%.0f %s' % (n, u) if u in ('Б', 'КБ') else '%.1f %s' % (n, u)
        n /= 1024


class Storage(Gtk.Window):
    def __init__(self):
        super().__init__(title='Хранилище'); self.set_default_size(760, 640); self.set_position(Gtk.WindowPosition.CENTER); ui.init_theme()
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); v.set_border_width(16); self.add(v)
        self.head = Gtk.Label(xalign=0); self.head.get_style_context().add_class('rl-title'); v.pack_start(self.head, False, False, 0)
        self.total = Gtk.ProgressBar(show_text=True); v.pack_start(self.total, False, False, 0)
        self.rows = {}
        for name, _ in CATS:
            b = Gtk.ProgressBar(show_text=True); b.set_text(name + ': считаю…'); v.pack_start(b, False, False, 0); self.rows[name] = b
        t = Gtk.Label(label='Самые большие папки в домашнем каталоге:', xalign=0); v.pack_start(t, False, False, 6)
        sc = Gtk.ScrolledWindow(); sc.set_vexpand(True); v.pack_start(sc, True, True, 0)
        self.tv = Gtk.TextView(editable=False, monospace=True); sc.add(self.tv)
        row = Gtk.Box(spacing=10); v.pack_start(row, False, False, 0)
        for text, fn in (('Безопасная очистка', self.clean), ('Обновить', self.scan)):
            b = Gtk.Button(label=text); b.set_size_request(-1, 56); b.connect('clicked', lambda _b, f=fn: f()); row.pack_start(b, True, True, 0)
        self.connect('destroy', Gtk.main_quit); self.show_all(); self.scan()

    def scan(self):
        st = os.statvfs('/'); tot, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
        self.head.set_text('Свободно %s из %s' % (human(free), human(tot))); self.total.set_fraction(1 - free / tot); self.total.set_text('занято %d%%' % round(100 * (1 - free / tot)))
        def work():
            for name, paths in CATS:
                n = du(paths); GLib.idle_add(lambda name=name, n=n: (self.rows[name].set_fraction(min(1, n / tot)), self.rows[name].set_text('%s: %s' % (name, human(n)))))
            r = subprocess.run('nice -n 15 ionice -c3 du -xk --max-depth=1 /root 2>/dev/null | sort -rn | head -9', shell=True, capture_output=True, text=True).stdout
            lines = ['%10s  %s' % (human(int(a) * 1024), b) for a, b in (l.split('\t', 1) for l in r.splitlines() if '\t' in l)]
            GLib.idle_add(lambda: self.tv.get_buffer().set_text('\n'.join(lines)))
        threading.Thread(target=work, daemon=True).start()

    def clean(self):
        d = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.YES_NO,
                              text='Очистить кэши пакетов, эскизы, временные файлы и старые журналы? Ваши файлы и настройки не затрагиваются.')
        if d.run() == Gtk.ResponseType.YES:
            subprocess.Popen(['rembley-optimize', '--quiet']).wait(); self.scan()
        d.destroy()


if __name__ == '__main__':
    Storage(); Gtk.main()
