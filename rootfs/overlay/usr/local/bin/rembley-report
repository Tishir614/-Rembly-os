#!/bin/sh
# Collects everything needed to debug the tablet into one tarball. Safe: read-only, no secrets (Wi-Fi passwords are NOT included).
TS=$(date +%Y%m%d-%H%M%S); D=/tmp/rembley-report-$TS; OUT=/root/rembley-report-$TS.tgz
mkdir -p $D
c() { n=$1; shift; { echo "\$ $*"; "$@" 2>&1; } > $D/$n.txt; }
s() { n=$1; shift; { echo "\$ $*"; sh -c "$*" 2>&1; } > $D/$n.txt; }
c uname uname -a; s release 'cat /etc/rembley-release; date; uptime'
s cmdline 'cat /proc/cmdline /proc/version'
s dmesg 'dmesg'
s fb 'cat /proc/fb; for f in /sys/class/graphics/fb0/*; do [ -f $f ] && echo "$f=$(cat $f 2>/dev/null | head -c 200)"; done'
s input 'cat /proc/bus/input/devices'
s dev 'ls -lR /dev | head -300'
s sys_class 'for c in graphics input net power_supply android_usb leds backlight bluetooth thermal; do echo "== $c"; ls -l /sys/class/$c 2>&1; done'
s battery 'for d in /sys/class/power_supply/*; do echo $d; cat $d/uevent; done'
s mem 'free -m; cat /proc/meminfo; swapon --show; cat /proc/pressure/* 2>/dev/null'
s cpu 'cat /sys/devices/system/cpu/online; for f in /sys/devices/system/cpu/cpu0/cpufreq/*; do [ -f $f ] && echo "$f=$(cat $f)"; done; cat /proc/cpuinfo'
s storage 'df -h; mount; cat /proc/partitions'
s net 'ip a; ip r; cat /etc/resolv.conf; rembley-net status; ls -l /system/bin 2>&1 | head -50; ls /vendor/firmware 2>&1 | head -50'
s netlogs 'tail -n 200 /var/log/rembley-net.log /var/log/wmt_launcher.log /var/log/wmt_loader.log /var/log/btattach.log /var/log/bluetoothd.log /var/log/ppp.log 2>&1'
s xorg 'cat /var/log/rembley-x.log; xrandr 2>&1; xinput list 2>&1'
s xconf 'cat /etc/X11/xorg.conf.d/*.conf; cat /etc/rembley/*.conf'
s procs 'ps aux; top -bn1 | head -25'
s modem 'rembley-net modem-probe'
s wifi_diag 'rembley-net diag'
s partnames 'for u in /sys/class/block/mmcblk0p*/uevent; do echo "$(basename $(dirname $u)) $(grep PARTNAME $u)"; done; mount | grep -E "nvdata|nvram|protect"; ls /nvdata/APCFG/APRDEB 2>&1 | head -30   # NAMES ONLY: nvram contents are never copied (IMEI/MAC)'
s audio 'aplay -l; amixer scontrols; cat /proc/asound/cards'
s usb 'ls /sys/class/android_usb/android0; cat /sys/class/android_usb/android0/state 2>&1; cat /tmp/adbd.log 2>&1'
s selftest 'rembley-selftest'
s wifi-preflight 'rembley-net preflight'
s touch-probe 'rembley-touchprobe; cat /proc/bus/input/devices'
s drivers 'rembley-drivers status; ls /var/lib/rembley; cat /var/lib/rembley/drivers.json'
s heal 'cat /var/log/rembley-heal.log /var/log/rembley-crash.log /var/log/rembley-drivers.log'
s wmtstrace 'cat /var/log/wmt.strace /var/log/wmt.loader.strace | grep -c . ; cat /var/log/wmt.strace /var/log/wmt.loader.strace | grep ENOENT | sed -n "s/.*\"\\([^\"]*\\)\".*/\\1/p" | sort -u | head -60'
cp /tmp/hwreport.txt $D/stage1-hwreport.txt 2>/dev/null
tar -czf $OUT -C /tmp rembley-report-$TS && rm -rf $D
echo "Report: $OUT ($(du -h $OUT | cut -f1))"
# --usb: also copy onto the first removable medium (handy when adb is not available)
case "$1" in --usb)
  for m in /media/* /mnt/usb* /run/media/*/*; do [ -d "$m" ] && [ -w "$m" ] && { cp "$OUT" "$m/" && echo "also copied to $m/" && break; }; done ;;
esac
echo "Get it with:  adb pull $OUT   (or copy from the USB stick; or run: rembley-report --usb)"
