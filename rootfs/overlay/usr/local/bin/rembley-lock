#!/usr/bin/env python3
"""Rembley lock screen: PIN pad over the blurred wallpaper. PIN hash lives in /etc/rembley/pin (salt$sha256).
usage: rembley-lock            lock now (no PIN set -> single 'Unlock' button)
       rembley-lock --set PIN  set PIN (empty string removes it)"""
import hashlib, os, sys, time
sys.path[:0] = ['/usr/local/lib/rembley', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib', 'rembley')]
PINF = os.environ.get('REMBLEY_PIN_FILE', '/etc/rembley/pin')


def hashed(pin, salt): return hashlib.sha256((salt + pin).encode()).hexdigest()


if len(sys.argv) > 2 and sys.argv[1] == '--set':
    if sys.argv[2] == '':
        try: os.remove(PINF)
        except FileNotFoundError: pass
    else:
        salt = os.urandom(8).hex(); os.makedirs(os.path.dirname(PINF), exist_ok=True)
        open(PINF, 'w').write('%s$%s' % (salt, hashed(sys.argv[2], salt))); os.chmod(PINF, 0o600)
    sys.exit(0)

import rembleyui as ui
from rembleyui import *

RU_DAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
RU_MON = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']


class Dots(Gtk.DrawingArea):
    """PIN progress as circles: filled = digit typed; shakes sideways on a wrong PIN."""
    def __init__(self):
        super().__init__(); self.n = 0; self.err = False; self.off = 0; self.set_size_request(300, 36)

    def set(self, n, err=False):
        self.n, self.err = n, err; self.queue_draw()

    def shake(self):
        seq = [-14, 14, -10, 10, -6, 6, -2, 2, 0]
        def step(i):
            if i >= len(seq): self.off = 0; self.set(0); return False
            self.off = seq[i]; self.queue_draw(); GLib.timeout_add(45, step, i + 1); return False
        self.err = True; step(0)

    def do_draw(self, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height(); k = max(4, self.n); gap = 34
        x0 = w / 2 - (k - 1) * gap / 2 + self.off
        for i in range(k):
            cr.arc(x0 + i * gap, h / 2, 9, 0, 6.2832)
            if i < self.n:
                cr.set_source_rgba(1, 0.45, 0.55, 1) if self.err else cr.set_source_rgba(0.85, 0.72, 1, 1); cr.fill()
            else:
                cr.set_source_rgba(1, 0.45, 0.55, 0.9) if self.err else cr.set_source_rgba(0.85, 0.75, 1, 0.55); cr.set_line_width(2); cr.stroke()


class Lock(Win):
    def __init__(self, sw, sh, wall, blur):
        super().__init__(wall, blur, (0, 0), type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False); self.set_default_size(sw, sh); self.move(0, 0); self.fullscreen(); self.set_keep_above(True); self.set_skip_taskbar_hint(True)
        self.salt_hash = open(PINF).read().strip().split('$') if os.path.exists(PINF) else None
        self.pin = ''
        c = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER); self.add(c)
        self.clock = Gtk.Label(); self.clock.get_style_context().add_class('lockclock'); c.pack_start(self.clock, False, False, 0)
        self.date = Gtk.Label(); self.date.get_style_context().add_class('date'); c.pack_start(self.date, False, False, 6)
        try: name = open(os.path.expanduser('~/.config/rembley/user')).read().strip() or 'Rembley'
        except OSError: name = 'Rembley'
        row = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER); row.pack_start(Avatar(52), False, False, 0)
        hi = Gtk.Label(label='Привет, %s' % name); hi.get_style_context().add_class('lockhello'); row.pack_start(hi, False, False, 0)
        c.pack_start(row, False, False, 14)
        self.dots = Dots(); self.msg = Gtk.Label(label='Введите PIN' if self.salt_hash else 'Коснитесь, чтобы разблокировать'); self.msg.get_style_context().add_class('lockhint')
        if self.salt_hash:
            c.pack_start(self.dots, False, False, 0); c.pack_start(self.msg, False, False, 4)
            g = Gtk.Grid(row_spacing=10, column_spacing=18, halign=Gtk.Align.CENTER); g.set_margin_top(10)
            for i, k in enumerate(['1', '2', '3', '4', '5', '6', '7', '8', '9', '⌫', '0', '✓']):
                b = Gtk.Button(label=k); b.get_style_context().add_class('pad')
                if k in '⌫✓': b.get_style_context().add_class('pad-small')
                if k == '✓': b.get_style_context().add_class('pad-ok')
                b.connect('clicked', lambda _b, k=k: self.key(k)); g.attach(b, i % 3, i // 3, 1, 1)
            c.pack_start(g, False, False, 0)
        else:
            c.pack_start(self.msg, False, False, 8)
            b = Gtk.Button(label='Разблокировать'); b.get_style_context().add_class('lockbtn')
            b.connect('clicked', lambda _b: self.unlock()); c.pack_start(b, False, False, 18)
        self.tick(); GLib.timeout_add_seconds(1, self.tick)
        self.connect('map-event', lambda *_: GLib.idle_add(self.grab))

    def grab(self):
        try:
            self.get_window().get_display().get_default_seat().grab(self.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None, None)
        except Exception: pass
        return False

    def tick(self):
        t = time.localtime(); self.clock.set_text(time.strftime('%H:%M', t))
        self.date.set_text('%s, %d %s' % (RU_DAYS[t.tm_wday], t.tm_mday, RU_MON[t.tm_mon - 1])); return True

    def key(self, k):
        if k == '⌫': self.pin = self.pin[:-1]
        elif k == '✓': return self.check()
        elif len(self.pin) < 12: self.pin += k
        self.dots.set(len(self.pin)); self.msg.set_text('Введите PIN')

    def check(self):
        salt, h = self.salt_hash[0], self.salt_hash[1]
        if hashed(self.pin, salt) == h: self.unlock()
        else: self.pin = ''; self.msg.set_text('Неверный PIN, попробуйте ещё раз'); self.dots.shake()

    def unlock(self):
        try: self.get_window().get_display().get_default_seat().ungrab()
        except Exception: pass
        Gtk.main_quit()


if __name__ == '__main__':
    ui.init_theme(); sw, sh = screen_size(); wall, blur = load_wallpaper(sw, sh)
    w = Lock(sw, sh, wall, blur); w.show_all(); w.present(); Gtk.main()
