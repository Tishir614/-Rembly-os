<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rembly-matrix" name="Rembly Matrix" version="1.0">
  <author>Rembly OS</author>
  <description>Green on black, the classic terminal look</description>
  <style name="text" foreground="#33ff77" background="#020805"/>
  <style name="selection" foreground="#021008" background="#6dff9c"/>
  <style name="cursor" foreground="#b6ffcf"/>
  <style name="current-line" background="#0a1a10"/>
  <style name="line-numbers" foreground="#1f6b3a" background="#020805"/>
  <style name="current-line-number" foreground="#b6ffcf" bold="true"/>
  <style name="bracket-match" foreground="#021008" background="#d0d0d0" bold="true"/>
  <style name="bracket-mismatch" foreground="#b6ffcf" background="#4a4a4a" underline="true"/>
  <style name="right-margin" foreground="#262626"/>
  <style name="search-match" foreground="#021008" background="#b8b8b8"/>
  <style name="draw-spaces" foreground="#333333"/>
  <style name="def:comment" foreground="#2e8f52" italic="true"/>
  <style name="def:shebang" foreground="#2e8f52" bold="true"/>
  <style name="def:doc-comment-element" foreground="#3aa862" italic="true"/>
  <style name="def:string" foreground="#7dffa8"/>
  <style name="def:special-char" foreground="#b6ffcf"/>
  <style name="def:character" foreground="#7dffa8"/>
  <style name="def:constant" foreground="#b6ffcf"/>
  <style name="def:number" foreground="#b6ffcf"/>
  <style name="def:floating-point" foreground="#b6ffcf"/>
  <style name="def:decimal" foreground="#b6ffcf"/>
  <style name="def:base-n-integer" foreground="#b6ffcf"/>
  <style name="def:boolean" foreground="#b6ffcf" bold="true"/>
  <style name="def:special-constant" foreground="#b6ffcf" bold="true"/>
  <style name="def:keyword" foreground="#b6ffcf" bold="true"/>
  <style name="def:statement" foreground="#b6ffcf" bold="true"/>
  <style name="def:type" foreground="#a8ffc6" underline="true"/>
  <style name="def:function" foreground="#a8ffc6"/>
  <style name="def:builtin" foreground="#6dff9c" italic="true"/>
  <style name="def:preprocessor" foreground="#58d986" bold="true"/>
  <style name="def:identifier" foreground="#33ff77"/>
  <style name="def:operator" foreground="#46c273"/>
  <style name="def:error" foreground="#b6ffcf" background="#5a5a5a" bold="true"/>
  <style name="def:warning" foreground="#b6ffcf" underline="true"/>
  <style name="def:note" foreground="#b6ffcf" bold="true" italic="true"/>
  <style name="def:underlined" underline="true"/>
</style-scheme>
